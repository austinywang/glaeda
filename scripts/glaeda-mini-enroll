#!/usr/bin/env python3
"""glaeda-mini-enroll: take a set-up cmux Mac mini to an eligible fleet node in one command.

    glaeda-mini-enroll --cmux-root ~/cmux --node-id cmux-mac-001 \
        --candidate ARCHIVE --sha256 SHA256 --source COMMIT [--apply]

Runs the sequence in docs/CMUX_FLEET_ENROLLMENT.md (cmux docs/fleet-enrollment.md):
stage the reviewed candidate bundle, bootstrap, enroll, accept-local, transition to
eligible, status. With --candidate, the archive is verified and staged by this
checkout's fleet_bundle.py (docs/FLEET_DISTRIBUTION.md) into a new generation
directory, and every fleet step runs that generation's own binary and tools, so the
node runs exactly the reviewed candidate and no Rust is built. Without --candidate,
it builds glaeda from this checkout instead, for development hosts. The staging
verifier is this checkout's: a later change to fleet_bundle.py's file inventory
needs a matching new candidate. Each step is skipped when its result already holds, so re-running after a
failure or a reboot resumes where it stopped, and re-running on an eligible node
changes nothing. --reaccept forces a fresh accept-local (a cold cmux build, about
13 minutes on an M4 Pro).

With --class-receipt, --class-receipt-sha256 and --fleet-class, the node joins on its
class's acceptance instead of building: cmux_fleet.py adopt-class-acceptance re-runs the
read-only bootstrap and requires this node's hardware, Xcode build, SDK, toolchain and
Glaeda candidate to equal the class receipt's, whose digest must equal the one given.
Any difference names the field and stops; run accept-local on that node instead.

With --renew (and --candidate), an enrolled node moves onto this candidate or its changed
toolchain in the same run: when the staged generation's binary is not the one the enrollment
records, the acceptance is not current, or the node is quarantined, it runs the generation's
bootstrap into a private file, quarantines the enrollment (stale_glaeda_generation,
toolchain_mismatch or failed_acceptance), renews it from that bootstrap, then accepts it
(accept-local, or adopt-class with --class-receipt). A node that already runs this candidate
with a current acceptance is left as it is. A class adoption that does not match leaves the
node quarantined (failed_acceptance) with the differing fields named.

Run glaeda-mini-setup --apply first; this command assumes its tools and cache root.
It picks a Python 3.13+ interpreter itself (Homebrew, then ~/.local/bin, then PATH),
because accept-local needs os.waitid, which CPython on macOS only has from 3.13. It never uses sudo, never registers a
GitHub runner (scripts/glaeda-cmux-runner --apply does that, docs/CMUX_MINI_RUNNER.md), and never reads a token.
"""

from __future__ import annotations

import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
REPO = SCRIPT_DIR.parent
sys.path.insert(0, os.fspath(SCRIPT_DIR))
import cmux_fleet_bootstrap as fleet_bootstrap  # noqa: E402  (fix texts only; this checkout's, not the candidate's)
ROLE = "cmux_macos_native_build"
HARDWARE_CLASS = "cmux-mac-build-large"
SCOPE = "cmux-founders"
TARGET = "aarch64-apple-darwin"
PYTHON_CANDIDATES = (
    "/opt/homebrew/bin/python3.14",
    "/opt/homebrew/bin/python3.13",
    "/opt/homebrew/opt/python@3.14/bin/python3.14",
    "/opt/homebrew/opt/python@3.13/bin/python3.13",
    "/usr/local/bin/python3.14",
    "/usr/local/bin/python3.13",
    "/opt/homebrew/bin/python3",
    "/usr/local/bin/python3",
)
DARWIN_REQUIRED = True


class Stop(Exception):
    pass


@dataclass
class Paths:
    home: Path

    @property
    def fleet(self) -> Path:
        base = os.environ.get("XDG_CONFIG_HOME") or os.fspath(self.home / ".config")
        return Path(base) / "glaeda" / "cmux-fleet"

    @property
    def install(self) -> Path:
        base = os.environ.get("XDG_DATA_HOME") or os.fspath(self.home / ".local/share")
        return Path(base) / "glaeda" / "cmux-fleet"

    @property
    def glaeda_bin(self) -> Path:
        return self.install / "glaeda"

    @property
    def enrollment(self) -> Path:
        return self.fleet / "enrollment.json"

    @property
    def acceptance(self) -> Path:
        return self.fleet / "acceptance" / f"{ROLE}.json"

    def class_receipt(self, fleet_class: str) -> Path:
        return self.fleet / "class-acceptance" / f"{fleet_class}.json"

    @property
    def generations(self) -> Path:
        return self.home / "Projects/glaeda-generations"

    def generation(self, source: str) -> Path:
        return self.generations / source[:12]

    @property
    def cache_root(self) -> Path:
        # Same default as glaeda-mini-setup, so the LaunchAgents it installs clean this cache.
        return self.home / ".cache/glaeda/cmux-native-cache"


def python_version(path: str) -> tuple[int, int] | None:
    try:
        out = subprocess.run([path, "-c", "import sys; print(*sys.version_info[:2])"],
                             capture_output=True, text=True, timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    parts = out.stdout.split()
    return (int(parts[0]), int(parts[1])) if out.returncode == 0 and len(parts) == 2 else None


# A user-local CPython (uv, python.org build, a copy from another Mac) lands here when the
# login user does not own Homebrew, which is the case on most shared build minis.
USER_PYTHONS = ("python3.14", "python3.13", "python3")
# What follows an eligible enrollment. cmux scripts/persistent-compile up is retired; a runner and the routing
# that sends jobs to its label are glaeda#1174.
NEXT_STEP = ("Next: register its runner (~/glaeda/scripts/glaeda-cmux-runner --apply, docs/CMUX_MINI_RUNNER.md); "
             "jobs reach it only once routing points at its label (glaeda#1174).")
PYTHON_FIX = ("brew install python@3.13 (as the account that owns Homebrew), "
              "or put a CPython 3.13+ at ~/.local/bin/python3")


def pick_python(explicit: str | None, home: Path | None = None) -> str | None:
    """The first Python 3.13+ found. glaeda-mini-setup calls this too, so both agree."""
    local = (home or Path.home()) / ".local/bin"
    # /usr/bin/python3 is Apple's 3.9 at best, and before the Command Line Tools exist running it
    # opens an install dialog, so a PATH lookup that lands there is never probed.
    found = [w for w in (shutil.which(n) for n in ("python3.14", "python3.13", "python3"))
             if w and not w.startswith("/usr/bin/")]
    candidates = [explicit] if explicit else [*PYTHON_CANDIDATES, *(os.fspath(local / n) for n in USER_PYTHONS), *found]
    for candidate in candidates:
        if candidate and os.access(candidate, os.X_OK):
            version = python_version(candidate)
            if version and version >= (3, 13):
                return candidate
    return None


def read_json(path: Path) -> dict[str, Any] | None:
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    return value if isinstance(value, dict) else None


@dataclass
class State:
    binary: bool
    enrollment: dict[str, Any] | None
    acceptance_current: bool
    # The enrollment records another Glaeda binary than the candidate's (or the candidate is not staged yet).
    stale: bool = False


def plan(state: State, node_id: str | None, reaccept: bool, rebuild: bool, candidate: bool = False,
         no_accept: bool = False, class_receipt: bool = False, renew: bool = False) -> list[str]:
    """The steps still needed, in order. Pure, so it is tested without a Mac.

    no_accept stops at a bootstrapped, enrolled (enrolling) node without any acceptance. class_receipt
    replaces accept-local with adopt-class: the node's own receipt is minted from its class's
    acceptance after a fresh bootstrap matches it exactly. renew moves an enrolled node that is
    stale, quarantined or without a current acceptance back to enrolling on this candidate first."""
    if class_receipt and (no_accept or reaccept):
        raise Stop("--class-receipt joins on the class acceptance; drop --no-accept and --reaccept")
    if renew and not candidate:
        raise Stop("--renew moves the node onto a reviewed candidate; pass --candidate, --sha256 and --source")
    acceptance = "adopt-class" if class_receipt else "accept-local"
    steps = []
    if candidate:
        # A staged generation is re-inspected before anything runs, outside the plan.
        if not state.binary:
            steps.append("stage")
    elif rebuild or not state.binary:
        steps.append("install-glaeda")
    enrollment_state = (state.enrollment or {}).get("state")
    if renew and state.enrollment is not None:
        if node_id and state.enrollment.get("nodeId") != node_id:
            raise Stop(f"this mini is already enrolled as {state.enrollment.get('nodeId')}; "
                       "drop --node-id or retire that enrollment first")
        if enrollment_state == "retired":
            raise Stop("node is retired; remove the enrollment to enroll this machine again")
        if enrollment_state == "quarantined" or state.stale or reaccept or not state.acceptance_current:
            steps += ["bootstrap", "renew"]
            if no_accept:
                return steps + ["status"]
            return steps + [acceptance, "eligible", "status"]
    if state.enrollment is None:
        if not node_id:
            raise Stop("no enrollment yet: pass --node-id (an opaque id such as cmux-mac-001, "
                       "not a hostname or serial)")
        steps += ["bootstrap", "enroll"]
    elif node_id and state.enrollment.get("nodeId") != node_id:
        raise Stop(f"this mini is already enrolled as {state.enrollment.get('nodeId')}; "
                   "drop --node-id or retire that enrollment first")
    elif enrollment_state == "quarantined":
        raise Stop(f"node is quarantined ({state.enrollment.get('quarantineReason')}); "
                   "move it to enrolling with cmux_fleet.py transition-apply, then re-run (or re-run with --renew)")
    elif enrollment_state == "retired":
        raise Stop("node is retired; remove the enrollment to enroll this machine again")
    if no_accept:
        if reaccept:
            raise Stop("--reaccept and --no-accept contradict each other")
        if enrollment_state != "eligible" and state.acceptance_current:
            steps.append("eligible")
        steps.append("status")
        return steps
    if reaccept or state.enrollment is None or not state.acceptance_current:
        # cmux_fleet.py accepts only an enrolling node; re-acceptance of an
        # eligible or draining one goes through quarantine, which advances the
        # enrollment generation. That is an operator decision, not a side effect.
        if enrollment_state in {"eligible", "draining"}:
            raise Stop(f"node is {enrollment_state} but needs a fresh acceptance (new candidate, changed toolchain "
                       f"or --reaccept), and {acceptance} runs only on an enrolling node. Move it there, then re-run:\n"
                       "  cmux_fleet.py transition-apply ENROLLMENT --to quarantined --reason stale_glaeda_generation\n"
                       "  cmux_fleet.py transition-apply ENROLLMENT --to enrolling")
        steps.append(acceptance)
    if enrollment_state != "eligible" or acceptance in steps:
        steps.append("eligible")
    steps.append("status")
    return steps


class Runner:
    def __init__(self, python: str, paths: Paths, cmux_root: Path, generation: Path | None = None) -> None:
        self.python = python
        self.paths = paths
        self.cmux_root = cmux_root
        # A staged candidate runs its own tools and binary; a development host runs this checkout's.
        self.generation = generation
        self.tools = generation / "scripts" if generation else SCRIPT_DIR
        self.glaeda_bin = generation / "bin/glaeda" if generation else paths.glaeda_bin
        self.fleet_py = os.fspath(self.tools / "cmux_fleet.py")

    def fleet(self, *args: str, capture: bool = True) -> subprocess.CompletedProcess[str]:
        # -B keeps bytecode out of a staged generation, whose file inventory is closed.
        return subprocess.run([self.python, "-B", self.fleet_py, *args], cwd=REPO, text=True,
                              stdout=subprocess.PIPE if capture else None, check=False)

    def bundle(self, *args: str) -> dict[str, Any]:
        result = subprocess.run([self.python, "-B", os.fspath(SCRIPT_DIR / "fleet_bundle.py"), *args],
                                cwd=REPO, text=True, stdout=subprocess.PIPE, check=False)
        doc = read_json_text(result.stdout) or {}
        if result.returncode or doc.get("error"):
            raise Stop(f"fleet_bundle.py {args[0]}: {doc.get('error') or 'failed'}")
        return doc

    def stage(self, archive: Path, sha256: str, source: str) -> None:
        assert self.generation is not None
        if self.generation.exists():
            raise Stop(f"{self.generation} holds an interrupted stage; move it aside for inspection and re-run")
        parent = self.generation.parent
        parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(parent, 0o700)
        doc = self.bundle("stage", os.fspath(archive), "--sha256", sha256, "--source", source,
                          "--target", TARGET, "--directory", os.fspath(self.generation), "--apply")
        if doc.get("state") != "staged":
            raise Stop(f"candidate was not staged (state {doc.get('state')})")
        print(f"staged {source[:12]} in {self.generation}")

    def inspect(self, sha256: str, source: str) -> None:
        doc = self.bundle("inspect", "--directory", os.fspath(self.generation), "--sha256", sha256,
                          "--source", source, "--target", TARGET)
        if doc.get("state") != "verified":
            raise Stop(f"staged generation {self.generation} does not verify; stage the candidate into a fresh directory")

    def write_private(self, path: Path, text: str) -> None:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
        with os.fdopen(fd, "w") as out:
            out.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)

    def acceptance_current(self, enrollment: dict[str, Any] | None) -> bool:
        if enrollment is None or not self.paths.acceptance.is_file():
            return False
        if enrollment.get("state") == "eligible":
            status = self.fleet("status", os.fspath(self.paths.enrollment),
                                "--acceptance", os.fspath(self.paths.acceptance))
            return status.returncode == 0 and bool((json.loads(status.stdout or "{}")).get("routingCandidateEligible"))
        # A dry transition succeeds exactly when the receipt matches this enrollment.
        dry = self.fleet("transition", os.fspath(self.paths.enrollment), "--to", "eligible",
                         "--acceptance", os.fspath(self.paths.acceptance))
        return dry.returncode == 0

    def install_glaeda(self) -> None:
        cargo = shutil.which("cargo") or os.path.expanduser("~/.cargo/bin/cargo")
        if subprocess.run([cargo, "build", "--locked", "--release", "--bin", "glaeda"], cwd=REPO, check=False).returncode:
            raise Stop("cargo build of glaeda failed")
        install = self.paths.install
        install.mkdir(parents=True, exist_ok=True, mode=0o700)
        binary = self.paths.glaeda_bin
        rollback = install / "glaeda.rollback"
        if binary.is_file() and not rollback.exists():
            shutil.copy2(binary, rollback)
        staged = install / ".glaeda.next"
        shutil.copy2(REPO / "target/release/glaeda", staged)
        os.chmod(staged, 0o755)
        os.replace(staged, binary)

    def bootstrap(self) -> Path:
        result = subprocess.run(
            ["bash", os.fspath(self.tools / "cmux-fleet-bootstrap-macos"), "--cmux-root", os.fspath(self.cmux_root),
             "--glaeda", os.fspath(self.glaeda_bin), "--cache-root", os.fspath(self.paths.cache_root),
             "--hardware-class", HARDWARE_CLASS, "--role", ROLE],
            # accept-local re-runs the bootstrap from the staged generation and
            # requires the same toolchain generation; this checkout's
            # rust-toolchain.toml would otherwise change what rustc reports.
            cwd=self.tools.parent, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        problem = bootstrap_problem(result.returncode, result.stdout, result.stderr)
        if problem:
            raise Stop(problem)
        path = self.paths.fleet / "bootstrap.json"
        self.write_private(path, result.stdout)
        return path

    def enroll(self, bootstrap: Path, node_id: str) -> None:
        result = self.fleet("enroll", os.fspath(bootstrap), "--node-id", node_id, "--scope", SCOPE, "--generation", "1")
        if result.returncode:
            raise Stop("enroll was refused (see the error above)")
        self.write_private(self.paths.enrollment, result.stdout)

    def accept_local(self) -> None:
        print(f"accept-local: cold cmux build of {self.cmux_root}; this takes a while", flush=True)
        result = self.fleet("accept-local", os.fspath(self.paths.enrollment), "--cmux-root", os.fspath(self.cmux_root),
                            "--glaeda", os.fspath(self.glaeda_bin), "--cache-root", os.fspath(self.paths.cache_root),
                            "--role", ROLE)
        receipt = read_json_text(result.stdout)
        if result.returncode or (receipt or {}).get("result") != "accepted":
            if receipt:
                self.write_private(self.paths.fleet / "acceptance" / f"{ROLE}.rejected.json", result.stdout)
            raise Stop("accept-local did not accept this mini; the retained attempt log path is printed above")
        self.write_private(self.paths.acceptance, result.stdout)

    def adopt_class(self, receipt: bytes, sha256: str, fleet_class: str) -> None:
        # The receipt the node relies on stays next to its enrollment, which records its digest; one
        # this node does not match is not kept there.
        path = self.paths.class_receipt(fleet_class)
        pending = path.with_name(f".{path.name}.pending")
        self.write_private(pending, receipt.decode("utf-8"))
        print(f"adopt-class: bootstrap re-check against class {fleet_class} ({sha256[:19]}); no build", flush=True)
        try:
            result = self.fleet("adopt-class-acceptance", os.fspath(self.paths.enrollment), "--class-receipt",
                                os.fspath(pending), "--expected-sha256", sha256, "--fleet-class", fleet_class,
                                "--cmux-root", os.fspath(self.cmux_root), "--glaeda", os.fspath(self.glaeda_bin),
                                "--cache-root", os.fspath(self.paths.cache_root))
            receipt_doc = read_json_text(result.stdout)
            if result.returncode or (receipt_doc or {}).get("result") != "accepted":
                raise Stop(f"this mini does not match the class {fleet_class} acceptance (the differing fields "
                           "are above); run accept-local on it: re-run without --class-receipt")
            os.replace(pending, path)
        finally:
            pending.unlink(missing_ok=True)
        self.write_private(self.paths.acceptance, result.stdout)

    def renew(self, bootstrap: Path) -> None:
        """Quarantine the enrollment when needed and renew it from this generation's bootstrap."""
        enrollment = read_json(self.paths.enrollment) or {}
        observed = read_json(bootstrap) or {}
        glaeda_changed = observed.get("glaedaGeneration") != enrollment.get("glaedaGeneration")
        toolchain_changed = observed.get("toolchainGeneration") not in (enrollment.get("supportedToolchainGenerations") or [])
        state = enrollment.get("state")
        if state == "enrolling" and not glaeda_changed and not toolchain_changed:
            print("renew: the enrollment already records this candidate and toolchain; nothing to renew")
            return
        if state != "quarantined":
            reason = renewal_reason(glaeda_changed, toolchain_changed)
            print(f"renew: quarantine {enrollment.get('nodeId')} ({reason})", flush=True)
            self.quarantine(reason)
        preview = self.fleet("renew-enrollment", os.fspath(self.paths.enrollment), os.fspath(bootstrap))
        digest = (read_json_text(preview.stdout) or {}).get("planSha256")
        if preview.returncode or not isinstance(digest, str):
            raise Stop("renew-enrollment refused the fresh bootstrap (see the error above)")
        applied = self.fleet("renew-enrollment-apply", os.fspath(self.paths.enrollment), os.fspath(bootstrap),
                             "--expected-plan-sha256", digest)
        if applied.returncode:
            raise Stop("renew-enrollment-apply was refused (see the error above)")
        renewed = read_json(self.paths.enrollment) or {}
        print(f"renew: {renewed.get('nodeId')} is enrolling at enrollment generation "
              f"{renewed.get('enrollmentGeneration')} on {str(renewed.get('glaedaGeneration'))[:19]}")

    def quarantine(self, reason: str) -> None:
        result = self.fleet("transition-apply", os.fspath(self.paths.enrollment), "--to", "quarantined",
                            "--reason", reason)
        if result.returncode:
            raise Stop(f"transition to quarantined ({reason}) was refused (see the error above)")

    def eligible(self) -> None:
        enrollment = read_json(self.paths.enrollment) or {}
        if enrollment.get("state") == "eligible":
            return
        result = self.fleet("transition-apply", os.fspath(self.paths.enrollment), "--to", "eligible",
                            "--acceptance", os.fspath(self.paths.acceptance))
        if result.returncode:
            raise Stop("transition to eligible was refused (see the error above)")

    def status(self) -> dict[str, Any]:
        result = self.fleet("status", os.fspath(self.paths.enrollment), "--acceptance", os.fspath(self.paths.acceptance))
        return read_json_text(result.stdout) or {}


def renewal_reason(glaeda_changed: bool, toolchain_changed: bool) -> str:
    """The reviewed quarantine reason for a renewal."""
    if glaeda_changed:
        return "stale_glaeda_generation"
    if toolchain_changed:
        return "toolchain_mismatch"
    return "failed_acceptance"  # same software, but the acceptance no longer holds


def glaeda_digest(path: Path) -> str | None:
    """The enrollment's glaedaGeneration form of a binary: sha256:<hex>, as the bootstrap computes it."""
    import hashlib
    digest = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            for block in iter(lambda: handle.read(1 << 20), b""):
                digest.update(block)
    except OSError:
        return None
    return "sha256:" + digest.hexdigest()


def bootstrap_problem(code: int, stdout: str, stderr: str) -> str | None:
    """What stops enrollment, naming each missing thing and its fix; None when eligible."""
    doc = read_json_text(stdout)
    if doc is not None and doc.get("eligibleForEnrollment") and code == 0:
        return None
    if doc is not None and isinstance(doc.get("blockingChecks"), list) and doc["blockingChecks"]:
        missing = (doc.get("observed") or {}).get("toolsMissingFromWorkloadPath") or []
        lines = []
        for check in doc["blockingChecks"]:
            fix = fleet_bootstrap.BLOCKING_FIXES.get(check, "see docs/CMUX_FLEET_ENROLLMENT.md")
            if check == "workloadToolPath" and missing:
                fix = f"not on the workload PATH: {', '.join(missing)}; " + "; ".join(
                    dict.fromkeys(fleet_bootstrap.TOOL_FIXES.get(t, f"install {t}") for t in missing))
            lines.append(f"  {check}: {fix}")
        return "bootstrap does not allow enrollment:\n" + "\n".join(lines) + \
            "\nglaeda-mini-fleet preflight (from the operator Mac) checks all of these at once."
    # The bootstrap prints {"error": ...} on stderr when it cannot observe the node at all.
    error = None
    for line in reversed(stderr.strip().splitlines()):
        parsed = read_json_text(line)
        if parsed and isinstance(parsed.get("error"), str):
            error = parsed["error"]
            break
    if error:
        return f"bootstrap could not observe this mini: {fleet_bootstrap.explain_error(error)}"
    tail = (stderr.strip().splitlines() or [""])[-1][:300]
    return f"bootstrap exited {code} without a verdict" + (f": {tail}" if tail else "")


def read_json_text(text: str | None) -> dict[str, Any] | None:
    try:
        value = json.loads(text or "")
    except ValueError:
        return None
    return value if isinstance(value, dict) else None


DESCRIPTIONS = {
    "stage": "verify and stage the reviewed candidate bundle as a new generation (no Rust build)",
    "install-glaeda": "build and install the glaeda binary (keeps one rollback copy)",
    "bootstrap": "read-only bootstrap of this mini against the cmux checkout",
    "renew": "quarantine and renew the enrollment onto this candidate and toolchain (skipped when it already matches)",
    "enroll": "create the enrollment record (state: enrolling)",
    "accept-local": "local acceptance: a cold cmux.macos.dev-check@1 build under Glaeda",
    "adopt-class": "class acceptance: re-check this mini against its class receipt (bootstrap only, no build)",
    "eligible": "transition the enrollment to eligible",
    "status": "print the node status",
}


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="glaeda-mini-enroll", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--cmux-root", type=Path, required=True, help="clean cmux checkout (after ./scripts/setup.sh)")
    p.add_argument("--node-id", help="opaque node id for a first enrollment, such as cmux-mac-001")
    p.add_argument("--apply", action="store_true", help="run the steps (default is plan only)")
    p.add_argument("--reaccept", action="store_true", help="run accept-local even if the receipt is current")
    p.add_argument("--no-accept", action="store_true",
                   help="bootstrap and enroll only; skip accept-local (its class already holds an acceptance)")
    p.add_argument("--rebuild", action="store_true", help="rebuild and reinstall the glaeda binary")
    p.add_argument("--renew", action="store_true",
                   help="move an enrolled node onto --candidate: quarantine, renew and accept again when needed")
    p.add_argument("--python", help="Python 3.13+ interpreter (default: found automatically)")
    p.add_argument("--candidate", type=Path, help="downloaded candidate archive (docs/FLEET_DISTRIBUTION.md)")
    p.add_argument("--sha256", help="candidate archive SHA-256 from the trusted run's receipt")
    p.add_argument("--source", help="candidate's exact 40-character source commit")
    p.add_argument("--class-receipt", help="class acceptance receipt file, or - for stdin (glaeda-mini-fleet onboard)")
    p.add_argument("--class-receipt-sha256", help="its receiptSha256, from the operator's manifest")
    p.add_argument("--fleet-class", help="this mini's class: the manifest hardware key, such as m4pro-48")
    return p


CLASS_RE = re.compile(r"[a-z][a-z0-9-]{0,31}")
SHA256_RE = re.compile(r"sha256:[0-9a-f]{64}")
MAX_CLASS_RECEIPT_BYTES = 64 * 1024


def read_class_receipt(value: str) -> bytes:
    """The class receipt's bytes; cmux_fleet.py checks everything in them."""
    if value == "-":
        data = sys.stdin.buffer.read(MAX_CLASS_RECEIPT_BYTES + 1)
    else:
        try:
            data = Path(value).expanduser().read_bytes()
        except OSError as error:
            raise Stop(f"cannot read the class receipt: {error}") from None
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        text = ""
    if not data or len(data) > MAX_CLASS_RECEIPT_BYTES or read_json_text(text) is None:
        raise Stop("the class receipt is empty, too large, or not a UTF-8 JSON object")
    return data


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if DARWIN_REQUIRED and platform.system() != "Darwin":
        print("glaeda-mini-enroll: macOS only", file=sys.stderr)
        return 2
    python = pick_python(args.python)
    if python is None:
        print("glaeda-mini-enroll: needs Python 3.13 or newer (accept-local uses os.waitid). "
              f"Install it: {PYTHON_FIX}", file=sys.stderr)
        return 2
    candidate = [args.candidate, args.sha256, args.source]
    if any(candidate) and not all(candidate):
        print("glaeda-mini-enroll: --candidate, --sha256 and --source go together", file=sys.stderr)
        return 2
    klass = [args.class_receipt, args.class_receipt_sha256, args.fleet_class]
    if args.renew and not args.candidate:
        print("glaeda-mini-enroll: --renew needs --candidate, --sha256 and --source", file=sys.stderr)
        return 2
    if any(klass) and not (all(klass) and args.candidate):
        print("glaeda-mini-enroll: --class-receipt, --class-receipt-sha256 and --fleet-class go together, "
              "with --candidate (class acceptance binds the candidate)", file=sys.stderr)
        return 2
    if args.fleet_class and (not CLASS_RE.fullmatch(args.fleet_class)
                             or not SHA256_RE.fullmatch(args.class_receipt_sha256)):
        print("glaeda-mini-enroll: --fleet-class is lowercase (a hardware key such as m4pro-48) and --class-receipt-sha256 is "
              "sha256:<64 hex>", file=sys.stderr)
        return 2
    class_bytes = None
    if args.class_receipt and args.apply:
        # Only when it will be used: a plan-only run with `-` would otherwise wait on a terminal.
        try:
            class_bytes = read_class_receipt(args.class_receipt)
        except Stop as stop:
            print(f"glaeda-mini-enroll: {stop}", file=sys.stderr)
            return 2
    paths = Paths(Path.home())
    cmux_root = args.cmux_root.expanduser().resolve()
    generation = paths.generation(args.source) if args.source else None
    runner = Runner(python, paths, cmux_root, generation)
    enrollment = read_json(paths.enrollment)
    if enrollment is None and paths.enrollment.exists():
        print(f"glaeda-mini-enroll: {paths.enrollment} exists but cannot be read; inspect it rather than "
              "letting a new enrollment replace it", file=sys.stderr)
        return 2
    staged = generation is not None and (generation / "stage-receipt.json").is_file()
    state = State(binary=staged if generation else paths.glaeda_bin.is_file(), enrollment=enrollment,
                  acceptance_current=False)
    try:
        if staged:
            # Verify the saved bytes before running any of the generation's code.
            runner.inspect(args.sha256, args.source)
        if generation is None or staged:
            state.acceptance_current = runner.acceptance_current(enrollment)
        if generation is not None and enrollment is not None:
            # An unstaged candidate is new here, so no enrollment records its binary yet.
            state.stale = not staged or enrollment.get("glaedaGeneration") != glaeda_digest(generation / "bin/glaeda")
        steps = plan(state, args.node_id, args.reaccept, args.rebuild, candidate=generation is not None,
                     no_accept=args.no_accept, class_receipt=bool(args.class_receipt), renew=args.renew)
        print(f"glaeda-mini-enroll ({python})")
        for step in steps:
            print(f"  - {DESCRIPTIONS[step]}")
        if not args.apply:
            print("\nRe-run with --apply to do it.")
            return 0
        bootstrap_path: Path | None = None
        queue = list(steps)
        while queue:
            step = queue.pop(0)
            print(f"\n== {step}", flush=True)
            if step == "install-glaeda":
                runner.install_glaeda()
            elif step == "stage":
                runner.stage(args.candidate.expanduser().resolve(), args.sha256, args.source)
                if args.renew and enrollment is not None:
                    # Unstaged read as stale; now the staged binary says whether the node already runs it
                    # (its generation directory had only been removed), so a current node is not renewed.
                    state.binary = True
                    state.acceptance_current = runner.acceptance_current(enrollment)
                    state.stale = enrollment.get("glaedaGeneration") != glaeda_digest(generation / "bin/glaeda")
                    queue = plan(state, args.node_id, args.reaccept, args.rebuild, candidate=True,
                                 no_accept=args.no_accept, class_receipt=bool(args.class_receipt), renew=True)
                    print("staged; still to do: " + ", ".join(queue))
            elif step == "bootstrap":
                bootstrap_path = runner.bootstrap()
            elif step == "renew":
                assert bootstrap_path is not None
                runner.renew(bootstrap_path)
            elif step == "enroll":
                assert bootstrap_path is not None
                runner.enroll(bootstrap_path, args.node_id)
            elif step == "accept-local":
                runner.accept_local()
            elif step == "adopt-class":
                assert class_bytes is not None
                try:
                    runner.adopt_class(class_bytes, args.class_receipt_sha256, args.fleet_class)
                except Stop:
                    if args.renew:
                        # Not left enrolling: quarantine says why, and the next --renew starts clean.
                        runner.quarantine("failed_acceptance")
                        print("\nglaeda-mini-enroll: quarantined (failed_acceptance) until it matches its class or "
                              "accepts locally", file=sys.stderr)
                    raise
            elif step == "eligible":
                runner.eligible()
            elif step == "status":
                status = runner.status()
                print(json.dumps(status, indent=2, sort_keys=True))
                if not status.get("routingCandidateEligible") and not args.no_accept:
                    raise Stop("status does not report this node as a routing candidate")
    except Stop as stop:
        print(f"\nglaeda-mini-enroll: {stop}", file=sys.stderr)
        return 1
    enrolled = read_json(paths.enrollment) or {}
    if args.no_accept and enrolled.get("state") != "eligible":
        print(f"\n{enrolled.get('nodeId')} is enrolled ({enrolled.get('state')}) without a node acceptance "
              "(--no-accept). It becomes eligible after accept-local, or on its class's acceptance: re-run "
              "with --class-receipt, --class-receipt-sha256 and --fleet-class.")
        return 0
    # Accepted: the transient bootstrap and the one-step rollback are no longer needed.
    for leftover in (paths.fleet / "bootstrap.json", paths.install / "glaeda.rollback"):
        leftover.unlink(missing_ok=True)
    print(f"\n{(read_json(paths.enrollment) or {}).get('nodeId')} is eligible. "
          f"{NEXT_STEP}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
