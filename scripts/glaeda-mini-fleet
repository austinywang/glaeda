from pathlib import Path
from typing import Any

SCHEMA = "glaeda-mini-fleet/v1"
# What a host is for; the target end state can give one host several.
ROLES = ("dev-builds", "ci-runner", "nightly", "ios-simulators", "cache-host", "chromium-builds", "catch-up-writer")
# Fleet compile-cache catch-up (cmuxterm-hq build-fleet README, "Filling the store"). The one writer host fills
# the store from its own LaunchDaemon and runs no dev-build worker, so no team-submitted build runs next to its
# signing key. The dev-build workers (dev-builds) are the readers: a read-only fleet-cas node and the released
# recipe's cmux-build-mode.py. check only reports here: the cache keys include xcode/src/cmux and xcode/DerivedData,
# so nothing in this tool deletes, moves or re-clones them.
CATCH_UP_WRITER = "catch-up-writer"
CATCH_UP_READER_ROLES = ("dev-builds",)
CATCH_UP_FILL_LABEL = "ai.manaflow.cmux-build-catch-up-fill"
HQ_WORKER_LABEL = "ai.manaflow.cmux-build-worker"
# launchd jobs that start on a timer (StartInterval): loaded but "not running" between ticks is their normal state.
# glaeda-disk agents: timer driven (900 s and 21600 s), so "not running" between runs is healthy.
INTERVAL_LABELS = (CATCH_UP_FILL_LABEL, "com.teamleaderleo.glaeda.disk-pressure", "com.teamleaderleo.glaeda.disk-dedupe")
# Paths under FLEET_ROOT that catch-up builds key on, and the kind each must be. A symlink anywhere here is drift.
FLEET_CAS_PATHS = {
    "xcode": "dir", "xcode/src": "dir", "xcode/src/cmux": "dir", "xcode/DerivedData": "dir", "xcode/bin": "dir",
    "xcode/fleet-cas.sock": "socket", "xcode/fleet-cas.env": "file", "xcode/bin/fleet-cas-marker.sh": "file",
    "xcode/bin/fleet-cas-settings.sh": "file",
}
# The writer's main builds run under this one (glaeda-fleet-cas writer), which publishes the per-commit marker.
FLEET_CAS_WRITER_PATHS = {"xcode/bin/fleet-cas-writer-build.sh": "file"}
# Made by the first catch-up build rather than by glaeda-fleet-cas, so only their shape can be wrong.
FLEET_CAS_BUILD_PATHS = ("xcode/src", "xcode/src/cmux", "xcode/DerivedData")
FLEET_CAS_NODE_MODES = {CATCH_UP_WRITER: "signing", "reader": "read-only"}
# Scheduling class (cmuxterm-hq build-fleet/FLEET-MEMBERSHIP.md). `hardware` names the machine
# shape the check verifies; `class` says what work the member takes.
CLASSES = ("xl", "std", "light", "dev", "borrowed")
RUNNER_CLASSES = ("xl", "std", "light")
AVAILABILITY = ("dedicated", "opportunistic")
# Interactive developer borrowing starts with ordinary CI members only. Unknown/additional roles fail closed:
# cache/controller/writer/dev-build machines keep their special duties until the manifest grows an explicit
# developer-lease capability.
BORROW_SAFE_ROLES = frozenset({"ci-runner", "ios-simulators"})
SCRIPT_DIR = Path(__file__).resolve().parent
PROBE = SCRIPT_DIR / "cmux_mini_probe.sh"
PREFLIGHT_PROBE = SCRIPT_DIR / "cmux_mini_preflight.sh"
FIX_LIBRARY = SCRIPT_DIR / "cmux_mini_fix.sh"
DEFAULT_MANIFEST = Path(os.environ.get("GLAEDA_MINI_FLEET_MANIFEST", "~/.config/glaeda/mini-fleet.json")).expanduser()
SSH = "/usr/bin/ssh"
PROBE_TIMEOUT = 90
PREFLIGHT_TIMEOUT = 180
LIST_KEYS = {"xcode_app", "xcode_ready", "disk", "launchd", "fleet_mtime", "ak_file", "ak_key",
             "pf_tool", "pf_submodule", "pf_pmset", "pf_runner", "pf_brew_formula", "pf_secret",
             "ios_runtime", "ios_device", "fleet_cas_path"}
# Same rule as scripts/cmux_fleet.py NODE_RE: an opaque cmux-* fleet node id.
NODE_ID_RE = re.compile(r"cmux-[a-z0-9][a-z0-9-]{2,59}\Z")
VERSION_RE = re.compile(r"\d+(\.\d+){0,2}\Z")
# Paths and names that go into shell commands and a sudoers rule verbatim: no spaces, commas or quotes.
SAFE_PATH_RE = re.compile(r"/[A-Za-z0-9._/-]+\Z")
SAFE_WORD_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/-]*\Z")
TOOLCHAIN_KEYS = {"xcode", "metal", "zig_min", "rustup_default", "python_min", "cmux"}
# iOS simulator runtime builds (23F77) and device type names (iPhone 17 Pro Max).
IOS_BUILD_RE = re.compile(r"[0-9]{2}[A-Z][0-9]{1,5}[a-z]?\Z")
IOS_DEVICE_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ().-]{0,63}\Z")
# glaeda-mini-enroll's accept-local needs os.waitid, which CPython on macOS has from 3.13.
ENROLL_PYTHON_MIN = "3.13"
# The glaeda-mini-enroll options onboard, repair and upgrade pass; a ~/glaeda without them fails with
# "unrecognized arguments", so preflight asks for them and fix moves ~/glaeda until it has them.
ENROLL_FLAGS = ("--renew", "--class-receipt", "--class-receipt-sha256", "--fleet-class")
# The Homebrew formulas fix installs, all pinned afterwards: class receipts pin toolchain strings, and the
# reference host (cmux14) runs `brew pin zig rustup python@3.13`.
BREW_FORMULAS = ("rustup", "zig", "python@3.13")
# The workload PATH's python3: brew's python@3.13 installs only python3.13, so /usr/bin/python3 (3.9) would win.
BREW_PYTHON = ("python@3.13", "python3.13")
# Homebrew formulas fix installs and never pins: cmux CI jobs call gh (authenticated by GH_TOKEN, so no gh auth),
# and no class receipt names it (cmux_fleet_bootstrap's toolchain observations and MACOS_WORKLOAD_TOOLS omit it).
BREW_UNPINNED = ("gh",)
# Files sshd reads by default (OpenSSH AuthorizedKeysFile); every other authorized_keys* is a copy.
LIVE_KEY_FILES = ("authorized_keys", "authorized_keys2")
# Reservations: a marker on the mini that every scheduler skips until it expires.
FLEET_ROOT = "/Users/Shared/cmux-build-fleet"
RESERVATION_FILE = "reservation.json"
RESERVATION_SCHEMA = "glaeda-reservation/v1"
RESERVATION_MAX_HOURS = 72
RESERVATION_MAX_BYTES = 4096  # the probe ships at most one byte more, so a larger marker reads as invalid
OWNER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._@+-]{0,99}\Z")
PURPOSE_MAX = 200
# Check areas that inform without counting as drift.
INFO_AREAS = ("pending", "reserved", "disabled")


class Failure(Exception):
    pass


def _load(name: str, path: Path) -> Any:
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader(name, os.fspath(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


# preflight holds hosts to the same rules as the steps it predicts, so it reads them from their owners.
sys.path.insert(0, os.fspath(SCRIPT_DIR))
import cmux_fleet_bootstrap as bootstrap  # noqa: E402
enroll = _load("glaeda_mini_enroll", SCRIPT_DIR / "glaeda-mini-enroll")


# ---------------------------------------------------------------- manifest


def load_manifest(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        raise Failure(f"no manifest at {path}; pass --manifest or set GLAEDA_MINI_FLEET_MANIFEST") from None
    except json.JSONDecodeError as error:
        raise Failure(f"{path}: invalid JSON: {error}") from None
    if data.get("schema") != SCHEMA:
        raise Failure(f"{path}: schema must be {SCHEMA!r}, got {data.get('schema')!r}")
    upgrade_legacy_classes(data)
    for field in ("ssh_user", "keys", "hardware", "defaults", "hosts"):
        if field not in data:
            raise Failure(f"{path}: missing {field!r}")
    never = {host_key(n) for n in data.get("never_touch", [])}
    for name, host in data["hosts"].items():
        if name.startswith("-") or not name:
            raise Failure(f"{path}: host name {name!r} is not usable as an SSH destination")
        if host_key(name) in never or host_key(host.get("hostname") or "") in never:
            raise Failure(f"{path}: host {name} is also in never_touch")
        unknown = set(host.get("roles", [])) - set(ROLES)
        if unknown:
            raise Failure(f"{path}: host {name} has unknown roles {sorted(unknown)}; known: {', '.join(ROLES)}")
        if CATCH_UP_WRITER in host.get("roles", []):
            clash = sorted(set(host["roles"]) & set(CATCH_UP_READER_ROLES))
            if clash:
                raise Failure(f"{path}: host {name} is the {CATCH_UP_WRITER} and also {', '.join(clash)}; "
                              "the writer runs no dev-build worker")
            # PR code must never run next to the signing key: a writer's runners take trusted refs only.
            if "ci-runner" in host["roles"] and not (host_policy(data, name).get("runner") or {}).get("trustedRef"):
                raise Failure(f"{path}: host {name} is the {CATCH_UP_WRITER} and a ci-runner without "
                              "overrides.runner.trustedRef; PR jobs would run next to the signing key")
            if HQ_WORKER_LABEL in host_policy(data, name).get("launchd", {}).get("running", []):
                raise Failure(f"{path}: host {name} is the {CATCH_UP_WRITER} but launchd.running lists {HQ_WORKER_LABEL}")
        if host.get("hardware") not in data["hardware"]:
            raise Failure(f"{path}: host {name} has unknown hardware {host.get('hardware')!r}")
        if "class" in host and host["class"] not in CLASSES:
            raise Failure(f"{path}: host {name} has unknown class {host['class']!r}; known: {', '.join(CLASSES)}")
        # glaeda-cmux-runner refuses a member without availability, so a classed host must say.
        if "class" in host and "availability" not in host:
            raise Failure(f"{path}: host {name} has a class but no availability ({', '.join(AVAILABILITY)})")
        if "availability" in host and host["availability"] not in AVAILABILITY:
            raise Failure(f"{path}: host {name} has unknown availability {host['availability']!r}; "
                          f"known: {', '.join(AVAILABILITY)}")
        if "owner" in host and not isinstance(host["owner"], str):
            raise Failure(f"{path}: host {name} owner must be a string")
        accepted = host.get("accepted_secrets", [])
        if not isinstance(accepted, list) or not all(
                isinstance(p, str) and p.startswith(("/", "~/")) and not any(c in p for c in "\n\r\t")
                for p in accepted):
            raise Failure(f"{path}: host {name} accepted_secrets must be a list of absolute or ~/ paths")
        for key_id in host_policy(data, name)["authorized_keys"].get("require", []) + \
                host_policy(data, name)["authorized_keys"].get("allow", []):
            if key_id not in data["keys"]:
                raise Failure(f"{path}: host {name} names unknown key {key_id!r}")
    writers = [n for n, h in data["hosts"].items() if CATCH_UP_WRITER in h.get("roles", [])]
    if len(writers) > 1:
        raise Failure(f"{path}: hosts {', '.join(writers)} are all {CATCH_UP_WRITER}; the fleet has one writer")
    node_ids: dict[str, str] = {}
    for name, host in data["hosts"].items():
        node_id = host.get("node_id")
        if node_id is None:
            continue
        if not isinstance(node_id, str) or NODE_ID_RE.fullmatch(node_id) is None:
            raise Failure(f"{path}: host {name} node_id {node_id!r} is not an opaque cmux-* id such as cmux-mac-003")
        if node_id in node_ids:
            raise Failure(f"{path}: hosts {node_ids[node_id]} and {name} share node_id {node_id}")
        node_ids[node_id] = name
    validate_onboarding(path, data)
    validate_toolchain(path, "defaults", data["defaults"].get("toolchain"))
    validate_ios_simulator(path, "defaults", data["defaults"].get("ios_simulator"))
    for name, host in data["hosts"].items():
        validate_toolchain(path, f"host {name}", host.get("overrides", {}).get("toolchain"))
        validate_ios_simulator(path, f"host {name}", host.get("overrides", {}).get("ios_simulator"))
    for key_id, key in data["keys"].items():
        public = key.get("public_key")
        if public is not None and (not isinstance(public, str) or "\n" in public.strip()
                                   or not public.startswith(("ssh-", "ecdsa-", "sk-"))):
            raise Failure(f"{path}: key {key_id} public_key must be one bare key line; restrictions go in options")
        options = key.get("options")
        if options is not None and (not isinstance(options, str) or not options or options != options.strip()
                                    or any(c in options for c in "\n\r\t") or not options.isprintable()
                                    or not options_well_formed(options)):
            raise Failure(f"{path}: key {key_id} options must be one printable authorized_keys options field")
    return data


def validate_ios_simulator(path: Path, where: str, ios: Any) -> None:
    """ios_simulator: {"runtimes": ["23F77"], "exclusive": true, "devices": ["iPhone 17 Pro Max"]}.

    runtimes are iOS simulator runtime builds every such host must have; exclusive means no others;
    devices are device types that must exist, available, on each declared runtime.
    """
    if ios is None:
        return
    if not isinstance(ios, dict) or set(ios) - {"runtimes", "exclusive", "devices"}:
        raise Failure(f"{path}: {where} ios_simulator takes runtimes, exclusive and devices")
    runtimes, devices = ios.get("runtimes", []), ios.get("devices", [])
    if not isinstance(runtimes, list) or not all(isinstance(b, str) and IOS_BUILD_RE.fullmatch(b) for b in runtimes):
        raise Failure(f"{path}: {where} ios_simulator.runtimes must be runtime builds such as 23F77")
    if not isinstance(devices, list) or not all(isinstance(d, str) and IOS_DEVICE_RE.fullmatch(d) for d in devices):
        raise Failure(f"{path}: {where} ios_simulator.devices must be device type names such as iPhone 17 Pro Max")
    if not isinstance(ios.get("exclusive", False), bool):
        raise Failure(f"{path}: {where} ios_simulator.exclusive must be true or false")
    if ios.get("exclusive") and not runtimes:
        raise Failure(f"{path}: {where} ios_simulator.exclusive needs at least one runtime")


def ios_simulator_drift(ios: dict[str, Any], obs: dict[str, Any]) -> list[tuple[str, str]]:
    """(message, fix) for each way the observed iOS simulators differ from the declared ones."""
    runtimes = obs.get("ios_runtimes", [])
    have = {r["build"]: r for r in runtimes if r.get("available", True)}
    out = []
    for build in ios.get("runtimes", []):
        if build not in have:
            # -buildVersion only takes what Apple lists for this Xcode, so name the build to confirm instead.
            out.append((f"iOS simulator runtime {build} missing",
                        f"xcodebuild -downloadPlatform iOS with the pinned Xcode (must yield {build}), "
                        "or xcrun simctl runtime add <dmg>"))
    if ios.get("exclusive"):
        # An unavailable runtime is still extra: deleting it is the fix.
        for build, r in sorted((r["build"], r) for r in runtimes):
            if build not in ios.get("runtimes", []):
                out.append((f"extra iOS simulator runtime {r['full']} ({build})",
                            f"xcrun simctl runtime delete {build}"))
    names = {(d["runtime"], d["name"]) for d in obs.get("ios_devices", [])}
    for build in ios.get("runtimes", []):
        short = have.get(build, {}).get("short")
        for device in ios.get("devices", []) if short else []:
            if (short, device) not in names:
                out.append((f"no available {device} simulator on iOS {short}",
                            f"xcrun simctl create '{device}' '{device}' {have[build]['identifier']}"))
    return out


def options_well_formed(options: str) -> bool:
    """sshd's options field: quotes balance and no whitespace outside them."""
    quoted = False
    for i, c in enumerate(options):
        if c == '"' and (i == 0 or options[i - 1] != "\\"):
            quoted = not quoted
        elif c == " " and not quoted:
            return False
    return not quoted


def validate_toolchain(path: Path, where: str, toolchain: Any) -> None:
    """The declared toolchain goes into remote commands and a sudoers rule, so it is checked strictly."""
    if toolchain is None:
        return
    if not isinstance(toolchain, dict):
        raise Failure(f"{path}: {where} toolchain must be an object")
    unknown = set(toolchain) - TOOLCHAIN_KEYS
    if unknown:
        raise Failure(f"{path}: {where} toolchain has unknown keys {sorted(unknown)}; known: {', '.join(sorted(TOOLCHAIN_KEYS))}")
    xcode = toolchain.get("xcode")
    if xcode is not None:
        if not isinstance(xcode, dict) or not all(isinstance(xcode.get(k), str) for k in ("app", "version", "build")):
            raise Failure(f"{path}: {where} toolchain.xcode needs app, version and build strings")
        if not SAFE_PATH_RE.fullmatch(xcode["app"]) or not xcode["app"].endswith(".app"):
            raise Failure(f"{path}: {where} toolchain.xcode.app {xcode['app']!r} must be an absolute .app path without spaces")
        if not isinstance(xcode.get("select", True), bool):
            raise Failure(f"{path}: {where} toolchain.xcode.select must be true or false")
    for key in ("zig_min", "python_min"):
        value = toolchain.get(key)
        if value is not None and (not isinstance(value, str) or not VERSION_RE.fullmatch(value)):
            raise Failure(f"{path}: {where} toolchain.{key} {value!r} is not a version such as 0.16.0")
    if toolchain.get("python_min") and version_tuple(toolchain["python_min"]) < version_tuple(ENROLL_PYTHON_MIN):
        raise Failure(f"{path}: {where} toolchain.python_min is below {ENROLL_PYTHON_MIN}, which glaeda-mini-enroll needs")
    rustup = toolchain.get("rustup_default")
    if rustup is not None and (not isinstance(rustup, str) or not SAFE_WORD_RE.fullmatch(rustup)):
        raise Failure(f"{path}: {where} toolchain.rustup_default {rustup!r} is not a toolchain name such as stable")
    if not isinstance(toolchain.get("metal", True), bool):
        raise Failure(f"{path}: {where} toolchain.metal must be true or false")
    cmux = toolchain.get("cmux")
    if cmux is not None:
        if not isinstance(cmux, dict) or set(cmux) - {"repo", "ref", "root", "submodule_depth"}:
            raise Failure(f"{path}: {where} toolchain.cmux takes repo, ref, root and submodule_depth")
        if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", str(cmux.get("repo", "a/b"))):
            raise Failure(f"{path}: {where} toolchain.cmux.repo must be owner/name")
        if not SAFE_WORD_RE.fullmatch(str(cmux.get("ref", "main"))):
            raise Failure(f"{path}: {where} toolchain.cmux.ref must be a branch or tag name")
        if not re.fullmatch(r"~?/?[A-Za-z0-9._/-]+", str(cmux.get("root", "~/cmux"))):
            raise Failure(f"{path}: {where} toolchain.cmux.root must be a path without spaces")
        depth = cmux.get("submodule_depth", 1)
        if not isinstance(depth, int) or isinstance(depth, bool) or depth < 0:
            raise Failure(f"{path}: {where} toolchain.cmux.submodule_depth must be 0 (full) or a positive depth")


def validate_onboarding(path: Path, data: dict[str, Any]) -> None:
    """lan, runner, per-class compile_lane and acceptance, per-host lan_ip: what share and onboard read."""
    lan = data.get("lan")
    if lan is not None:
        if not isinstance(lan, dict) or set(lan) - {"subnet", "auth", "note"}:
            raise Failure(f"{path}: lan takes subnet, auth and note")
        if "subnet" in lan and not re.fullmatch(r"(\d{1,3}\.){1,3}", str(lan["subnet"])):
            raise Failure(f"{path}: lan.subnet is an address prefix ending in a dot, such as 172.20.21.")
        auth = lan.get("auth", "agent")
        if auth != "agent" and not (isinstance(auth, dict) and set(auth) == {"identity_file"}
                                    and re.fullmatch(r"~?/?[A-Za-z0-9._/-]+", str(auth["identity_file"]))):
            raise Failure(f"{path}: lan.auth is \"agent\" (ssh -A from the operator) or {{\"identity_file\": PATH}} on the seed")
    runner = data.get("runner")
    if runner is not None and (not isinstance(runner, dict) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*", str(runner.get("org", "")))):
        raise Failure(f"{path}: runner.org must be a GitHub organization name")
    for shape, spec in data["hardware"].items():
        if not isinstance(spec.get("compile_lane", True), bool):
            raise Failure(f"{path}: hardware {shape} compile_lane must be true or false")
        accepted = spec.get("acceptance")
        if accepted is not None and not (
                isinstance(accepted, dict)
                and set(accepted) <= {"xcode_build", "candidate", "node", "note", "receipt", "receipt_sha256"}
                and re.fullmatch(r"[0-9A-Za-z]+", str(accepted.get("xcode_build", "")))
                and re.fullmatch(r"[0-9a-f]{12}", str(accepted.get("candidate", "")))
                and NODE_ID_RE.fullmatch(str(accepted.get("node", "")))
                and ("receipt" in accepted) == ("receipt_sha256" in accepted)
                and re.fullmatch(r"(sha256:[0-9a-f]{64})?", str(accepted.get("receipt_sha256", "")))):
            raise Failure(f"{path}: hardware {shape} acceptance needs xcode_build, candidate (12 hex) and node (a node id), "
                          "and receipt (a file path) with receipt_sha256 (sha256:<64 hex>) together")
    pin = data.get("candidate")
    if pin is not None and not (
            isinstance(pin, dict) and {"source", "sha256", "run", "artifact", "repo"} <= set(pin)
            and set(pin) <= {"source", "sha256", "run", "artifact", "repo", "expires", "note"}
            and re.fullmatch(r"[0-9a-f]{40}", str(pin["source"])) and re.fullmatch(r"[0-9a-f]{64}", str(pin["sha256"]))
            and re.fullmatch(r"[0-9]+", str(pin["run"])) and re.fullmatch(r"[A-Za-z0-9._-]+", str(pin["artifact"]))
            and re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", str(pin["repo"]))
            and re.fullmatch(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)?", str(pin.get("expires", "")))):
        raise Failure(f"{path}: candidate needs source (40 hex), sha256 (64 hex), run, artifact and repo, "
                      "and optionally expires (an ISO time such as 2026-10-24T15:15:27Z)")
    for name, host in data["hosts"].items():
        if "lan_ip" in host and not re.fullmatch(r"(\d{1,3}\.){3}\d{1,3}", str(host["lan_ip"])):
            raise Failure(f"{path}: host {name} lan_ip must be an IPv4 address")


def toolchain(manifest: dict[str, Any], name: str) -> dict[str, Any]:
    """The toolchain the manifest declares for one host, or {} when it declares none."""
    return host_policy(manifest, name).get("toolchain") or {}


def cmux_checkout(manifest: dict[str, Any], name: str) -> dict[str, Any]:
    """Where and what the host's cmux checkout is: repo, ref, root, submodule depth."""
    declared = toolchain(manifest, name).get("cmux") or {}
    return {"repo": declared.get("repo", bootstrap.CMUX_REPOSITORY), "ref": declared.get("ref", "main"),
            "root": declared.get("root") or host_policy(manifest, name).get("cmux_root", DEFAULT_CMUX_ROOT),
            "depth": declared.get("submodule_depth", 1)}


def upgrade_legacy_classes(data: dict[str, Any]) -> None:
    """Read a manifest written before `hardware` split from `class`.

    Old manifests keep machine shapes in a top-level `classes` table and name one per host in
    `class`. Those become `hardware`; the host then has no scheduling class until the manifest
    gives it one.
    """
    if "hardware" in data or "classes" not in data:
        return
    if not isinstance(data.get("hosts"), dict):
        raise Failure("hosts must be an object keyed by host name")
    data["hardware"] = data.pop("classes")
    for host in data.get("hosts", {}).values():
        if isinstance(host, dict) and "class" in host and "hardware" not in host:
            host["hardware"] = host.pop("class")


def host_key(name: str) -> str:
    """Compare host names case-insensitively and without a trailing .local."""
    name = name.strip().lower()
    return name[: -len(".local")] if name.endswith(".local") else name


def merge(base: dict[str, Any], over: dict[str, Any]) -> dict[str, Any]:
    out = dict(base)
    for key, value in over.items():
        out[key] = merge(out[key], value) if isinstance(value, dict) and isinstance(out.get(key), dict) else value
    return out


def host_policy(manifest: dict[str, Any], name: str) -> dict[str, Any]:
    host = manifest["hosts"][name]
    return merge(manifest["defaults"], host.get("overrides", {}))


def select_hosts(manifest: dict[str, Any], wanted: list[str] | None) -> list[str]:
    names = list(manifest["hosts"])
    if not wanted:
        return names
    never = {host_key(n) for n in manifest.get("never_touch", [])}
    for name in wanted:
        if host_key(name) in never:
            raise Failure(f"{name} is in never_touch; this tool does not connect to it")
        if name not in manifest["hosts"]:
            raise Failure(f"{name} is not in the manifest")
    return [n for n in names if n in wanted]


# ---------------------------------------------------------------- observe


def parse_probe(text: str) -> dict[str, Any]:
    out: dict[str, Any] = {k: [] for k in LIST_KEYS}
    for line in text.splitlines():
        key, sep, value = line.partition("\t")
        if not sep:
            continue
        if key in LIST_KEYS:
            out[key].append(value)
        else:
            out[key] = value
    return {
        "user": out.get("user"),
        "sudo": out.get("sudo"),
        "admin_group": out.get("admin_group") == "yes",
        "hostname": out.get("hostname"),
        "computer_name": out.get("computer_name"),
        "model": out.get("model"),
        "chip": out.get("chip"),
        "cpus": int(out.get("cpus") or 0),
        "memory_gib": round(int(out.get("memory_bytes") or 0) / 2**30),
        "macos": out.get("macos"),
        "macos_build": out.get("macos_build"),
        "xcode_apps": [dict(zip(("path", "kind", "version", "build"), v.split("|", 3))) for v in out["xcode_app"]],
        "xcode_ready": {path: {"licence": lic, "first_launch": first}
                        for path, lic, first in (v.rsplit("|", 2) for v in out["xcode_ready"])},
        "xcode_select": out.get("xcode_select"),
        "xcode_license_accepted": out.get("xcode_license_accepted"),
        "disk": {p: {"total_gib": int(t), "free_gib": int(f)}
                 for p, t, f in (v.split("|") for v in out["disk"])},
        "launchd": [dict(zip(("domain", "label", "state"), v.split("|", 2))) for v in out["launchd"]],
        "fleet_worker": {
            "root": out.get("fleet_root") == "present",
            "process": out.get("fleet_worker_proc"),
            "labels": out.get("fleet_labels"),
            "last_job": out.get("fleet_last_job"),
            "recipe": out.get("fleet_recipe"),
            "worker_sha256_12": out.get("fleet_worker_sha"),
            "controller_token": out.get("controller_token"),
        },
        "fleet_cas": {
            "paths": dict(v.split("|", 1) for v in out["fleet_cas_path"] if "|" in v),
            "node_mode": out.get("fleet_cas_node_mode"),
            "catch_up": out.get("fleet_catch_up") or None,  # "0" when bin/worker exports CMUX_CI_CATCH_UP=0
            "node": out.get("fleet_cas_node"),
            "recipe": out.get("fleet_recipe_released"),
            "build_mode": out.get("fleet_recipe_build_mode"),
        },
        "enrolled_node_id": out.get("fleet_node_id"),
        "reservation": probe_reservation(out.get("reservation"), out.get("reservation_raw")),
        "host_lock": out.get("host_lock"),
        "runner_worker": out.get("runner_worker") or "unknown",
        "ios_runtimes": ios_runtimes(out["ios_runtime"]),
        "ios_devices": [dict(zip(("runtime", "name"), v.split("|", 1))) for v in out["ios_device"] if "|" in v],
        "authorized_keys_files": [v.split("|")[0] for v in out["ak_file"]],
        "authorized_keys": [parse_key(v) for v in out["ak_key"] if v.split("|", 1)[0] in LIVE_KEY_FILES],
        **({"preflight": parse_preflight(out)} if "pf_python" in out else {}),
    }


def ios_runtimes(lines: list[str]) -> list[dict[str, Any]]:
    """Probe ios_runtime lines, keeping only well-formed ones: their fields go into operator fix text."""
    runtimes = []
    for line in lines:
        fields = line.split("|")
        if len(fields) not in (4, 5):
            continue
        short, full, build, identifier = fields[:4]
        if not (VERSION_RE.fullmatch(short) and VERSION_RE.fullmatch(full) and IOS_BUILD_RE.fullmatch(build)
                and re.fullmatch(r"com\.apple\.[A-Za-z0-9.-]+", identifier)):
            continue
        runtimes.append({"short": short, "full": full, "build": build, "identifier": identifier,
                         "available": fields[4:] != ["unavailable"]})
    return runtimes


def parse_preflight(out: dict[str, Any]) -> dict[str, Any]:
    """The cmux_mini_preflight.sh section of a probe, as plain data."""
    def split(key: str, n: int) -> list[str] | None:
        value = out.get(key)
        return None if value is None else (value.split("|", n - 1) + [""] * n)[:n]

    sdks, metal, python = split("pf_sdks", 2), split("pf_metal", 2), split("pf_python", 2)
    python3, brew_dir = split("pf_python3", 2), split("pf_brew_dir", 2)
    prepared = split("pf_update_prepared", 2)
    channel, candidate = split("pf_rust_channel", 3), split("pf_candidate", 3)
    return {
        "sdks": None if sdks is None else {"state": sdks[0], "detail": sdks[1]},
        "metal": None if metal is None else {"ok": metal[0] == "ok", "detail": metal[1]},
        "tools": {t: {"path": p or None, "version": v} for t, p, v in
                  ((v.split("|", 2) + ["", ""])[:3] for v in out["pf_tool"])},
        "rust_channel": None if channel is None else {"channel": channel[0], "rustc": channel[1], "cargo": channel[2]},
        "rust_default": out.get("pf_rust_default"),
        "python": {"path": python[0] or None, "version": python[1] or None},
        "cmux": out.get("pf_cmux") == "present",
        "cmux_pin": out.get("pf_cmux_pin"),
        "submodules": out["pf_submodule"],
        "zig_min": out.get("pf_zig_min") or None,
        "setup_artifacts": out.get("pf_setup_artifacts") == "yes",
        "dirty": int(out.get("pf_cmux_dirty") or 0),
        "candidate": None if candidate is None else
        {"source12": candidate[0], "staged": candidate[1] == "yes", "archive": candidate[2] == "yes",
         "generation": out.get("pf_candidate_generation") or None},
        "glaeda_checkout": out.get("pf_glaeda") == "present",
        "glaeda_head": out.get("pf_glaeda_head") or None,
        # The ENROLL_FLAGS ~/glaeda lacks; None from a probe that predates the question.
        "glaeda_lacking": None if "pf_glaeda_lacking" not in out else out["pf_glaeda_lacking"].split(),
        "glaeda_dirty": int(out.get("pf_glaeda_dirty") or 0),
        "python3": None if python3 is None else {"path": python3[0] or None, "version": python3[1] or None},
        "brew_python3": out.get("pf_brew_python3") or None,
        # gh as the workload PATH resolves it: its path, "" when none, None from a probe that predates the question.
        "gh": out.get("pf_gh"),
        # state: empty (directories only), partial (an interrupted homebrew_fetch: a .git, no brew) or files.
        "brew_dir": None if brew_dir is None else {"owner": brew_dir[0], "state": brew_dir[1]},
        "brew_formulas": {f: state == "pinned" for f, _, state in (v.partition("|") for v in out["pf_brew_formula"])},
        "cache_root": out.get("pf_cache_root") == "present",
        "enroll_state": out.get("pf_enroll_state"),
        "enroll_generation": out.get("pf_enroll_generation") or None,
        "enroll_reason": out.get("pf_enroll_reason") or None,
        "acceptance": out.get("pf_acceptance"),
        "acceptance_class": out.get("pf_acceptance_class") or None,
        "brew_owner": out.get("pf_brew_owner"),
        "update_running": out.get("pf_update_running"),
        "update_prepared": None if prepared is None else {"state": prepared[0], "version": prepared[1]},
        "pmset": "\n".join(out["pf_pmset"]),
        "autoupdate": out.get("pf_autoupdate"),  # install|download; None from an older probe
        # dir|name|loaded|listening|held; an older probe sends only dir|name, which reads as unknown.
        "runners": [dict(zip(("dir", "name", "loaded", "listening", "held"),
                             (v.split("|", 4) + ["", "unknown", "", ""])[:5])) for v in out["pf_runner"]],
        # Paths of secret files the login user can read (never their contents); an older probe sends none.
        "secrets": out["pf_secret"],
        "home": out.get("pf_home") or None,
    }


def marker_from_bytes(raw: bytes) -> dict[str, Any]:
    """{"valid": True, owner, purpose, since, until} or {"valid": False, "why": ...}, by glaeda_reservation."""
    if len(raw) > RESERVATION_MAX_BYTES:
        return {"valid": False, "why": f"over {RESERVATION_MAX_BYTES} bytes"}
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return {"valid": False, "why": "not UTF-8"}
    marker, why = reservation_rules.parse(text)
    return {"valid": True, **marker} if marker else {"valid": False, "why": why}


def probe_reservation(flag: str | None, raw_b64: str | None) -> dict[str, Any] | None:
    """The probe's reservation lines as a marker; None when the host has none."""
    if raw_b64 is not None:
        try:
            raw = base64.b64decode(raw_b64, validate=True)
        except ValueError:
            return {"valid": False, "why": "the probe sent unreadable content"}
        return marker_from_bytes(raw)
    if flag is not None:
        return {"valid": False, "why": "a symlink, not a regular file, or unreadable"}
    return None


def reservation_state(reservation: dict[str, Any] | None, now: float) -> str | None:
    """None (no marker), invalid, active (now < until) or expired."""
    if reservation is None:
        return None
    if not reservation.get("valid"):
        return "invalid"
    return "active" if reservation_rules.active(reservation, now) else "expired"


def utc(epoch: float) -> str:
    try:
        return time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(epoch))
    except (ValueError, OverflowError, OSError):
        return f"epoch {epoch}"  # a hand-written marker can carry a time no calendar holds


def printable(text: str) -> str:
    """Remote text for a terminal: control characters become spaces."""
    return "".join(c if c.isprintable() else " " for c in text)


def describe_reservation(reservation: dict[str, Any]) -> str:
    try:
        return printable(reservation_rules.describe(reservation))
    except (ValueError, OverflowError, OSError):
        return printable(f"{reservation['owner'] or '?'} for {reservation['purpose'] or '?'} until epoch {reservation['until']}")


def parse_key(value: str) -> dict[str, Any]:
    """One probe ak_key line. options is False, True (present, digest unknown) or "h:<16 hex>"."""
    file, flag, fp = value.split("|", 2)
    options: bool | str = flag if flag.startswith("h:") else flag == "yes"
    parts = fp.split(" ", 2)
    if len(parts) < 3 or not parts[1].startswith("SHA256:"):
        return {"file": file, "fingerprint": None, "comment": fp, "options": options}
    comment, _, kind = parts[2].rpartition(" (")
    return {"file": file, "fingerprint": parts[1], "comment": comment, "type": kind.rstrip(")"), "options": options}


def options_digest(options: str) -> str:
    """How the probe reports a key's options: never their text, only this digest."""
    return "h:" + hashlib.sha256(options.encode()).hexdigest()[:16]


def key_line(key: dict[str, Any]) -> str:
    """The authorized_keys line apply writes: declared options, then the bare public key."""
    return f"{key['options']} {key['public_key']}" if key.get("options") else key["public_key"]


def observe_host(name: str, user: str, script: bytes | None = None, timeout: int = PROBE_TIMEOUT) -> dict[str, Any]:
    started = time.time()
    try:
        proc = subprocess.run(
            [SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-l", user, name, "/bin/bash", "-s"],
            input=script or PROBE.read_bytes(), capture_output=True, timeout=timeout, env={"PATH": "/usr/bin:/bin",
                                                                                       "HOME": os.environ["HOME"],
                                                                                       "SSH_AUTH_SOCK": os.environ.get("SSH_AUTH_SOCK", "")},
        )
    except subprocess.TimeoutExpired:
        return {"host": name, "reachable": False, "error": f"probe timed out after {timeout}s"}
    if proc.returncode != 0:
        err = proc.stderr.decode(errors="replace").strip().splitlines()
        return {"host": name, "reachable": False, "error": (err[-1] if err else f"ssh exit {proc.returncode}")[:200]}
    data = parse_probe(proc.stdout.decode(errors="replace"))
    return {"host": name, "reachable": True, "observed_at": int(started), **data}


def observe(manifest: dict[str, Any], hosts: list[str], preflight: bool = False) -> dict[str, Any]:
    def one(name: str) -> dict[str, Any]:
        if not preflight:
            return observe_host(name, manifest["ssh_user"])
        return observe_host(name, manifest["ssh_user"], preflight_script(manifest, name), PREFLIGHT_TIMEOUT)

    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        results = list(pool.map(one, hosts))
    return {"schema": SCHEMA + "/observed", "hosts": {r["host"]: r for r in results}}


# ---------------------------------------------------------------- check


def check_host(manifest: dict[str, Any], name: str, obs: dict[str, Any]) -> list[dict[str, str]]:
    issues: list[dict[str, str]] = []

    def drift(area: str, detail: str, fix: str = "", action: dict[str, str] | None = None) -> None:
        issue = {"host": name, "area": area, "detail": detail, "fix": fix}
        if action:
            issue["action"] = action
        issues.append(issue)

    if not obs.get("reachable"):
        drift("reach", obs.get("error", "unreachable"))
        return issues
    host = manifest["hosts"][name]
    policy = host_policy(manifest, name)
    shape = manifest["hardware"][host["hardware"]]

    reservation = obs.get("reservation")
    seen_at = obs.get("observed_at") or time.time()
    state = reservation_state(reservation, seen_at)
    marker = f"{FLEET_ROOT}/{RESERVATION_FILE}"
    if state == "active":
        drift("reserved", f"reserved by {describe_reservation(reservation)}; the runner hook and pools skip it")
        if reservation["until"] - seen_at > RESERVATION_MAX_HOURS * 3600:
            drift("reservation", f"reservation ends {utc(reservation['until'])}, more than {RESERVATION_MAX_HOURS} h "
                  "ahead, so it will not expire when forgotten",
                  f"ask {printable(reservation['owner'])} to re-reserve for less, or glaeda-mini-fleet release {name} --force --yes")
    elif state == "expired":
        drift("reservation", f"expired reservation by {describe_reservation(reservation)}",
              f"glaeda-mini-fleet release {name} --yes")
    elif state == "invalid":
        drift("reservation", f"{marker} is not a valid {RESERVATION_SCHEMA} marker ({reservation.get('why')}); "
              "the runner hook and pools treat it as reserved",
              f"inspect {marker}, then glaeda-mini-fleet release {name} --force --yes")
    if obs.get("host_lock") == "unknown":
        drift("host-lock", f"{FLEET_ROOT}/host.lock exists but its state is unknown to {obs.get('user')}",
              "make host.lock a regular file readable by the SSH user (660 cmux:staff)")

    if host.get("hostname") and obs["hostname"] != host["hostname"]:
        drift("identity", f"hostname {obs['hostname']!r}, manifest says {host['hostname']!r}")
    for field in ("model", "chip", "memory_gib", "cpus"):
        if field in shape and obs[field] != shape[field]:
            drift("hardware", f"{field} {obs[field]!r}, hardware {host['hardware']} says {shape[field]!r}")

    # The manifest assigns node ids, so a rerun of enrollment always asks for the same one.
    want_node = host.get("node_id")
    got_node = obs.get("enrolled_node_id")
    if want_node and not got_node:
        drift("pending", f"not enrolled yet; node id {want_node} is reserved for it",
              f"glaeda-mini-fleet onboard {name} --yes (glaeda-mini-enroll --node-id {want_node})")
    elif want_node and got_node != want_node:
        drift("enrollment", f"enrolled as {got_node}, manifest assigns {want_node}",
              "fix the manifest; an enrolled node keeps its id (glaeda-mini-enroll refuses a different one)")

    macos = policy.get("macos", {})
    if "major" in macos and not (obs["macos"] or "").startswith(f"{macos['major']}."):
        drift("macos", f"macOS {obs['macos']}, want major {macos['major']}")
    if "min" in macos and version_tuple(obs["macos"]) < version_tuple(macos["min"]):
        drift("macos", f"macOS {obs['macos']} is below the fleet floor {macos['min']}", "update macOS")

    xcode = policy.get("xcode", {})
    apps = {a["path"]: a for a in obs["xcode_apps"]}
    for want in xcode.get("apps", []):
        got = apps.get(want["path"])
        if not got:
            if want.get("clone_from"):
                drift("xcode", f"{want['path']} missing", f"clone {want['clone_from']} to {want['path']}",
                      {"kind": "clone_xcode", "path": want["path"], "source": want["clone_from"],
                       "version": want["version"], "build": want["build"]})
            else:
                drift("xcode", f"{want['path']} missing", "install it")
        elif got["kind"] != "dir":
            drift("xcode", f"{want['path']} is a {got['kind']}, want a real directory (symlinked paths break cache replay)")
        elif (got["version"], got["build"]) != (want["version"], want["build"]):
            drift("xcode", f"{want['path']} is {got['version']} ({got['build']}), want {want['version']} ({want['build']})")
        else:
            ready = obs.get("xcode_ready", {}).get(want["path"])
            developer = f"{want['path']}/Contents/Developer"
            if obs.get("xcode_ready") and not ready:
                drift("xcode", f"{want['path']} has no runnable xcodebuild; licence and first launch unknown")
            if ready and ready["licence"] != "accepted":
                drift("xcode", f"{want['path']} licence not accepted",
                      f"sudo env DEVELOPER_DIR={developer} xcodebuild -license accept")
            if ready and ready["first_launch"] != "done":
                drift("xcode", f"{want['path']} first launch not run",
                      f"sudo env DEVELOPER_DIR={developer} xcodebuild -runFirstLaunch")
    if xcode.get("select") and obs["xcode_select"] != xcode["select"]:
        drift("xcode", f"xcode-select {obs['xcode_select']!r}, want {xcode['select']!r}", f"sudo xcode-select -s {xcode['select']}")
    # Xcode treats a licence accepted for a newer version as covering older ones.
    if xcode.get("license") and not obs.get("xcode_ready") and \
            version_tuple(obs["xcode_license_accepted"]) < version_tuple(xcode["license"]):
        drift("xcode", f"licence accepted for {obs['xcode_license_accepted'] or 'nothing'}, want {xcode['license']}",
              "sudo xcodebuild -license accept && sudo xcodebuild -runFirstLaunch")

    for want in xcode.get("pending", []):
        if want["path"] not in apps:
            drift("pending", f"{want['path']} ({want['version']}) not yet installed; {want.get('note', 'staged next')}")

    keys = policy.get("authorized_keys", {})
    by_fp = {k["fingerprint"]: k for k in obs["authorized_keys"] if k.get("fingerprint")}
    known = {manifest["keys"][k]["fingerprint"]: k for k in manifest["keys"]}
    for key_id in keys.get("require", []):
        if manifest["keys"][key_id]["fingerprint"] not in by_fp:
            drift("ssh", f"required key {key_id} ({manifest['keys'][key_id]['comment']}) missing", f"add key {key_id}",
                  {"kind": "add_key", "key": key_id})
    allowed = {manifest["keys"][k]["fingerprint"] for k in keys.get("require", []) + keys.get("allow", [])}
    if keys.get("exclusive"):
        for fp, k in by_fp.items():
            if fp not in allowed:
                label = known.get(fp, "unlisted")
                drift("ssh", f"{label} key {fp[7:19]} ({k['comment']}) not allowed here", f"remove key {fp}")
    for k in obs["authorized_keys"]:
        if not k.get("fingerprint"):
            drift("ssh", "authorized_keys has an unparseable line")
        else:
            want = manifest["keys"].get(known.get(k["fingerprint"], ""), {}).get("options")
            if want and k["options"] != options_digest(want):
                drift("ssh", f"key {known[k['fingerprint']]} lacks its declared options "
                             f"({'none' if not k['options'] else 'different ones'}); replace its line",
                      f"remove key {k['fingerprint']}, then add key {known[k['fingerprint']]}")
            elif not want and k["options"]:
                drift("ssh", f"key {k['fingerprint'][7:19]} carries options; review them")
    for k in obs["authorized_keys"]:
        if k.get("file") != "authorized_keys":
            drift("ssh", f"key {(k['fingerprint'] or '?')[7:19]} ({k['comment']}) is in {k['file']}, which sshd also reads")
    stray = [f for f in obs["authorized_keys_files"] if f not in LIVE_KEY_FILES]
    if stray and keys.get("no_backups"):
        drift("ssh", f"stale authorized_keys copies: {', '.join(stray)}", "move them out of ~/.ssh")

    running = {j["label"]: j["state"] for j in obs["launchd"]}
    for label in policy.get("launchd", {}).get("running", []):
        state = running.get(label)
        if state is None:
            drift("launchd", f"{label} not installed")
        elif label in INTERVAL_LABELS and state != "not-loaded":
            exit_code = re.search(r"last_exit=(-?[0-9]+)\b", state)
            if exit_code and exit_code.group(1) != "0":
                drift("pending", f"{label} last exited {exit_code.group(1)}; loaded, runs on its timer",
                      "read its receipts (cmux-build-fleet logs/catch-up-fill.log)" if label == CATCH_UP_FILL_LABEL
                      else f"launchctl print gui/$(id -u)/{label}")
        elif not state.startswith("running"):
            drift("launchd", f"{label} is {state}")
    for label in policy.get("launchd", {}).get("absent", []):
        if label in running:
            drift("launchd", f"{label} installed, manifest says absent")

    # sudo is declared per host because fixes that need it go to an operator, not to this tool.
    if host.get("sudo") and obs.get("sudo") and obs["sudo"] != host["sudo"]:
        drift("sudo", f"sudo is {obs['sudo']}, manifest says {host['sudo']}")
    token = policy.get("controller_token")
    got_token = obs["fleet_worker"].get("controller_token")
    if token and got_token and got_token != token:
        drift("worker", f"controller token {got_token}, want {token}", "provision secrets/controller.token (operator)")

    floor = policy.get("disk", {}).get("min_free_gib")
    data = obs["disk"].get("/System/Volumes/Data") or obs["disk"].get("/")
    if floor and data and data["free_gib"] < floor:
        drift("disk", f"{data['free_gib']} GiB free, floor {floor}", "glaeda-disk")

    ios = policy.get("ios_simulator")
    if ios:
        for message, fix in ios_simulator_drift(ios, obs):
            drift("ios", message, fix)

    for area, message, fix in catch_up_drift(host, policy, obs):
        drift(area, message, fix)

    # The declared toolchain: Xcode from the plain probe, the rest from a preflight section when observed.
    declared = policy.get("toolchain") or {}
    pinned = declared.get("xcode")
    if pinned and pinned["app"] not in {a["path"] for a in xcode.get("apps", [])}:
        got = apps.get(pinned["app"])
        if not got:
            drift("toolchain", f"Xcode {pinned['app']} ({pinned['version']} {pinned['build']}) missing",
                  "copy it from a host that has it")
        elif (got["version"], got["build"]) != (pinned["version"], pinned["build"]):
            drift("toolchain", f"{pinned['app']} is {got['version']} ({got['build']}), "
                  f"toolchain wants {pinned['version']} ({pinned['build']})")
    developer = f"{pinned['app']}/Contents/Developer" if pinned else None
    if pinned and pinned.get("select", True) and not xcode.get("select") and obs["xcode_select"] != developer:
        drift("toolchain", f"xcode-select {obs['xcode_select']!r}, toolchain wants {developer!r}",
              f"sudo xcode-select -s {pinned['app']}")
    if declared and obs.get("preflight"):
        result = preflight_host(manifest, name, obs)
        for check_id in TOOLCHAIN_CHECKS if host.get("node_id") else TOOLCHAIN_CHECKS[:4]:
            got_check = result["checks"].get(check_id)
            if got_check and got_check["state"] == "fail":
                drift("toolchain", f"{check_id}: {got_check['detail']}", got_check["fix"])
    return issues


def catch_up_role(host: dict[str, Any]) -> str | None:
    """CATCH_UP_WRITER, "reader" for a dev-build worker, or None for a host outside the catch-up path."""
    roles = host.get("roles") or []
    if CATCH_UP_WRITER in roles:
        return CATCH_UP_WRITER
    return "reader" if set(roles) & set(CATCH_UP_READER_ROLES) else None


def catch_up_drift(host: dict[str, Any], policy: dict[str, Any], obs: dict[str, Any]) -> list[tuple[str, str, str]]:
    """Drift for the fleet compile-cache catch-up roles, as (area, detail, fix). Reports only."""
    role = catch_up_role(host)
    if role is None:
        return []
    out: list[tuple[str, str, str]] = []
    keep = "never delete or re-clone it: the catch-up cache keys include this path"
    rollout = "operator: rerun scripts/glaeda-fleet-cas-rollout for this host"
    if role == CATCH_UP_WRITER:
        states = {j["label"]: j["state"] for j in obs["launchd"]}
        fill = states.get(CATCH_UP_FILL_LABEL)
        # A fill listed in launchd.running is already checked there.
        if CATCH_UP_FILL_LABEL not in policy.get("launchd", {}).get("running", []):
            if fill is None:
                out.append(("launchd", f"{CATCH_UP_FILL_LABEL} not installed",
                            "cmuxterm-hq build-fleet/catch-up/install-catch-up-fill.sh (operator, sudo)"))
            elif fill == "not-loaded":
                out.append(("launchd", f"{CATCH_UP_FILL_LABEL} is not-loaded", ""))
            elif (code := re.search(r"last_exit=(-?[0-9]+)\b", fill)) and code.group(1) != "0":
                out.append(("pending", f"{CATCH_UP_FILL_LABEL} last exited {code.group(1)}; loaded, runs on its timer",
                            "read its receipts (cmux-build-fleet logs/catch-up-fill.log)"))
        if obs["fleet_worker"].get("process") == "running":
            out.append(("catch-up", f"the dev-build worker ({FLEET_ROOT}/bin/worker) runs on the {CATCH_UP_WRITER}; "
                        "team-submitted builds would run next to the signing key",
                        f"drain it: exclude the host in fleet.json and make its {HQ_WORKER_LABEL} wrapper idle"))
    cas = obs.get("fleet_cas") or {}
    paths = cas.get("paths") or {}
    if not paths:
        out.append(("fleet-cas", f"no fleet-cas observation ({FLEET_ROOT} missing)", ""))
        return out
    wanted = {**FLEET_CAS_PATHS, **(FLEET_CAS_WRITER_PATHS if role == CATCH_UP_WRITER else {})}
    for rel, want in wanted.items():
        got = paths.get(rel, "missing")
        where = f"{FLEET_ROOT}/{rel}"
        if got == want:
            continue
        if got == "symlink":
            out.append(("fleet-cas", f"{where} is a symlink, want a real {want}",
                        f"operator: replace the link itself (never rm -r through it) with the real {want}; {keep}"))
        elif got == "missing" and rel in FLEET_CAS_BUILD_PATHS:
            # A fresh host or an install --reset: informational until the first catch-up build.
            out.append(("pending", f"{where} missing", "the next catch-up build creates it"))
        elif got == "missing":
            out.append(("fleet-cas", f"{where} missing", rollout))
        else:
            out.append(("fleet-cas", f"{where} is a {got}, want a {want}",
                        f"operator: inspect it{'; ' + keep if rel in FLEET_CAS_BUILD_PATHS else ''}"))
    want_mode = FLEET_CAS_NODE_MODES[role]
    mode = cas.get("node_mode") or "missing"
    if mode != want_mode:
        flag = "--read-only-kv" if want_mode == "read-only" else "--sign-key"
        got = {"missing": "no xcode/run/node.args", "unreadable": "xcode/run/node.args is unreadable",
               "signing": "the node signs (--sign-key)",
               "read-only": "the node is read-only (--read-only-kv)"}.get(mode, "the node has neither flag")
        out.append(("fleet-cas", f"{got}; a {role} node runs {flag}",
                    f"operator: scripts/glaeda-fleet-cas {'node' if role == 'reader' else 'writer'} via glaeda-fleet-cas-rollout"))
    if cas.get("node") != "answers":
        out.append(("fleet-cas", "fleet-cas node does not answer on xcode/fleet-cas.sock (the fleet-cas-settings.sh "
                    "check); builds fall back to the local cache", rollout))
    if role == "reader" and cas.get("catch_up") == "0":
        # On purpose: remote-hit catch-up measured 1631 s against 383 s, so the wrapper keeps it off until the
        # bulk `fleet-cas warm` lands (cmuxterm-hq makes catch-up opt-in by default). Informational, not drift.
        out.append(("disabled", f"catch-up disabled (CMUX_CI_CATCH_UP=0 in {FLEET_ROOT}/bin/worker)", ""))
    # Readers build in catch-up mode from it; the writer's fill runs the same recipe's fill path.
    release = "cmuxterm-hq build-fleet/recipe-release.py (operator)"
    if cas.get("recipe") in (None, "none"):
        out.append(("recipe", f"no released recipe at {FLEET_ROOT}/recipes", release))
    elif cas.get("build_mode") != "present":
        out.append(("recipe", f"released recipe {cas['recipe']} has no cmux-build-mode.py, so no catch-up mode",
                    release))
    return out


def version_tuple(value: str | None) -> tuple[int, ...]:
    """Three-part version, zero-padded, so 26.3 == 26.3.0 and 26 == 26.0."""
    try:
        parts = [int(p) for p in (value or "0").split(".")]
    except ValueError:
        parts = [0]
    return tuple((parts + [0, 0, 0])[:3])


def check(manifest: dict[str, Any], observed: dict[str, Any], hosts: list[str]) -> list[dict[str, str]]:
    issues: list[dict[str, str]] = []
    for name in hosts:
        obs = observed["hosts"].get(name)
        if obs is None:
            issues.append({"host": name, "area": "reach", "detail": "not observed", "fix": ""})
            continue
        issues.extend(check_host(manifest, name, obs))
    return issues


def load_labels_module() -> Any:
    """glaeda_fleet_labels.py, the label rule glaeda-cmux-runner also uses, so the two never drift."""
    path = SCRIPT_DIR / "glaeda_fleet_labels.py"
    loader = importlib.machinery.SourceFileLoader("glaeda_fleet_labels", os.fspath(path))
    spec = importlib.util.spec_from_loader("glaeda_fleet_labels", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


labels = load_labels_module()
# The reservation rule the runner hook also uses (glaeda_reservation.py), so the two never drift.
reservation_rules = _load("glaeda_reservation", SCRIPT_DIR / "glaeda_reservation.py")
pool_label = labels.pool_label


def pools(manifest: dict[str, Any], observed: dict[str, Any] | None, hosts: list[str]) -> dict[str, Any]:
    """Runner capacity per pool label, as the PR pool picker reads it.

    Declared and conforming come from glaeda_fleet_labels.declared_pools, the rule the runner
    uses. A member conforms when the latest observation shows that exact Xcode (path, version,
    build) as a real directory: the host meets the pool, so a runner installed or relabelled
    from this manifest would carry the label. It does not prove the registered runner carries it
    today; GitHub fixes labels at registration. Without an observation nothing conforms.

    A member with an active or invalid reservation (listed in `reserved`; the runner hook refuses
    both) does not conform, so the picker sees why the count dropped. `busy` lists members whose
    fleet host lock was held at observation time, as information only: they still conform, because
    a snapshot of a running job must not shrink capacity (the picker counts live jobs itself).
    """
    seen = (observed or {}).get("hosts", {})

    def xcode_ok(member: str, want: dict[str, Any]) -> bool:
        obs = seen.get(member) or {}
        if not obs.get("reachable"):
            return False
        got = {a["path"]: a for a in obs.get("xcode_apps", [])}.get(want.get("path"))
        return bool(got) and got["kind"] == "dir" and got["version"] == want.get("version") \
            and got["build"] == want.get("build")

    def reserved(member: str) -> bool:
        obs = seen.get(member) or {}
        return bool(obs.get("reachable")) and reservation_state(
            obs.get("reservation"), obs.get("observed_at") or time.time()) in ("active", "invalid")

    def busy(member: str) -> bool:
        obs = seen.get(member) or {}
        return bool(obs.get("reachable")) and obs.get("host_lock") == "held"

    wanted = set(hosts)
    declared = labels.declared_pools(manifest)
    conforming = labels.declared_pools(manifest, xcode_ok)
    out = {}
    for label, members in declared.items():
        mine = [m for m in members if m in wanted]
        if not mine:
            continue
        held = [m for m in mine if reserved(m)]
        running = [m for m in mine if busy(m)]
        ok = [m for m in conforming.get(label, []) if m in wanted and m not in held]
        out[label] = {"declared": mine, "conforming": ok, "reserved": held, "busy": running,
                      "declared_count": len(mine), "conforming_count": len(ok),
                      "reserved_count": len(held), "busy_count": len(running)}
    return out


def borrow_candidates(manifest: dict[str, Any], observed: dict[str, Any], hosts: list[str],
                      klass: str) -> tuple[list[dict[str, Any]], dict[str, str]]:
    """Eligible idle ordinary CI members, ranked deterministically.

    This is advisory selection only. The reservation CAS is the acquisition boundary, and a successful
    acquisition is freshly re-observed before it is returned to the caller.
    """
    if klass not in RUNNER_CLASSES:
        raise Failure(f"borrow class {klass!r} is not one of {', '.join(RUNNER_CLASSES)}")
    seen = observed.get("hosts") if isinstance(observed, dict) else None
    if not isinstance(seen, dict):
        raise Failure("borrow observation has no hosts object")
    never = {host_key(n) for n in manifest.get("never_touch", [])}
    candidates: list[dict[str, Any]] = []
    excluded: dict[str, str] = {}

    for name in hosts:
        host = manifest["hosts"][name]
        obs = seen.get(name)
        if host_key(name) in never or host_key(str(host.get("hostname") or "")) in never:
            excluded[name] = "never_touch"
            continue
        if host.get("class") != klass:
            excluded[name] = f"class {host.get('class') or 'unset'}"
            continue
        roles = host.get("roles") if isinstance(host.get("roles"), list) else []
        extra_roles = sorted(set(roles) - BORROW_SAFE_ROLES)
        if "ci-runner" not in roles:
            excluded[name] = "not an ordinary CI runner"
            continue
        if extra_roles:
            excluded[name] = "special roles: " + ", ".join(extra_roles)
            continue
        if host.get("availability") != "dedicated":
            excluded[name] = f"availability {host.get('availability') or 'unset'}"
            continue
        if not isinstance(obs, dict) or not obs.get("reachable"):
            excluded[name] = "unreachable"
            continue

        seen_at = obs.get("observed_at") or time.time()
        reservation = obs.get("reservation")
        reservation_status = reservation_state(reservation, seen_at)
        if reservation_status in ("active", "invalid"):
            excluded[name] = "reserved" if reservation_status == "active" else "invalid reservation"
            continue
        if obs.get("runner_worker") != "absent":
            excluded[name] = f"Runner.Worker {obs.get('runner_worker') or 'unknown'}"
            continue
        if obs.get("host_lock") != "free":
            excluded[name] = f"host lock {obs.get('host_lock') or 'unknown'}"
            continue

        expected_node = host.get("node_id")
        if expected_node and obs.get("enrolled_node_id") != expected_node:
            excluded[name] = "fleet enrollment does not match"
            continue
        shape = manifest["hardware"][host["hardware"]]
        mismatch = next((field for field in ("model", "chip", "memory_gib", "cpus")
                         if field in shape and obs.get(field) != shape[field]), None)
        if mismatch is not None:
            excluded[name] = f"hardware {mismatch} does not match"
            continue

        def xcode_ok(want: dict[str, Any]) -> bool:
            got = {a["path"]: a for a in obs.get("xcode_apps", [])}.get(want.get("path"))
            return bool(got) and got.get("kind") == "dir" and got.get("version") == want.get("version") \
                and got.get("build") == want.get("build")

        summary, why = labels.member_labels(manifest, name, xcode_ok)
        if summary is None:
            excluded[name] = why or "runner contract unavailable"
            continue
        if summary.get("trustedRef"):
            excluded[name] = "trusted-only runner"
            continue
        floor = summary.get("minFreeGib")
        disk = (obs.get("disk") or {}).get("/System/Volumes/Data") or (obs.get("disk") or {}).get("/")
        if floor is not None and (not isinstance(disk, dict) or disk.get("free_gib", 0) < floor):
            excluded[name] = f"disk below {floor:g} GiB floor"
            continue
        candidates.append({
            "host": name,
            "node_id": expected_node,
            "class": klass,
            "memory_gib": obs.get("memory_gib"),
            "cpus": obs.get("cpus"),
            "roles": roles,
            "observed_at": obs.get("observed_at"),
        })

    candidates.sort(key=lambda row: (-(row.get("memory_gib") or 0), -(row.get("cpus") or 0), row["host"]))
    return candidates, excluded


def borrow_owner(base: str) -> str:
    """A reservation owner unique to one borrow: the operator plus a random lease id.

    Parallel sessions on one laptop share $USER@host. Keyed by that, a second borrow would extend the
    first one's hold (reserve extends a hold of the same owner) and both would get the host; a release by
    either would drop the other's. With a lease id the second session sees another owner's active hold and
    is refused, the reservation CAS picks one winner, and only this lease's owner releases it.
    """
    base = check_owner(base)
    return check_owner(f"{base[:100 - 13]}+{secrets.token_hex(6)}")


def borrow_selection(excluded: dict[str, str]) -> dict[str, Any]:
    return {"policy": "idle ordinary CI member; memory, cpu, stable-host tie-break", "excluded": excluded}


def borrow_document(manifest: dict[str, Any], candidate: dict[str, Any], record: dict[str, Any],
                    state: str, excluded: dict[str, str]) -> dict[str, Any]:
    return {
        "schema": "glaeda-developer-lease/v1",
        "state": state,
        "host": candidate["host"],
        "node_id": candidate.get("node_id"),
        "class": candidate["class"],
        "memory_gib": candidate.get("memory_gib"),
        "cpus": candidate.get("cpus"),
        "owner": record["owner"],
        "purpose": record["purpose"],
        "since": record["since"],
        "until": record["until"],
        "reservation_schema": RESERVATION_SCHEMA,
        "connection": {"kind": "ssh", "host": candidate["host"], "user": manifest["ssh_user"]},
        # A dry run's lease id is not the one --yes will create.
        "release": (["glaeda-mini-fleet", "release", candidate["host"], "--owner", record["owner"], "--yes"]
                    if state == "reserved" else None),
        "selection": borrow_selection(excluded),
    }


def emit_unavailable(klass: str, excluded: dict[str, str], json_output: bool, text: str) -> None:
    if json_output:
        print(json.dumps({"schema": "glaeda-developer-lease/v1", "state": "unavailable", "class": klass,
                          "selection": borrow_selection(excluded)}, indent=2, sort_keys=True))
    else:
        print(text)


def emit_borrow(doc: dict[str, Any], json_output: bool) -> None:
    if json_output:
        print(json.dumps(doc, indent=2, sort_keys=True))
        return
    dry = "would reserve" if doc["state"] == "dry_run" else "reserved"
    memory = f", {doc['memory_gib']} GiB" if doc.get("memory_gib") else ""
    print(f"{doc['host']}: {dry} {doc['class']}{memory} until {utc(doc['until'])} "
          f"for {doc['purpose']} ({doc['owner']})")
    if doc["state"] == "dry_run":
        print("dry run; pass --yes to acquire")
    else:
        print("release: " + " ".join(shlex.quote(a) for a in doc["release"]))


def release_own(manifest: dict[str, Any], name: str, owner: str) -> tuple[int, str]:
    capture = io.StringIO()
    with contextlib.redirect_stdout(capture):
        code = cmd_release(manifest, [name], owner, False, True)
    return code, capture.getvalue().strip()


def cmd_borrow(manifest: dict[str, Any], hosts: list[str], observed: dict[str, Any], klass: str,
               purpose: str | None, hours: float | None, until: int | None, owner: str | None,
               yes: bool, json_output: bool) -> int:
    """Reserve one idle ordinary CI member for a developer, or say why none is free.

    The reservation stops new runner jobs from being admitted on the host, but a runner whose listener
    already accepted a job before its Runner.Worker started can still reach the hook, which then refuses
    that one job on the reservation (the pool picker re-runs it elsewhere), as with reserve today.
    """
    if not purpose or not purpose.strip():
        raise Failure("borrow needs --for TEXT saying what the host is reserved for")
    if len(purpose) > PURPOSE_MAX or not purpose.isprintable():
        raise Failure(f"--for must be printable text of at most {PURPOSE_MAX} characters")
    owner = borrow_owner(owner or default_owner())
    now = int(time.time())
    end = reservation_until(hours, until, now)
    candidates, excluded = borrow_candidates(manifest, observed, hosts, klass)
    if not candidates:
        emit_unavailable(klass, excluded, json_output, f"no idle eligible {klass} host; " + (
            "; ".join(f"{name}: {why}" for name, why in excluded.items()) or "no candidates"))
        return 1

    if not yes:
        candidate = candidates[0]
        record = {"owner": owner, "purpose": purpose, "since": now, "until": end}
        emit_borrow(borrow_document(manifest, candidate, record, "dry_run", excluded), json_output)
        return 0

    # Reserve first, then re-observe. The owner is unique to this borrow, so reserve only writes over an
    # absent or expired marker (never another borrow's hold) and its CAS picks one winner. The marker
    # prevents a new runner job after acquisition; the fresh Runner.Worker/host-lock check catches one
    # that started between selection and the CAS.
    user = manifest["ssh_user"]
    for candidate in candidates:
        name = candidate["host"]
        capture = io.StringIO()
        with contextlib.redirect_stdout(capture):
            code = cmd_reserve(manifest, [name], purpose, hours, until, owner, False, True)
        if code != 0:
            detail = capture.getvalue().strip() or f"reserve exit {code}"
            # reserve also fails after its write landed (the read-back or ssh failed): drop our own hold.
            # Unless reserve could not even read the marker, in which case it wrote nothing.
            wrote = not detail.startswith(f"{name}: cannot read reservation")
            after = read_reservation(name, user) if wrote else {"state": "absent"}
            if after["state"] == "error" or ((after.get("reservation") or {}).get("owner") == owner
                                             and release_own(manifest, name, owner)[0] != 0):
                raise Failure(f"{name}: reserve failed ({detail}) and this borrow's hold may remain; "
                              f"release it with: glaeda-mini-fleet release {name} --owner {owner} --yes")
            excluded[name] = f"not reserved: {detail}"
            continue
        fresh = observe(manifest, [name])["hosts"][name]
        if not fresh.get("reachable"):
            raise Failure(f"{name} was reserved but could not be re-observed; the reservation was left in place. "
                          f"Release it with: glaeda-mini-fleet release {name} --owner {owner} --yes")
        held = fresh.get("reservation")
        held_state = reservation_state(held, fresh.get("observed_at") or time.time())
        safe = (held_state == "active" and held and held.get("owner") == owner
                and fresh.get("runner_worker") == "absent" and fresh.get("host_lock") == "free")
        if safe:
            record = {k: held[k] for k in ("owner", "purpose", "since", "until")}
            emit_borrow(borrow_document(manifest, candidate, record, "reserved", excluded), json_output)
            return 0

        released, detail = release_own(manifest, name, owner)
        if released != 0:
            raise Failure(f"{name} was reserved but became busy and could not be released: {detail or 'release failed'}")
        excluded[name] = (
            f"became busy after reservation (Runner.Worker {fresh.get('runner_worker') or 'unknown'}, "
            f"host lock {fresh.get('host_lock') or 'unknown'})"
        )

    emit_unavailable(klass, excluded, json_output, f"no idle eligible {klass} host survived reservation acquisition")
    return 1


# ---------------------------------------------------------------- apply

ADD_KEY = r"""set -eu
ak="$HOME/.ssh/authorized_keys"
line=$(cat)
have=$(ssh-keygen -lf "$ak" 2>/dev/null | awk '{print $2}' | grep -cxF "$1" || true)
if [ "$have" != 0 ]; then echo "unchanged: key $1 already present"; exit 0; fi
got=$(printf '%s\n' "$line" | ssh-keygen -lf /dev/stdin | awk '{print $2}')
[ "$got" = "$1" ] || { echo "refused: supplied key is $got, want $1" >&2; exit 3; }
# Backups live outside ~/.ssh so they are never read as keys or reported as stray copies.
state="$HOME/.local/state/glaeda/mini-fleet"
mkdir -p "$state" && chmod 700 "$state"
if [ -e "$ak" ]; then
  backup="$state/authorized_keys.$(date -u +%Y%m%dT%H%M%SZ).$$"
  cp -p "$ak" "$backup"
else
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  : > "$ak"
  backup="none (file was absent)"
fi
[ ! -s "$ak" ] || [ -z "$(tail -c1 "$ak")" ] || printf '\n' >> "$ak"
printf '%s\n' "$line" >> "$ak"
chmod 600 "$ak"
echo "added: key $1 (backup $backup)"
"""

CLONE_XCODE = r"""set -eu
src="$1"; dst="$2"; want="$3|$4"
if [ -e "$dst" ] || [ -L "$dst" ]; then echo "unchanged: $dst exists"; exit 0; fi
[ -d "$src" ] && [ ! -L "$src" ] || { echo "refused: $src is not a real directory" >&2; exit 3; }
v=$(plutil -extract CFBundleShortVersionString raw "$src/Contents/Info.plist")
b=$(plutil -extract ProductBuildVersion raw "$src/Contents/version.plist")
[ "$v|$b" = "$want" ] || { echo "refused: $src is $v|$b, want $want" >&2; exit 3; }
[ "$(stat -f %Sd "$(dirname "$dst")")" = "$(stat -f %Sd "$src")" ] || { echo "refused: not one volume" >&2; exit 3; }
tmp="$dst.glaeda-partial"
[ ! -e "$tmp" ] || { echo "refused: $tmp exists from an earlier run; inspect it" >&2; exit 3; }
cp -c -R "$src" "$tmp"
mv -n "$tmp" "$dst"
if [ -e "$tmp" ] || [ -e "$dst/$(basename "$tmp")" ]; then
  echo "refused: $dst appeared during the clone; the partial copy was left for inspection" >&2; exit 3
fi
echo "cloned: $src -> $dst ($v $b)"
"""


def remote(name: str, user: str, script: str, args: list[str], stdin: str = "") -> tuple[int, str]:
    import shlex
    command = "/bin/bash -c " + shlex.quote(script) + " glaeda " + " ".join(shlex.quote(a) for a in args)
    try:
        proc = subprocess.run([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-l", user, name, command],
                              input=stdin.encode(), capture_output=True, timeout=600)
    except subprocess.TimeoutExpired:
        return 124, "timed out after 600s; outcome unknown, re-run check"
    text = (proc.stdout + proc.stderr).decode(errors="replace").strip()
    return proc.returncode, text[-400:]


def apply(manifest: dict[str, Any], hosts: list[str], yes: bool) -> int:
    observed = observe(manifest, hosts)
    failed = 0
    skipped = set()
    for name in hosts:
        if manifest["hosts"][name].get("overrides", {}).get("apply") is False:
            print(f"{name}: skipped (apply: false)")
            skipped.add(name)
            continue
        before = check(manifest, observed, [name])
        if any(i["area"] == "reach" for i in before):
            print(f"{name}: unreachable before apply: {before[0]['detail']}")
            failed += 1
            continue
        actions = [i["action"] for i in before if i.get("action")]
        if not actions:
            print(f"{name}: nothing to apply")
            continue
        for action in actions:
            if action["kind"] == "add_key":
                key = manifest["keys"][action["key"]]
                if not key.get("public_key"):
                    print(f"{name}: cannot add {action['key']}: manifest has no public_key")
                    failed += 1
                    continue
                label, script, args, stdin = f"add key {action['key']}", ADD_KEY, [key["fingerprint"]], key_line(key) + "\n"
            else:
                label, script = f"clone {action['source']} -> {action['path']}", CLONE_XCODE
                args, stdin = [action["source"], action["path"], action["version"], action["build"]], ""
            if not yes:
                print(f"{name}: would {label}")
                continue
            code, text = remote(name, manifest["ssh_user"], script, args, stdin)
            print(f"{name}: {text or label}")
            failed += code != 0
    if not yes:
        print("dry run; pass --yes to apply")
        return 1 if failed else 0
    touched = [h for h in hosts if h not in skipped]
    after = check(manifest, observe(manifest, touched), touched)
    left = [i for i in after if i.get("action") or i["area"] == "reach"]
    for i in left:
        print(f"still drifting: {i['host']}: {i['detail']}")
    return 1 if failed or left else 0


# ---------------------------------------------------------------- reservations

# Each script takes the fleet root as $1. The read writes nothing; the operator side hashes the
# bytes it got. Writes and removals are compare-and-swap on that digest ($2, or "absent"), so a
# marker that changed after it was read is never overwritten or removed.
READ_LIMIT = 65536  # a bigger marker is never bound to a digest, so it is left for a person
READ_RESERVATION = r"""set -eu
R="$1/reservation.json"
if [ -L "$R" ]; then echo symlink; exit 0; fi
if [ ! -e "$R" ]; then echo absent; exit 0; fi
if [ ! -f "$R" ]; then echo notfile; exit 0; fi
echo present
head -c 65537 "$R"
"""

# Writers serialize on $F/.reservation.lock: the fd stays open in bash, perl only takes the flock
# on it (waiting at most 20 s), so the check and the mv or rm cannot interleave with another writer.
RESERVATION_LOCK = r"""[ -d "$F" ] && [ ! -L "$F" ] || { echo "refused: $F is not a directory" >&2; exit 3; }
[ -w "$F" ] || { echo "refused: $F is not writable by $(id -un)" >&2; exit 3; }
[ ! -L "$F/.reservation.lock" ] || { echo "refused: $F/.reservation.lock is a symlink" >&2; exit 3; }
exec 9>>"$F/.reservation.lock"
chmod 664 "$F/.reservation.lock" 2>/dev/null || true
/usr/bin/perl -MFcntl=:flock -e 'open(my $l, ">>&=", 9) or die "lock: $!\n";
  local $SIG{ALRM} = sub { die "another reserve or release is still running on this host\n" };
  alarm 20; flock($l, LOCK_EX) or die "lock: $!\n"' </dev/null || exit 3
"""

RESERVATION_CAS = r"""current() {
  if [ -L "$R" ]; then echo symlink
  elif [ ! -e "$R" ]; then echo absent
  elif [ ! -f "$R" ]; then echo notfile
  else shasum -a 256 < "$R" | awk '{print $1}'; fi
}
"""

WRITE_RESERVATION = r"""set -eu
F="$1"; R="$F/reservation.json"; want="$2"
""" + RESERVATION_LOCK + RESERVATION_CAS + r"""case "$(current)" in symlink|notfile) echo "refused: $R is not a regular file; inspect it" >&2; exit 3;; esac
t=$(mktemp "$F/.reservation.json.XXXXXX")
trap 'rm -f "$t"' EXIT
cat > "$t"
chmod 664 "$t"
[ "$(current)" = "$want" ] || { echo "refused: $R changed since it was read; re-run" >&2; exit 3; }
mv -f "$t" "$R"
trap - EXIT
echo "reserved"
"""

REMOVE_RESERVATION = r"""set -eu
F="$1"; R="$F/reservation.json"; want="$2"
""" + RESERVATION_CAS + r"""[ -e "$R" ] || [ -L "$R" ] || { echo "released (already absent)"; exit 0; }
""" + RESERVATION_LOCK + r"""got=$(current)
[ "$got" != absent ] || { echo "released (already absent)"; exit 0; }
[ "$got" = "$want" ] || { echo "refused: $R changed since it was read; re-run" >&2; exit 3; }
rm -f "$R"
echo "released"
"""


def reservation_ssh(name: str, user: str, script: str, args: list[str], stdin: str = "") -> tuple[int, bytes, str]:
    """Run one reservation script on a host: (exit code, raw stdout, stderr). Bounded and batch-mode."""
    command = "/bin/bash -c " + shlex.quote(script) + " glaeda " + " ".join(shlex.quote(a) for a in args)
    try:
        proc = subprocess.run([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-l", user, name, command],
                              input=stdin.encode(), capture_output=True, timeout=60)
    except subprocess.TimeoutExpired:
        return 124, b"", "timed out after 60s; outcome unknown, re-run check"
    return proc.returncode, proc.stdout, proc.stderr.decode(errors="replace").strip()[-400:]


def read_reservation(name: str, user: str) -> dict[str, Any]:
    """{"state": absent|invalid|active|expired|error, "token": CAS token, "reservation": parsed or None}."""
    code, out, err = reservation_ssh(name, user, READ_RESERVATION, [FLEET_ROOT])
    if code != 0:
        return {"state": "error", "error": (err.splitlines() or [f"ssh exit {code}"])[-1][:200]}
    head, _, body = out.partition(b"\n")
    if head == b"absent":
        return {"state": "absent", "token": "absent", "reservation": None}
    if head in (b"symlink", b"notfile"):
        return {"state": "invalid", "token": None, "reservation": None, "detail": f"marker is a {head.decode()}"}
    if head != b"present":
        return {"state": "error", "error": f"unexpected reply {printable(head.decode(errors='replace'))[:80]!r}"}
    if len(body) > READ_LIMIT:
        return {"state": "invalid", "token": None, "reservation": None, "detail": f"marker is over {READ_LIMIT} bytes"}
    token = hashlib.sha256(body).hexdigest()
    reservation = marker_from_bytes(body)
    if not reservation["valid"]:
        return {"state": "invalid", "token": token, "reservation": None,
                "detail": f"marker is not a valid {RESERVATION_SCHEMA} object ({reservation['why']})"}
    return {"state": reservation_state(reservation, time.time()), "token": token, "reservation": reservation}


def default_owner() -> str:
    """The operator: local $USER@$(hostname -s)."""
    return f"{os.environ.get('USER') or getpass.getuser()}@{socket.gethostname().split('.')[0]}"


def reservation_until(hours: float | None, until: int | None, now: int) -> int:
    if (hours is None) == (until is None):
        raise Failure("reserve needs exactly one of --hours N or --until EPOCH")
    if hours is not None and not math.isfinite(hours):
        raise Failure("--hours must be a finite number")
    end = now + round(hours * 3600) if hours is not None else until
    if end <= now:
        raise Failure(f"reservation must end in the future (until {end}, now {now})")
    if end - now > RESERVATION_MAX_HOURS * 3600:
        raise Failure(f"reservations last at most {RESERVATION_MAX_HOURS} h; extend one before it ends instead")
    return end


def check_owner(owner: str) -> str:
    if not OWNER_RE.fullmatch(owner):
        raise Failure(f"owner {owner!r} must be letters, digits and . _ @ + - (at most 100), such as leo@air-blue")
    return owner


def cmd_reserve(manifest: dict[str, Any], hosts: list[str], purpose: str | None, hours: float | None,
                until: int | None, owner: str | None, force: bool, yes: bool) -> int:
    if not purpose or not purpose.strip():
        raise Failure("reserve needs --for TEXT saying what the host is reserved for")
    if len(purpose) > PURPOSE_MAX or not purpose.isprintable():
        raise Failure(f"--for must be printable text of at most {PURPOSE_MAX} characters")
    owner = check_owner(owner or default_owner())
    now = int(time.time())
    end = reservation_until(hours, until, now)
    user = manifest["ssh_user"]
    failed = 0
    for name in hosts:
        current = read_reservation(name, user)
        state, held = current["state"], current.get("reservation")
        since = now
        if state == "error":
            print(f"{name}: cannot read reservation: {current['error']}")
            failed += 1
            continue
        if state == "invalid":
            if not force or current["token"] is None:
                why = "inspect it, then pass --force to replace it" if current["token"] else "fix it by hand; --force cannot"
                print(f"{name}: refused: {current['detail']}; {why}")
                failed += 1
                continue
        elif state == "active" and held["owner"] == owner:
            since = held["since"]
        elif state == "active" and not force:
            print(f"{name}: refused: reserved by {describe_reservation(held)}; pass --force to take it over")
            failed += 1
            continue
        record = {"schema": RESERVATION_SCHEMA, "owner": owner, "purpose": purpose, "since": since, "until": end}
        text = json.dumps(record) + "\n"
        verb = {"absent": "reserve", "expired": "replace expired", "invalid": "replace invalid"}.get(state) or \
            ("extend" if held["owner"] == owner else f"take over from {printable(held['owner'])}")
        if not yes:
            print(f"{name}: would {verb}: {FLEET_ROOT}/{RESERVATION_FILE} = {text.strip()}")
            continue
        code, out, err = reservation_ssh(name, user, WRITE_RESERVATION, [FLEET_ROOT, current["token"]], text)
        if code != 0:
            print(f"{name}: {err or f'ssh exit {code}'}")
            failed += 1
            continue
        after = read_reservation(name, user)
        if after.get("reservation") != {"valid": True, **{k: record[k] for k in ("owner", "purpose", "since", "until")}}:
            print(f"{name}: wrote the marker but a fresh read shows {after['state']}; re-run check")
            failed += 1
            continue
        print(f"{name}: done ({verb}): reserved by {describe_reservation(after['reservation'])}")
    if not yes:
        print("dry run; pass --yes to write")
    return 1 if failed else 0


def cmd_release(manifest: dict[str, Any], hosts: list[str], owner: str | None, force: bool, yes: bool) -> int:
    owner = check_owner(owner or default_owner())
    user = manifest["ssh_user"]
    failed = 0
    for name in hosts:
        current = read_reservation(name, user)
        state, held = current["state"], current.get("reservation")
        if state == "error":
            print(f"{name}: cannot read reservation: {current['error']}")
            failed += 1
            continue
        if state == "absent":
            print(f"{name}: not reserved")
            continue
        if state == "invalid" and (not force or current["token"] is None):
            why = "inspect it, then pass --force to remove it" if current["token"] else "fix it by hand; --force cannot"
            print(f"{name}: refused: {current['detail']}; {why}")
            failed += 1
            continue
        if state == "active" and held["owner"] != owner and not force:
            print(f"{name}: refused: reserved by {describe_reservation(held)}, not {owner}; pass --force to release it")
            failed += 1
            continue
        what = "invalid marker" if state == "invalid" else f"{state} reservation by {describe_reservation(held)}"
        if not yes:
            print(f"{name}: would release {what}")
            continue
        code, out, err = reservation_ssh(name, user, REMOVE_RESERVATION, [FLEET_ROOT, current["token"]])
        if code != 0:
            print(f"{name}: {err or f'ssh exit {code}'}")
            failed += 1
            continue
        after = read_reservation(name, user)
        if after["state"] != "absent":
            print(f"{name}: removed the marker but a fresh read shows {after['state']}; re-run check")
            failed += 1
            continue
        print(f"{name}: released {what}")
    if not yes:
        print("dry run; pass --yes to release")
    return 1 if failed else 0


# ---------------------------------------------------------------- preflight

DEFAULT_CMUX_ROOT = "~/cmux"  # where fix clones cmux on a mini
# Columns of the preflight table, in the order onboarding meets them.
PREFLIGHT_CHECKS = ("os", "xcode", "select", "licence", "launch", "metal", "rust", "zig", "tools", "python", "python3",
                    "gh", "cmux", "setup", "glaeda", "power", "disk", "update", "autoupdate", "candidate", "node", "enroll", "runner",
                    "brew", "pins", "secrets")
# An unknown here means the bootstrap would refuse or cannot be predicted, so it blocks like a failure.
UNKNOWN_BLOCKS = frozenset({"xcode", "select", "licence", "launch", "metal", "zig", "power", "disk"})
# Who can apply a fix: the SSH login user alone, the login user with an admin password, or a person.
FIX_GROUPS = ("self", "password", "person")
# Preflight checks `check` reports as toolchain drift; the checkout ones only on hosts with a node id.
TOOLCHAIN_CHECKS = ("metal", "rust", "zig", "python", "cmux", "setup")
GROUP_TITLES = {"self": "can do itself (no root)", "password": "needs a password", "person": "needs a person"}


def xcode_pin(manifest: dict[str, Any], name: str) -> str | None:
    """The Xcode app builds must use: the declared toolchain's, else the manifest's selection, else its first app."""
    declared = toolchain(manifest, name).get("xcode")
    if declared:
        return declared["app"]
    xcode = host_policy(manifest, name).get("xcode", {})
    if xcode.get("select"):
        return xcode["select"].removesuffix("/Contents/Developer")
    apps = xcode.get("apps") or []
    return apps[0]["path"] if apps else None


def preflight_script(manifest: dict[str, Any], name: str) -> bytes:
    import shlex
    home = "~/.local/bin/"
    pythons = [*enroll.PYTHON_CANDIDATES, *(home + n for n in enroll.USER_PYTHONS)]
    inputs = {
        "CMUX_ROOT": cmux_checkout(manifest, name)["root"],
        "XCODE_PIN": xcode_pin(manifest, name) or "",
        "WORKLOAD_PATH": bootstrap.CMUX_WORKLOAD_TOOL_PATH,
        "WORKLOAD_TOOLS": " ".join(bootstrap.MACOS_WORKLOAD_TOOLS),
        "PYTHONS": " ".join(pythons),
        "CANDIDATE_PIN": operator_candidate_source(),
        "ENROLL_FLAGS": " ".join(ENROLL_FLAGS),
        "PIN_FORMULAS": " ".join(BREW_FORMULAS),
    }
    header = "".join(f"{k}={shlex.quote(v)}\n" for k, v in inputs.items())
    return PROBE.read_bytes() + b"\n" + header.encode() + PREFLIGHT_PROBE.read_bytes()


def operator_cmux_root() -> Path:
    return Path(os.environ.get("GLAEDA_CMUX_ROOT", "~/Projects/cmux")).expanduser()


def operator_zig_minimum() -> str | None:
    """Ghostty's minimum Zig from the operator's own cmux checkout, for a host without submodules."""
    try:
        return bootstrap.minimum_zig_version((operator_cmux_root() / "ghostty/build.zig.zon").read_text())
    except OSError:
        return None


def operator_candidate_source() -> str:
    """The pinned candidate's source commit, which the probe looks for on the host, or empty."""
    return operator_candidate().get("source", "")


def preflight_host(manifest: dict[str, Any], name: str, obs: dict[str, Any],
                   zig_fallback: str | None = None) -> dict[str, Any]:
    """Every check for one host: {id: {state, detail, fix, group[, action]}}, state ok|fail|todo|unknown|info.

    fail blocks onboarding; todo is a step onboarding itself performs (stage, enroll, register).
    action, when present, is what fix (group self) or sudo-plan (group password) runs for it."""
    checks: dict[str, dict[str, Any]] = {}

    def put(check: str, state: str, detail: str = "", fix: str = "", group: str = "",
            action: dict[str, Any] | None = None) -> None:
        checks[check] = {"state": state, "detail": detail, "fix": fix, "group": group}
        if action:
            checks[check]["action"] = action

    if not obs.get("reachable"):
        put("reach", "fail", obs.get("error", "unreachable"), "check the host is up and the SSH key is loaded", "person")
        return {"host": name, "ready": False, "checks": checks}
    pf = obs.get("preflight")
    if pf is None:
        put("reach", "fail", "observation has no preflight section", "rerun glaeda-mini-fleet preflight", "self")
        return {"host": name, "ready": False, "checks": checks}
    host = manifest["hosts"][name]
    policy = host_policy(manifest, name)
    declared = toolchain(manifest, name)
    user = obs.get("user") or manifest["ssh_user"]
    owner = pf.get("brew_owner")
    # Without Homebrew, fix fetches it into an /opt/homebrew the login user owns (sudo-plan creates that
    # directory when it is missing), and the login user then installs formulas without root.
    as_owner = f"once fix puts Homebrew in /opt/homebrew for {user}: " if owner is None else \
        ("" if owner == user else f"sudo -u {owner} ")
    brew_group = "self" if owner in (None, user) else "password"
    checkout = cmux_checkout(manifest, name)
    root = checkout["root"]

    def brew(formula: str) -> dict[str, Any]:
        return {"kind": "brew", "formula": formula, "owner": owner or user,
                **({"default": declared.get("rustup_default") or "stable"} if formula == "rustup" else {})}

    # The bootstrap's supportedOs and hardwareCapability (cmux-mac-build-large).
    major = int(re.match(r"\d*", obs.get("macos") or "").group() or 0)
    if major not in {15, 26}:
        put("os", "fail", f"macOS {obs.get('macos')}; the fleet bootstrap accepts 15 or 26", "install macOS 26", "person")
    elif not bootstrap.hardware_class_ready("macos", "cmux-mac-build-large", obs.get("cpus", 0), obs.get("memory_gib", 0)):
        put("os", "fail", f"{obs.get('cpus')} CPUs, {obs.get('memory_gib')} GiB; cmux-mac-build-large needs 8 and 16",
            "use a larger Mac", "person")
    else:
        put("os", "ok", f"macOS {obs.get('macos')}, {obs.get('cpus')} CPUs, {obs.get('memory_gib')} GiB")

    # Xcode: the pinned app, selected, licensed, first launch done, plugins loading.
    pin = xcode_pin(manifest, name)
    apps = {a["path"]: a for a in obs.get("xcode_apps", [])}
    listed = next((a for a in policy.get("xcode", {}).get("apps", []) if a["path"] == pin), None)
    pinned = declared.get("xcode") or {}
    want = {**(listed or {}), "path": pin, "version": pinned["version"], "build": pinned["build"]} if pinned else listed
    got = apps.get(pin) if pin else None
    if not pin:
        put("xcode", "unknown", "the manifest declares no Xcode (toolchain.xcode, xcode.apps or xcode.select)",
            "declare the pinned Xcode in the manifest", "person")
    elif not got:
        if want and want.get("clone_from"):
            put("xcode", "fail", f"{pin} missing", f"APFS clone of {want['clone_from']} (glaeda-mini-fleet fix)", "self",
                {"kind": "xcode_clone", "path": pin, "source": want["clone_from"],
                 "version": want["version"], "build": want["build"]})
        elif want and want.get("version") and SAFE_PATH_RE.fullmatch(pin):
            put("xcode", "fail", f"{pin} missing",
                f"LAN copy from a host that has it: glaeda-mini-fleet share xcode --from <host> {name} --yes "
                "(or fix --from <host>)", "self",
                {"kind": "xcode_share", "path": pin, "version": want["version"], "build": want["build"]})
        else:
            put("xcode", "fail", f"{pin} missing",
                (want or {}).get("fix") or f"install {pin} (LAN copy from a host that has it)", "person")
    elif got["kind"] != "dir":
        put("xcode", "fail", f"{pin} is a {got['kind']}; symlinked Xcode paths break cache replay",
            f"replace the symlink with a real copy of {pin}", "person")
    elif want and (got["version"], got["build"]) != (want["version"], want["build"]):
        put("xcode", "fail", f"{pin} is {got['version']} ({got['build']}), want {want['version']} ({want['build']})",
            f"install Xcode {want['version']} ({want['build']}) at {pin}", "person")
    elif pf.get("cmux") and not bootstrap.xcode_pin_ready(pf.get("cmux_pin") or "", got["version"], got["version"]):
        put("xcode", "fail", f"{pin} is {got['version']}; cmux .xcode-version says {pf.get('cmux_pin') or 'nothing'} "
            f"and the fleet is reviewed on Xcode {bootstrap.REVIEWED_XCODE_MAJOR}",
            "pin an Xcode of the reviewed major in the manifest", "person")
    else:
        put("xcode", "ok", f"{got['version']} ({got['build']})")
    developer = f"{pin}/Contents/Developer" if pin else None
    if developer and pinned.get("select") is False:
        put("select", "info", f"not required by the manifest; selected: {obs.get('xcode_select') or 'nothing'}")
    elif developer and obs.get("xcode_select") != developer:
        put("select", "fail", f"xcode-select is {obs.get('xcode_select') or 'unset'}", f"sudo xcode-select -s {pin}",
            "password", {"kind": "select", "app": pin})
    elif developer:
        put("select", "ok", developer)
    ready = obs.get("xcode_ready", {}).get(pin) if got else None
    if ready is None:
        put("licence", "unknown", "no runnable xcodebuild in the pinned Xcode")
        put("launch", "unknown", "no runnable xcodebuild in the pinned Xcode")
    else:
        if ready["licence"] == "accepted":
            put("licence", "ok")
        else:
            put("licence", "fail", "licence not accepted", f"sudo env DEVELOPER_DIR={developer} xcodebuild -license accept",
                "password", {"kind": "licence", "developer": developer})
        sdks = pf.get("sdks") or {}
        first_launch = {"kind": "first_launch", "developer": developer}
        if ready["first_launch"] != "done" or sdks.get("state") == "plugin_error":
            why = "xcodebuild -checkFirstLaunchStatus says first launch is needed" if ready["first_launch"] != "done" \
                else f"plugins fail to load: {sdks.get('detail')}"
            put("launch", "fail", why, f"sudo env DEVELOPER_DIR={developer} xcodebuild -runFirstLaunch", "password",
                first_launch)
        elif sdks.get("state") == "fail":
            put("launch", "fail", f"xcodebuild -showsdks failed: {sdks.get('detail')}",
                f"sudo env DEVELOPER_DIR={developer} xcodebuild -runFirstLaunch", "password", first_launch)
        else:
            put("launch", "ok")
    metal = pf.get("metal")
    if declared.get("metal") is False:
        put("metal", "info", "not required by the manifest")
    elif metal is None:
        put("metal", "unknown", "no pinned Xcode to ask")
    elif not metal["ok"] and checks.get("licence", {}).get("state") != "ok":
        put("metal", "unknown", "xcrun cannot run until the licence is accepted")
    elif metal["ok"]:
        put("metal", "ok", metal["detail"])
    else:
        put("metal", "fail", f"xcrun metal --version: {metal['detail']}",
            f"DEVELOPER_DIR={developer} xcodebuild -downloadComponent MetalToolchain", "self",
            {"kind": "metal", "developer": developer})

    # Build tools on the workload's fixed PATH, with versions.
    tools = pf.get("tools", {})
    missing_rust = [t for t in ("rustup", "cargo", "rustc") if not (tools.get(t) or {}).get("path")]
    broken_rust = [t for t in ("rustup", "cargo", "rustc") if t not in missing_rust
                   and not (tools[t]["version"] or "").startswith(f"{t} ")]
    channel = pf.get("rust_channel")
    default_wanted = declared.get("rustup_default")
    default_got = pf.get("rust_default")
    if missing_rust:
        put("rust", "fail", f"not on the workload PATH: {', '.join(missing_rust)}",
            f"{as_owner}brew install rustup; link its cargo, rustc and rustup proxies into /opt/homebrew/bin", brew_group,
            brew("rustup"))
    elif default_wanted and default_got is not None and default_got != default_wanted and \
            not default_got.startswith((f"{default_wanted}-", f"{default_wanted} ")):
        put("rust", "fail", f"rustup default is {default_got or 'unset'}, the manifest wants {default_wanted}",
            f"rustup default {default_wanted}", "self", {"kind": "rust_default", "toolchain": default_wanted})
    elif broken_rust:
        detail = "; ".join(f"{t}: {tools[t]['version']}" for t in broken_rust)
        toolchain_name = default_wanted or "stable"
        put("rust", "fail", detail, f"rustup default {toolchain_name} (as the login user)", "self",
            {"kind": "rust_default", "toolchain": toolchain_name})
    elif channel and not (channel["rustc"].startswith("rustc ") and channel["cargo"].startswith("cargo ")):
        broken = channel["rustc"] if not channel["rustc"].startswith("rustc ") else channel["cargo"]
        put("rust", "fail", f"DiffSidecar toolchain {channel['channel']}: {broken or 'unavailable'}",
            f"rustup toolchain install {channel['channel']}", "self",
            {"kind": "rust_channel", "root": root, "channel": channel["channel"]})
    else:
        put("rust", "ok", (tools.get("rustc") or {}).get("version", ""))
    zig = tools.get("zig") or {}
    minimums = [v for v in (pf.get("zig_min"), declared.get("zig_min")) if v]
    required = max(minimums, key=version_tuple) if minimums else zig_fallback
    if not zig.get("path"):
        put("zig", "fail", "not on the workload PATH", f"{as_owner}brew install zig", brew_group, brew("zig"))
    elif required is None:
        put("zig", "unknown", f"{zig['version']} at {zig['path']}; Ghostty's minimum is unknown (no ghostty/build.zig.zon)")
    elif not bootstrap.zig_version_compatible(zig["version"], required):
        put("zig", "fail", f"{zig['version']} at {zig['path']}, Ghostty needs {required}",
            f"{as_owner}brew install zig (or brew upgrade zig); /opt/homebrew/bin comes first on the workload PATH",
            brew_group, brew("zig"))
    else:
        put("zig", "ok", f"{zig['version']} (needs {required})")
    absent = [t for t in ("git", "xcodebuild", "xcrun") if not (tools.get(t) or {}).get("path")]
    if absent:
        put("tools", "fail", f"not on the workload PATH: {', '.join(absent)}", bootstrap.TOOL_FIXES[absent[0]], "person")
    else:
        git = re.sub(r"^git version (\S+).*", r"git \1", tools["git"]["version"] or "git ?")
        put("tools", "ok", f"{git}, {tools['xcodebuild']['version'] or 'xcodebuild ?'} selected")
    python = pf.get("python") or {}
    python_min = declared.get("python_min") or ENROLL_PYTHON_MIN
    if python.get("path") and version_tuple(python["version"]) >= version_tuple(python_min):
        put("python", "ok", f"{python['version']} at {python['path']}")
    else:
        if python.get("path"):
            seen = f" (enroll would use {python['version']} at {python['path']})"
        else:
            seen = f" (best found: {python['version']})" if python.get("version") else ""
        fix = "brew install python@3.13" if owner == user else "put a relocatable CPython 3.13+ at ~/.local/bin/python3"
        put("python", "fail", f"no Python {python_min}+ where glaeda-mini-enroll looks{seen}", fix, "self",
            {"kind": "python", "min": python_min})
    # python3 as the workload PATH resolves it: the bootstrap's profileRunnerInterpreter needs os.waitid (3.13+).
    python3 = pf.get("python3")
    formula, versioned = BREW_PYTHON
    if python3 is None:
        put("python3", "unknown", "the probe predates this check; rerun preflight")
    elif python3["path"] and version_tuple(python3["version"]) >= version_tuple(ENROLL_PYTHON_MIN):
        put("python3", "ok", f"{python3['version']} at {python3['path']}")
    else:
        seen = f"{python3['version'] or '?'} at {python3['path']}" if python3["path"] else "none"
        detail = f"python3 on the workload PATH is {seen}; the bootstrap needs {ENROLL_PYTHON_MIN}+"
        if python3["path"] == "/opt/homebrew/bin/python3":
            put("python3", "fail", detail, f"point /opt/homebrew/bin/python3 at {versioned} (brew install {formula})",
                "person")
        elif pf.get("brew_python3") and owner:
            put("python3", "fail", detail, f"{as_owner}ln -s {versioned} /opt/homebrew/bin/python3", brew_group,
                {"kind": "python_link", "owner": owner})
        else:
            put("python3", "fail", detail,
                f"{as_owner}brew install {formula}; link /opt/homebrew/bin/python3 to {versioned}", brew_group,
                brew(formula))
    # cmux CI jobs call gh (with GH_TOKEN) and fail with FileNotFoundError when the workload PATH has none.
    gh = pf.get("gh")
    if gh is None:
        put("gh", "unknown", "the probe predates this check; rerun preflight")
    elif gh:
        put("gh", "ok", gh)
    else:
        put("gh", "fail", "not on the workload PATH; cmux CI jobs call gh", f"{as_owner}brew install gh", brew_group,
            brew("gh"))

    # The checkout acceptance builds.
    depth = f" --depth {checkout['depth']}" if checkout["depth"] else ""
    clone = (f"git clone --depth 1 --branch {checkout['ref']} https://github.com/{checkout['repo']}.git {root} "
             f"&& git -C {root} submodule update --init --recursive{depth}")
    setup = {"kind": "setup", "root": root, "developer": developer}
    if not pf.get("cmux"):
        put("cmux", "fail", f"no checkout at {root}", clone, "self",
            {"kind": "cmux_clone", "repo": checkout["repo"], "ref": checkout["ref"], "root": root, "depth": checkout["depth"]})
        put("setup", "fail", "no checkout", f"after the clone: cd {root} && ./scripts/setup.sh", "self", setup)
    else:
        errors = [s for s in pf.get("submodules", []) if s.startswith(("fatal:", "error:", "warning:"))]
        if errors:
            put("cmux", "fail", f"git submodule status: {errors[0][:160]}", f"fix the checkout at {root} (git status says why)",
                "person")
        elif not bootstrap.submodule_status_ready("\n".join(pf.get("submodules", []))):
            put("cmux", "fail", bootstrap.SUBMODULE_FIX, f"cd {root} && git submodule update --init --recursive{depth}",
                "self", {"kind": "submodules", "root": root, "depth": checkout["depth"]})
        elif pf.get("dirty"):
            put("cmux", "fail", f"{pf['dirty']} local changes; the bootstrap needs a clean checkout",
                f"review git -C {root} status; commit, stash or remove them", "person")
        else:
            put("cmux", "ok", f"xcode pin {pf.get('cmux_pin') or '?'}")
        if pf.get("setup_artifacts"):
            put("setup", "ok")
        else:
            put("setup", "fail", "GhosttyKit or ghostty.h missing (cmux setup.sh has not completed)",
                f"cd {root} && ./scripts/setup.sh (after metal and zig pass)", "self", setup)

    glaeda_missing = [what for what, present in (("~/glaeda checkout", pf.get("glaeda_checkout")),
                                                  ("native cache root", pf.get("cache_root"))) if not present]
    lacking = pf.get("glaeda_lacking") or []
    head = pf.get("glaeda_head") or ""
    pinned_ref = GLAEDA_REF
    sync = f"glaeda-mini-fleet fix moves ~/glaeda to {pinned_ref[:12] if pinned_ref else 'the tip of Glaeda main'} " \
        "(a clean fetch and a detached checkout; --glaeda-ref pins the commit)"
    behind = f"at {head[:12] or '?'}, the operator pins {pinned_ref[:12]}" if pinned_ref and head != pinned_ref else \
        f"at {head[:12] or '?'}, its glaeda-mini-enroll lacks {' '.join(lacking)}" if lacking else ""
    if glaeda_missing:
        put("glaeda", "fail", f"missing: {', '.join(glaeda_missing)}",
            "git clone https://github.com/teamleaderleo/glaeda.git ~/glaeda; ~/glaeda/scripts/glaeda-mini-setup --apply",
            "self", {"kind": "glaeda"})
    elif behind and pf.get("glaeda_dirty"):
        put("glaeda", "fail", f"~/glaeda is {behind} and has {pf['glaeda_dirty']} local changes",
            "commit or move aside the changes in ~/glaeda, then " + sync, "person")
    elif behind:
        put("glaeda", "fail", f"~/glaeda is {behind}", sync, "self", {"kind": "glaeda_sync"})
    else:
        put("glaeda", "ok", head[:12])
    pmset = pf.get("pmset", "")
    # autorestart is not a bootstrap check, so it never blocks; a mini that stays off after a power cut idles the lane.
    autorestart_off = re.search(r"^\s*autorestart\s+0\b", pmset, re.MULTILINE) is not None
    if not pmset:
        put("power", "unknown", "pmset -g custom printed nothing")
    elif not bootstrap.mac_sleep_disabled_on_ac(pmset):
        put("power", "fail", "sleeps on AC power (bootstrap check unattendedPower)",
            "sudo pmset -c sleep 0" + (" && sudo pmset -a autorestart 1" if autorestart_off else ""), "password",
            {"kind": "power", "sleep": True, "autorestart": autorestart_off})
    elif autorestart_off:
        put("power", "todo", "stays off after a power failure (pmset autorestart 0)", "sudo pmset -a autorestart 1",
            "password", {"kind": "power", "sleep": False, "autorestart": True})
    else:
        put("power", "ok")
    floor = policy.get("disk", {}).get("min_free_gib") or bootstrap.default_min_free_gib("macos")
    data = obs.get("disk", {}).get("/System/Volumes/Data") or obs.get("disk", {}).get("/")
    if not data:
        put("disk", "unknown", "df printed nothing")
    elif data["free_gib"] < floor:
        put("disk", "fail", f"{data['free_gib']} GiB free, need {floor}", "glaeda-disk on the host shows where it went", "person")
    else:
        put("disk", "ok", f"{data['free_gib']} GiB free")
    if pf.get("update_running"):
        put("update", "fail", f"macOS update installing: {pf['update_running']}",
            "wait for it to finish and the host to restart, then rerun preflight", "person")
    elif (pf.get("update_prepared") or {}).get("state") == "pending":
        put("update", "fail", f"macOS {pf['update_prepared']['version']} is prepared and waits for a restart",
            "restart the host (sudo shutdown -r now) when no build is running", "password")
    elif pf.get("update_prepared"):
        put("update", "ok", f"macOS {pf['update_prepared']['version']} was prepared before the last boot and did not apply")
    else:
        put("update", "ok")
    if pf.get("autoupdate") is not None:
        install, _, download = pf["autoupdate"].partition("|")
        on = [name for name, value in (("install", install), ("download", download)) if value.strip() != "0"]
        if on:
            # Not blocking: the host works, but an update can land mid-day or wait for a restart. Update checks
            # and security data stay on; glaeda-mini-fleet upgrades on purpose.
            put("autoupdate", "todo", f"macOS updates {' and '.join(on)} automatically",
                "sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates "
                "-bool false && sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload "
                "-bool false", "password", {"kind": "autoupdate"})
        else:
            put("autoupdate", "ok")

    # Onboarding progress: candidate, node id, enrollment, runner.
    enrolled = obs.get("enrolled_node_id")
    state = pf.get("enroll_state")
    candidate = pf.get("candidate")
    stale = enrollment_stale(pf)
    if enrolled and state == "eligible" and not stale:
        put("candidate", "ok", "enrolled")
    elif candidate is None:
        put("candidate", "unknown", NO_CANDIDATE)
    elif candidate["staged"]:
        put("candidate", "ok", f"{candidate['source12']} staged")
    else:
        where = "archive downloaded, not staged" if candidate["archive"] else "not downloaded"
        put("candidate", "todo", f"{candidate['source12']}: {where}",
            "download on the operator Mac, check its sha256, scp it over; glaeda-mini-enroll --candidate stages it", "self",
            None if candidate["archive"] else {"kind": "candidate", "source12": candidate["source12"]})
    node = host.get("node_id")
    if enrolled and node and enrolled != node:
        put("node", "fail", f"enrolled as {enrolled}, manifest assigns {node}",
            "fix the manifest; an enrolled node keeps its id", "person")
    elif enrolled or node:
        put("node", "ok", enrolled or node)
    else:
        put("node", "fail", "no node id: not enrolled and the manifest assigns none",
            f"assign hosts.{name}.node_id (cmux-mac-NNN) in the manifest", "person")
    accepted = pf.get("acceptance") == "accepted"
    renew = f"glaeda-mini-fleet repair {name} --yes (renews it onto the candidate and re-adopts its class acceptance)"
    if state == "eligible" and accepted and not stale:
        put("enroll", "ok", "eligible, accepted")
    elif state == "retired":
        put("enroll", "fail", "enrollment is retired", "see docs/CMUX_FLEET_ENROLLMENT.md", "person")
    elif state == "quarantined" and pf.get("enroll_reason") in RENEWABLE_REASONS:
        put("enroll", "todo", f"quarantined ({pf.get('enroll_reason')})", renew, "self")
    elif state == "quarantined":
        put("enroll", "fail", f"quarantined ({pf.get('enroll_reason') or 'no reason'}) by an operator",
            "fix the cause, then cmux_fleet.py transition-apply ENROLLMENT --to enrolling; repair then renews it", "person")
    elif state == "draining":
        put("enroll", "info", "draining (an operator drain; upgrade and repair leave it alone)")
    elif state == "eligible":
        why = (f"runs Glaeda {short_generation(pf.get('enroll_generation'))}, not candidate "
               f"{(candidate or {}).get('source12')}") if stale else f"acceptance {pf.get('acceptance') or 'missing'}"
        put("enroll", "todo", f"eligible, but {why}", renew, "self")
    else:
        progress = "not enrolled" if not state else f"{state}, acceptance {pf.get('acceptance') or 'not run'}"
        put("enroll", "todo", progress,
            f"glaeda-mini-enroll --cmux-root {root} --node-id {enrolled or node or '<cmux-mac-NNN>'} --apply", "self")
    runners = pf.get("runners") or []
    held = [r for r in runners if r.get("held") == "yes"]
    down = [r for r in runners if r.get("loaded") == "yes" and r.get("listening") == "no"]
    if held:
        put("runner", "todo", "stopped by glaeda-mini-fleet for a renewal: " + ", ".join(r["name"] or r["dir"] for r in held),
            f"glaeda-mini-fleet repair {name} --yes starts it once the node is eligible", "self")
    elif down:
        put("runner", "todo", "loaded, listener not running: " + ", ".join(r["name"] or r["dir"] for r in down),
            f"glaeda-mini-fleet repair {name} --yes restarts it", "self")
    elif runners:
        put("runner", "ok", ", ".join(r["name"] or r["dir"] for r in runners))
    else:
        put("runner", "todo", "no runner registered", RUNNER_HOOK_NOTE, "person")
    brew_dir = pf.get("brew_dir")
    if owner is None:
        # Only a formula repair makes a missing Homebrew a blocker.
        needed = any((c.get("action") or {}).get("kind") in {"brew", "python_link"} for c in checks.values()
                     if c["state"] == "fail")
        brew_state = "fail" if needed else "info"
        if brew_dir and brew_dir["owner"] == user and brew_dir["state"] in {"empty", "partial"}:
            how = "and empty" if brew_dir["state"] == "empty" else "with an unfinished fetch"
            put("brew", brew_state, f"none (/opt/homebrew is {user}'s {how})",
                "glaeda-mini-fleet fix fetches Homebrew/brew into it (from --from HOST over the LAN, else GitHub)",
                "self", {"kind": "homebrew_fetch"})
        elif brew_dir and brew_dir["state"] != "empty":
            put("brew", brew_state, f"none (/opt/homebrew is {brew_dir['owner']}'s, has files and no brew)",
                "move /opt/homebrew aside (a stalled Homebrew install?), then rerun preflight", "person")
        else:
            # Someone else's directory may hide files from this probe; sudo-plan looks again as root and
            # hands it over only when it holds nothing but directories.
            where = f"is {brew_dir['owner']}'s" if brew_dir else "does not exist"
            put("brew", brew_state, f"none (/opt/homebrew {where})",
                f"sudo mkdir /opt/homebrew and chown it to {user} (only when it holds no files); fix then fetches "
                "Homebrew/brew into it", "password", {"kind": "homebrew", "user": user})
        put("pins", "info", "no Homebrew")
    else:
        put("brew", "info", owner if owner == user else f"{owner} (installs run as sudo -u {owner})")
        unpinned = [f for f, pinned in (pf.get("brew_formulas") or {}).items() if not pinned]
        if unpinned:
            put("pins", "todo", f"not pinned: {' '.join(unpinned)}; class receipts pin toolchain strings",
                f"{as_owner}brew pin {' '.join(unpinned)}", brew_group)
        else:
            put("pins", "ok", " ".join(pf.get("brew_formulas") or {}) or "none installed")
    # PR jobs run as the login user, so on a runner host every secret it can read is theirs. A host with no
    # runners (a dev-build worker) legitimately reads its own tokens as that user, which is only worth showing.
    # The manifest's accepted_secrets are risks the operator accepted (reviewed in cmuxterm-hq
    # build-fleet/mini-fleet.json); they show as info, and only the rest fail.
    secrets = pf.get("secrets") or []
    login_home = pf.get("home") or f"/Users/{user}"
    allowed = {login_home + p[1:] if p.startswith("~/") else p for p in host.get("accepted_secrets", [])}
    unaccepted = [p for p in secrets if p not in allowed]
    known = [p for p in secrets if p in allowed]
    runner_host = bool(runners) or "ci-runner" in (host.get("roles") or [])
    if unaccepted and runner_host:
        put("secrets", "fail", f"readable by {user}, the user PR jobs run as: {', '.join(unaccepted)}",
            "make them root-only or move them to a host with no PR runners (cmuxterm-hq#595), or accept the "
            "risk in the manifest's hosts.<host>.accepted_secrets", "person")
    elif unaccepted:
        put("secrets", "info", f"readable by {user} (no PR runners here): {', '.join(unaccepted)}"
            + (f"; accepted: {', '.join(known)}" if known else ""))
    elif known:
        put("secrets", "info", f"accepted: {', '.join(known)}")
    else:
        put("secrets", "ok", f"none readable by {user}")
    blocked = any(c["state"] == "fail" or (c["state"] == "unknown" and k in UNKNOWN_BLOCKS) for k, c in checks.items())
    return {"host": name, "ready": not blocked, "checks": checks,
            "enrollment": {"state": state, "generation": pf.get("enroll_generation"), "stale": stale,
                           "accepted": accepted, "reason": pf.get("enroll_reason"),
                           "local": pf.get("acceptance_class") not in {None, "glaeda-class-acceptance/v1"}},
            "runners": runners}


# Quarantine reasons a renewal fixes; any other reason is an operator's, and upgrade and repair leave it.
RENEWABLE_REASONS = frozenset({"stale_glaeda_generation", "toolchain_mismatch", "failed_acceptance"})


def enrollment_stale(pf: dict[str, Any]) -> bool:
    """Whether an enrolled node runs another Glaeda than the fleet's candidate.

    The candidate not staged there means no enrollment records it yet; staged, the enrollment's
    glaedaGeneration must be that generation's binary digest. Without a candidate nothing is stale."""
    candidate = pf.get("candidate")
    if not pf.get("enroll_state") or pf.get("enroll_state") == "retired" or candidate is None:
        return False
    if not candidate["staged"]:
        return True
    got, want = pf.get("enroll_generation"), candidate.get("generation")
    return bool(got and want and got != want)


def short_generation(value: str | None) -> str:
    """sha256:0123456789ab..., the way the tables show a glaedaGeneration."""
    return value.removeprefix("sha256:")[:12] if value else "?"


def preflight(manifest: dict[str, Any], observed: dict[str, Any], hosts: list[str]) -> list[dict[str, Any]]:
    fallback = operator_zig_minimum()
    return [preflight_host(manifest, name, observed["hosts"].get(name) or {"reachable": False, "error": "not observed"},
                           fallback) for name in hosts]


def grouped_fixes(result: dict[str, Any]) -> dict[str, list[str]]:
    """A host's fixes by who can apply them, each once, in check order. Blockers before todos."""
    out: dict[str, list[str]] = {g: [] for g in FIX_GROUPS}
    for wanted in ("fail", "todo"):
        for check, c in result["checks"].items():
            if c["state"] == wanted and c["fix"] and c["fix"] not in out[c["group"] or "person"]:
                out[c["group"] or "person"].append(f"{check}: {c['fix']}")
    return out


def render_preflight(results: list[dict[str, Any]]) -> str:
    cell = {"ok": "ok", "fail": "FAIL", "todo": "todo", "unknown": "?"}
    width = max([len("host"), *(len(r["host"]) for r in results)])
    lines = []
    columns = [c for c in PREFLIGHT_CHECKS if any(c in r["checks"] for r in results)] or ["reach"]
    if any("reach" in r["checks"] for r in results):
        columns = ["reach", *columns]
    sizes = {c: max(len(c), 4) for c in columns}
    for r in results:
        if "brew" in r["checks"]:
            sizes["brew"] = max(sizes["brew"], len(r["checks"]["brew"]["detail"].split(" ")[0]))
    lines.append("  ".join([f"{'host':<{width}}", *(f"{c:<{sizes[c]}}" for c in columns), "ready"]))
    for r in results:
        row = []
        for c in columns:
            got = r["checks"].get(c)
            text = "" if got is None else cell.get(got["state"], "")
            if c == "brew" and got and got["state"] == "info":
                text = got["detail"].split(" ")[0]
            row.append(f"{text:<{sizes[c]}}")
        lines.append("  ".join([f"{r['host']:<{width}}", *row, "yes" if r["ready"] else "NO"]))
    for r in results:
        problems = [(c, v) for c, v in r["checks"].items() if v["state"] in {"fail", "todo", "unknown"}]
        if not problems:
            continue
        lines.append("")
        lines.append(f"{r['host']}: {'ready' if r['ready'] else 'not ready'}")
        for c, v in problems:
            lines.append(f"  {cell[v['state']]:<4} {c}: {v['detail']}")
        grouped = grouped_fixes(r)
        for group in FIX_GROUPS:
            if grouped[group]:
                lines.append(f"  {GROUP_TITLES[group]}:")
                lines.extend(f"    {f}" for f in grouped[group])
    ready = sum(r["ready"] for r in results)
    lines.append("")
    lines.append(f"{len(results)} hosts, {ready} ready, {len(results) - ready} not ready")
    return "\n".join(lines)


# ---------------------------------------------------------------- fix and sudo-plan

# The order fix runs a host's repairs in, so each runs after what it builds on.
FIX_ORDER = ("xcode_share", "xcode_clone", "python", "cmux_clone", "submodules", "homebrew_fetch", "brew", "python_link",
             "rust_default", "rust_channel", "glaeda", "glaeda_sync", "metal", "setup", "candidate")
# What each repair needs to pass first (checks, or repairs made earlier in the same run).
# glaeda-mini-setup builds glaeda-worktree-reclaim with cargo, under the Python enroll will use.
FIX_NEEDS = {"metal": ("licence", "launch"), "setup": ("cmux", "licence", "launch", "metal", "zig"), "brew": ("brew",),
             "python_link": ("brew",), "glaeda": ("python", "rust"),
             # git runs through the /usr/bin shim, which needs a selected, licensed developer directory.
             "homebrew_fetch": ("select", "licence")}
# Remote functions that only read; every other one takes the host's step lock.
# share_send only reads, and stays lock-free so one source can feed several peers at once.
READ_ONLY_FUNCTIONS = {"candidate_check", "share_have", "share_source", "share_send", "host_check"}
# Steps that honor less of the host gate than the default (both the fleet host lock and reservations):
# a drain waits out the job holding the lock, and restoring runners never builds anything.
LOCK_GATE = {"runner_hold": "reservation", "runner_release": "none", "runner_kick": "none"}
SUDO_ORDER = ("select", "licence", "first_launch", "power", "autoupdate", "homebrew", "brew", "python_link")
# Homebrew itself comes from a git fetch, never the brew.sh installer: that stalls on the Command Line Tools
# softwareupdate the fleet does not need (the pinned Xcode is selected) and leaves an empty /opt/homebrew.
HOMEBREW_REPO = "https://github.com/Homebrew/brew"
FIX_TIMEOUTS = {"cmux_clone": 1800, "submodules": 1800, "brew": 5400, "rust_channel": 1800, "glaeda": 1800,
                "metal": 3600, "setup": 5400, "python": 1800, "candidate": 1800, "homebrew_fetch": 1800,
                "glaeda_sync": 900}
RUSTUP_PROXIES = ("cargo", "rustc", "rustup")
BREW_STAGE = "Library/Caches/glaeda/share/homebrew/downloads"  # under the login user's home; see share brew
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path("~/.local/state").expanduser()) / "glaeda" / "mini-fleet"
OPERATOR_CACHE = Path(os.environ.get("GLAEDA_MINI_FLEET_CACHE", "~/Library/Caches/glaeda/mini-fleet")).expanduser()
SUDOERS_FILE = "/etc/sudoers.d/glaeda-mini-fleet"
PRINT_LOCK = threading.Lock()
CANDIDATE_LOCK = threading.Lock()


def say(text: str) -> None:
    with PRINT_LOCK:
        print(text, flush=True)


def planned_actions(result: dict[str, Any]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """(repairs fix runs, in FIX_ORDER; root steps for sudo-plan, in SUDO_ORDER) from one preflight result.

    Each carries the checks it makes pass. The Homebrew formulas become one step."""
    mine: list[dict[str, Any]] = []
    root: list[dict[str, Any]] = []
    for check, c in result["checks"].items():
        action = c.get("action")
        if not action or c["state"] not in {"fail", "todo"} or c["group"] not in {"self", "password"}:
            continue
        into = mine if c["group"] == "self" else root
        if into is mine and action["kind"] == "brew" and "default" in action:
            # A fresh rustup has no default toolchain; set it once the install passed.
            mine.append({"kind": "rust_default", "toolchain": action["default"], "checks": [check], "needs": [check]})
        if action["kind"] == "brew":
            merged = next((a for a in into if a["kind"] == "brew"), None)
            if merged:
                merged["formulas"].append(action["formula"])
                merged["checks"].append(check)
                continue
            action = {"kind": "brew", "owner": action["owner"], "formulas": [action["formula"]]}
        into.append({**action, "checks": [check]})
    mine.sort(key=lambda a: FIX_ORDER.index(a["kind"]))
    root.sort(key=lambda a: SUDO_ORDER.index(a["kind"]))
    return mine, root


def waiting_on(action: dict[str, Any], checks: dict[str, Any], fixed: set[str]) -> str | None:
    """The first prerequisite of a repair that neither passes nor was repaired in this run, and who fixes it."""
    for need in action.get("needs", FIX_NEEDS.get(action["kind"], ())):
        got = checks.get(need)
        if got is None or got["state"] in {"ok", "info"} or need in fixed:
            continue
        if got["state"] == "unknown":
            return f"{need} (unknown: {got['detail']})"
        who = {"password": "sudo-plan", "person": "a person", "self": "fix"}.get(got["group"], "a person")
        return f"{need} ({who})"
    return None


def describe(action: dict[str, Any]) -> str:
    kind = action["kind"]
    if kind == "xcode_clone":
        return f"APFS clone {action['source']} to {action['path']}"
    if kind == "xcode_share":
        return f"copy {action['path']} ({action['version']} {action['build']}) from a peer over the LAN"
    if kind == "python":
        return f"copy a relocatable CPython {action['min']}+ from this Mac into ~/.local"
    if kind == "cmux_clone":
        return f"shallow clone {action['repo']}@{action['ref']} into {action['root']} with submodules"
    if kind == "submodules":
        return f"initialize submodules in {action['root']}"
    if kind == "brew":
        links = [what for formula, what in (("rustup", "the rustup proxies"), (BREW_PYTHON[0], "python3"))
                 if formula in action["formulas"]]
        link = f", link {' and '.join(links)} into /opt/homebrew/bin" if links else ""
        pinned = [f for f in action["formulas"] if f in BREW_FORMULAS]
        pin = f", then brew pin {' '.join(pinned)}" if pinned else ""
        return f"brew install {' '.join(action['formulas'])}{link}{pin}"
    if kind == "python_link":
        return f"link /opt/homebrew/bin/python3 to {BREW_PYTHON[1]}"
    if kind == "homebrew_fetch":
        return f"git fetch Homebrew/brew into /opt/homebrew (a peer's copy, else {HOMEBREW_REPO})"
    if kind == "glaeda_sync":
        return f"move ~/glaeda to {GLAEDA_REF[:12] if GLAEDA_REF else 'the tip of Glaeda main'} (clean fetch, detached checkout)"
    if kind == "rust_default":
        return f"rustup default {action['toolchain']}"
    if kind == "rust_channel":
        return f"rustup toolchain install {action['channel']}"
    if kind == "glaeda":
        return "clone Glaeda into ~/glaeda and run glaeda-mini-setup --apply"
    if kind == "metal":
        return "xcodebuild -downloadComponent MetalToolchain (about 700 MB)"
    if kind == "setup":
        return f"cmux scripts/setup.sh in {action['root']} (builds GhosttyKit)"
    if kind == "candidate":
        return f"stage Glaeda candidate {action['source12']} (gh download once on this Mac, sha256 checked, scp)"
    return kind


def note(log: Any, text: str) -> None:
    if log is not None:
        log.write(text.encode() + b"\n")
        log.flush()


def run_logged(argv: list[str], log: Any, stdin: bytes = b"", timeout: float | None = None) -> int:
    """Run a local command with its output appended to the host's log; 124 on timeout."""
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=log or subprocess.DEVNULL, stderr=subprocess.STDOUT)
    except OSError as error:
        note(log, f"cannot run {argv[0]}: {error}")
        return 127
    try:
        proc.communicate(stdin, timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        note(log, f"timed out after {timeout}s")
        return 124
    return proc.returncode


def ssh_stream(name: str, user: str, command: str, log: Any, stdin: bytes = b"",
               timeout: float | None = None, options: tuple[str, ...] = ()) -> int:
    """One remote command, key authentication only, output to the log. stdin carries data such as a token."""
    return run_logged([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=30",
                       *options, "-l", user, name, command], log, stdin, timeout)


def library_command(func: str, args: list[str], keep_stdin: bool = False) -> str:
    """`/bin/bash -c` running one cmux_mini_fix.sh function, ready to hand to ssh as its command.

    Every function that changes the host first takes its step lock."""
    gate = LOCK_GATE.get(func, "")
    call = shlex.join([func, *args]) if func in READ_ONLY_FUNCTIONS else \
        f"lock{' ' + gate if gate else ''}; " + shlex.join([func, *args])
    script = (f"WORKLOAD_PATH={shlex.quote(bootstrap.CMUX_WORKLOAD_TOOL_PATH)}\n" + ("KEEP_STDIN=1\n" if keep_stdin else "")
              + FIX_LIBRARY.read_text() + "\n" + call + "\n")
    return "/bin/bash -c " + shlex.quote(script)


def fix_call(name: str, user: str, func: str, args: list[str], log: Any, timeout: float | None) -> int:
    """Run one function of cmux_mini_fix.sh on the host."""
    return ssh_stream(name, user, library_command(func, args), log, timeout=timeout)


HELD_EXIT = 20  # cmux_mini_fix.sh: the host is held by the fleet host lock or a reservation
HOLD_WAIT_SECONDS = 4 * 3600
HOLD_POLL_SECONDS = 60


def host_check(manifest: dict[str, Any], name: str) -> str | None:
    """Why the host is held (another build holds the fleet host lock, or it is reserved), or None when free.

    Read-only on the host. A host whose state cannot be read counts as held: never change a host blind."""
    try:
        proc = subprocess.run([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-l", manifest["ssh_user"], name,
                               library_command("host_check", [])], capture_output=True, text=True, timeout=120,
                              check=False)
    except subprocess.TimeoutExpired:
        return "could not read its host lock and reservation (timed out)"
    if proc.returncode == 0:
        return None
    said = [line.split("held: ", 1)[1] for line in proc.stdout.splitlines() if "held: " in line]
    if proc.returncode == HELD_EXIT and said:
        return said[-1]
    return f"could not read its host lock and reservation (ssh exit {proc.returncode})"


def gate_hosts(manifest: dict[str, Any], names: list[str], wait: bool = False,
               poll: float = HOLD_POLL_SECONDS, limit: float = HOLD_WAIT_SECONDS) -> dict[str, str]:
    """The hosts a changing command must skip, and why: held by the fleet host lock or a reservation.

    With wait, poll the held ones until they are free or `limit` seconds pass, then skip what is still held."""
    def check(names: list[str]) -> dict[str, str]:
        if not names:
            return {}
        with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
            found = dict(zip(names, pool.map(lambda h: host_check(manifest, h), names)))
        return {h: why for h, why in found.items() if why}

    held = check(names)
    deadline = time.monotonic() + limit
    while wait and held and time.monotonic() < deadline:
        say("waiting: " + "; ".join(f"{h} held: {why}" for h, why in sorted(held.items())))
        time.sleep(poll)
        held = check(sorted(held))
    for name, why in sorted(held.items()):
        say(f"{name}: held: {why}, skipped" + (" (waited the limit)" if wait else " (--wait waits for it)"))
    return held


def host_gate_block() -> str:
    """cmux_mini_fix.sh's host gate, for scripts that run without the library (sudo-plan)."""
    text = FIX_LIBRARY.read_text()
    return text[text.index("# >>> host gate"):text.index("# <<< host gate")]


def brew_commands(owner: str, formulas: list[str], as_owner: bool, as_root: bool = False) -> list[str]:
    """Install or upgrade formulas in /opt/homebrew as its owner, link rustup's proxies, python3 and an unlinked gh
    onto the workload PATH, then pin the BREW_FORMULAS among them (never BREW_UNPINNED).

    as_root: the script already runs as root (sudo-plan --ask-once), so root steps drop their sudo; the owner's
    steps still go through sudo -H -u, and the staged bottles are the login user's ($login_home, set by the plan)."""
    if not SAFE_WORD_RE.fullmatch(owner) or set(formulas) - set(BREW_FORMULAS) - set(BREW_UNPINNED):
        raise Failure(f"refusing Homebrew step for owner {owner!r}, formulas {formulas}")
    run = f"sudo -H -u {owner} " if as_owner else ""
    root = "sudo " if as_owner and not as_root else ""
    # Newer Homebrew asks before installing unless told not to; sudo drops the variable, so env sets it.
    lines = [f'brew_as() {{ {run}env HOMEBREW_NO_ASK=1 /opt/homebrew/bin/brew "$@"; }}',
             # Bottles glaeda-mini-fleet share brew staged from a peer; brew checks their digests before use.
             f'staged="${{login_home:-$HOME}}/{BREW_STAGE}"',
             'if [ -n "$(ls "$staged" 2>/dev/null)" ]; then',
             '  cache="$(brew_as --cache)/downloads"',
             f'  {run}mkdir -p "$cache"',
             # -P: a symlink among them is copied as a link, never followed (as root it could read any file).
             f'  {root}cp -nP "$staged"/* "$cache"/ || true',
             *([f'  {root}chown -h {owner} "$cache"/*'] if as_owner else []),
             "fi",
             # A pinned formula stays as it is: upgrading it would change the toolchain its class receipt names.
             'pinned=" $({ brew_as list --pinned 2>/dev/null || true; } | tr "\\n" " ") "',
             f"for f in {' '.join(formulas)}; do",
             '  if ! brew_as list --versions "$f" >/dev/null 2>&1; then brew_as install "$f"',
             '  elif [[ "$pinned" == *" $f "* ]]; then echo "$f is pinned, left as it is; brew unpin $f to upgrade it"',
             '  else brew_as upgrade "$f"; fi',
             "done"]
    if "rustup" in formulas:
        lines += [f"for t in {' '.join(RUSTUP_PROXIES)}; do",
                  f'  [ -e "/opt/homebrew/bin/$t" ] || [ -L "/opt/homebrew/bin/$t" ] || '
                  f'{run}ln -s "/opt/homebrew/opt/rustup/bin/$t" "/opt/homebrew/bin/$t"',
                  "done"]
    if BREW_PYTHON[0] in formulas:
        lines += python_link_commands(owner, as_owner)
    for f in (f for f in formulas if f in BREW_UNPINNED):
        # Installed but unlinked (a keg someone unlinked) still leaves the workload PATH without it.
        lines.append(f'[ -e "/opt/homebrew/bin/{f}" ] || brew_as link {f}')
    # Class receipts pin toolchain strings; the reference host pins exactly these, and no receipt names the rest.
    pinned = [f for f in formulas if f in BREW_FORMULAS]
    if pinned:
        lines.append(f"brew_as pin {' '.join(pinned)}")
    return lines


def python_link_commands(owner: str, as_owner: bool) -> list[str]:
    """/opt/homebrew/bin/python3 -> python3.13 (as on cmux14), so the workload PATH's python3 is 3.13, not /usr/bin's."""
    if not SAFE_WORD_RE.fullmatch(owner):
        raise Failure(f"refusing the python3 link for owner {owner!r}")
    run = f"sudo -H -u {owner} " if as_owner else ""
    versioned = BREW_PYTHON[1]
    return ["b=/opt/homebrew/bin",
            f'[ -x "$b/{versioned}" ] || {{ echo "$b/{versioned} is missing: brew install {BREW_PYTHON[0]}" >&2; exit 3; }}',
            f'if [ "$(readlink "$b/python3" || true)" = {versioned} ]; then echo "unchanged: $b/python3 -> {versioned}"',
            f'elif [ -e "$b/python3" ] || [ -L "$b/python3" ]; then '
            f'echo "$b/python3 exists and is not a link to {versioned}; move it aside" >&2; exit 3',
            f'else {run}ln -s {versioned} "$b/python3"; echo "linked $b/python3 -> {versioned}"; fi']


def operator_python_dist(minimum: str) -> tuple[Path, str] | None:
    """The newest relocatable CPython on this Mac that is at least `minimum`: (directory, full version)."""
    explicit = os.environ.get("GLAEDA_MINI_FLEET_PYTHON")
    found = [Path(explicit).expanduser()] if explicit else \
        sorted(Path("~/.local/share/uv/python").expanduser().glob("cpython-3.*-macos-aarch64-none"))
    best: tuple[Path, str] | None = None
    for directory in found:
        match = re.match(r"cpython-(\d+\.\d+(?:\.\d+)?)", directory.resolve().name)
        if not match or not (directory / "bin" / "python3").exists():
            continue
        # The directory name carries the full version, so a patch upgrade lands beside the old one.
        version = match[1]
        if version_tuple(version) >= version_tuple(minimum) and \
                (best is None or version_tuple(version) > version_tuple(best[1])):
            best = (directory.resolve(), version)
    return best


def ship_python(name: str, user: str, action: dict[str, Any], log: Any) -> tuple[bool, str]:
    dist = operator_python_dist(action["min"])
    if dist is None:
        return False, (f"no relocatable CPython {action['min']}+ on this Mac; `uv python install 3.14` or set "
                       "GLAEDA_MINI_FLEET_PYTHON to a cpython-3.x-macos-aarch64-none directory")
    path, version = dist
    target = f"~/.local/python-{version}"
    if fix_call(name, user, "python_prepare", [target], log, 60):
        return False, f"could not create {target}"
    note(log, f"rsync {path}/ -> {name}:{target}/")
    if run_logged(["rsync", "-a", "-e", f"{SSH} -o BatchMode=yes -o ConnectTimeout=10",
                   f"{path}/", f"{user}@{name}:.local/python-{version}/"], log, timeout=FIX_TIMEOUTS["python"]):
        return False, "rsync failed; rerun fix to resume"
    if fix_call(name, user, "python_link", [target, action["min"]], log, 120):
        return False, "the copied interpreter did not pass; see the log"
    return True, f"CPython {version} at {target}"


CANDIDATE_REPO = "teamleaderleo/glaeda"
CANDIDATE_ARTIFACT = "glaeda-candidate-aarch64-apple-darwin"
CANDIDATE_WORKFLOW = "Fleet candidate bundles"
CANDIDATE_TARGET = "aarch64-apple-darwin"
# The reviewed Glaeda candidate the fleet runs: the manifest's `candidate`, which glaeda-mini-fleet upgrade
# writes, or during an upgrade the candidate it rolls out. main sets it for each run.
PINNED_CANDIDATE: dict[str, str] | None = None
NO_CANDIDATE = "the fleet manifest pins no candidate; glaeda-mini-fleet upgrade --candidate-run RUN records one"
# The Glaeda commit the operator pins every host's ~/glaeda to (glaeda-mini-enroll runs from there), from
# --glaeda-ref; main sets it for each run. Without it, a step that moves ~/glaeda reads main's tip once per run.
GLAEDA_REF: str | None = None
GLAEDA_MAIN: dict[str, str] = {}
GLAEDA_MAIN_LOCK = threading.Lock()


def operator_candidate() -> dict[str, str]:
    """The pinned candidate: source, sha256, run, artifact, repo and expires; {} when none is pinned."""
    return dict(PINNED_CANDIDATE or {})


def sha256_file(path: Path) -> str:
    import hashlib
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def candidate_archive_name(candidate: dict[str, str]) -> str:
    return f"glaeda-{candidate['source']}-aarch64-apple-darwin.tar.gz"


def fetch_candidate(candidate: dict[str, str], log: Any) -> Path:
    """The candidate archive on this Mac, downloaded with gh at most once per run and sha256 checked."""
    import tempfile
    missing = {"source", "sha256", "run", "artifact", "repo"} - set(candidate)
    if missing:
        raise Failure(f"{NO_CANDIDATE} (missing {', '.join(sorted(missing))})")
    with CANDIDATE_LOCK:
        cache = OPERATOR_CACHE / f"glaeda-candidate-{candidate['source'][:12]}"
        archive = cache / candidate_archive_name(candidate)
        if archive.is_file() and sha256_file(archive) == candidate["sha256"]:
            return archive
        cache.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=cache) as tmp:
            note(log, f"gh run download {candidate['run']} --repo {candidate['repo']} -n {candidate['artifact']}")
            code = run_logged(["gh", "run", "download", candidate["run"], "--repo", candidate["repo"],
                               "-n", candidate["artifact"], "--dir", tmp], log, timeout=FIX_TIMEOUTS["candidate"])
            got = Path(tmp) / archive.name
            if code or not got.is_file():
                raise Failure(f"gh run download {candidate['run']} failed (gh signed in? artifact expired?)")
            digest = sha256_file(got)
            if digest != candidate["sha256"]:
                raise Failure(f"downloaded candidate has sha256 {digest}, want {candidate['sha256']}")
            os.replace(got, archive)
        return archive


def stage_candidate(name: str, user: str, action: dict[str, Any], log: Any) -> tuple[bool, str]:
    candidate = operator_candidate()
    source12 = action["source12"]
    if candidate.get("source", "")[:12] != source12:
        return False, f"the host was probed for candidate {source12}, the manifest pins {candidate.get('source', 'none')[:12]}"
    if "sha256" not in candidate:
        return False, NO_CANDIDATE
    archive_name = candidate_archive_name(candidate)
    code = fix_call(name, user, "candidate_check", [source12, archive_name, candidate["sha256"]], log, 120)
    if code == 0:
        return True, "already in place"
    if code != 10:
        return False, f"cannot check the archive on the host (exit {code}); see the log"
    try:
        archive = fetch_candidate(candidate, log)
    except Failure as error:
        return False, str(error)
    if fix_call(name, user, "candidate_dir", [source12], log, 60):
        return False, "could not create the candidate directory"
    remote_path = f"Library/Caches/cmux-fleet/glaeda-candidate-{source12}/{archive_name}.partial"
    if run_logged(["scp", "-q", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", os.fspath(archive),
                   f"{user}@{name}:{remote_path}"], log, timeout=FIX_TIMEOUTS["candidate"]):
        return False, "scp failed; rerun fix to resume"
    if fix_call(name, user, "candidate_place", [source12, archive_name, candidate["sha256"]], log, 120):
        return False, "the copy did not verify; see the log"
    return True, f"{source12} staged for enrollment"


# Repairs fix makes from a seed host over the LAN when given --from, and the share thing for each.
SEEDABLE = {"xcode_share": "xcode", "python": "python", "candidate": "candidate", "metal": "metal"}


def run_repair(manifest: dict[str, Any], name: str, action: dict[str, Any], log: Any,
               seed: str | None = None) -> tuple[bool, str]:
    user = manifest["ssh_user"]
    kind = action["kind"]
    if seed and kind in SEEDABLE:
        thing = SEEDABLE[kind]
        problem = prepare_seed(manifest, seed, thing, log)
        if not problem:
            return share_one(manifest, thing, seed, name, share_args(manifest, name, thing), log, True)
        if kind == "xcode_share":
            return False, f"{seed} cannot seed {thing} ({problem})"
        # Python, the candidate and Metal also have a path without a seed: this Mac, or the internet.
        note(log, f"{seed} cannot seed {thing} ({problem}); using the path without a seed")
    if kind in {"xcode_clone", "brew", "python_link"}:  # none goes through the fix library's lock(), so ask first
        code = fix_call(name, user, "host_check", [], log, 120)
        if code:
            return False, held_or(code, None, "could not check the host lock and reservation")
    if kind == "xcode_clone":
        code, text = remote(name, user, CLONE_XCODE, [action["source"], action["path"], action["version"], action["build"]])
        note(log, text)
        return code == 0, (text.splitlines() or [""])[-1]
    if kind == "python":
        return ship_python(name, user, action, log)
    if kind == "candidate":
        return stage_candidate(name, user, action, log)
    if kind in {"brew", "python_link"}:
        lines = brew_commands(action["owner"], action["formulas"], False) if kind == "brew" else \
            python_link_commands(action["owner"], False)
        script = "\n".join(["set -euo pipefail", "cd /", *lines])
        code = ssh_stream(name, user, "/bin/bash -c " + shlex.quote(script), log, timeout=FIX_TIMEOUTS["brew"])
        return code == 0, "" if code == 0 else f"exit {code}; see the log"
    if kind == "homebrew_fetch":
        return fetch_homebrew(manifest, name, log, seed)
    if kind == "glaeda_sync":
        try:
            ref = glaeda_target()
        except Failure as error:
            return False, str(error)
        code = fix_call(name, user, "glaeda_sync", [ref, *ENROLL_FLAGS], log, FIX_TIMEOUTS["glaeda_sync"])
        return code == 0, f"~/glaeda at {ref[:12]}" if code == 0 else held_or(code, None, "could not move ~/glaeda")
    calls = {
        "cmux_clone": ("cmux_clone", lambda a: [a["repo"], a["ref"], a["root"], str(a["depth"])]),
        "submodules": ("submodules", lambda a: [a["root"], str(a["depth"])]),
        "rust_default": ("rust_default", lambda a: [a["toolchain"]]),
        "rust_channel": ("rust_channel", lambda a: [a["root"], a["channel"]]),
        "glaeda": ("glaeda", lambda a: [a["python"]]),
        "metal": ("metal", lambda a: [a["developer"]]),
        "setup": ("cmux_setup", lambda a: [a["root"], a["developer"]]),
    }
    func, args = calls[kind]
    code = fix_call(name, user, func, args(action), log, FIX_TIMEOUTS.get(kind, 600))
    return code == 0, "" if code == 0 else f"exit {code}; see the log"


def fetch_homebrew(manifest: dict[str, Any], name: str, log: Any, seed: str | None) -> tuple[bool, str]:
    """Populate the host's empty /opt/homebrew with Homebrew/brew: from the seed's /opt/homebrew over the LAN
    when given (the host fetches with the operator's agent, or the manifest's LAN key), else from GitHub."""
    user = manifest["ssh_user"]
    args: list[str] = []
    options: tuple[str, ...] = ()
    if seed:
        address, detail = lan_address(manifest, seed, log)
        if address is None:
            note(log, f"{detail}; fetching from {HOMEBREW_REPO}")
        else:
            lan = lan_settings(manifest)
            args = [f"ssh://{user}@{address}/opt/homebrew", *([lan["identity"]] if lan["identity"] else [])]
            options = ("-A",) if lan["agent"] else ()
    code = ssh_stream(name, user, library_command("homebrew_fetch", [HOMEBREW_REPO, *args]), log,
                      timeout=FIX_TIMEOUTS["homebrew_fetch"], options=options)
    if code:
        return False, held_or(code, None, "could not fetch Homebrew")
    return True, f"Homebrew in /opt/homebrew (from {seed if args else 'GitHub'})"


def fix_host(manifest: dict[str, Any], name: str, result: dict[str, Any], yes: bool,
             log_dir: Path | None, seed: str | None = None) -> dict[str, Any]:
    """Run (or, without yes, plan) one host's non-root repairs in order. Nothing is retried within a run.

    With a seed host, the Xcode app, Python, the candidate and the Metal toolchain come from it over the LAN."""
    mine, root = planned_actions(result)
    checks = result["checks"]
    out: dict[str, Any] = {"host": name, "planned": [], "done": [], "failed": [], "waiting": [], "log": None,
                           "sudo": [c for a in root for c in a["checks"]],
                           "person": [f"{c}: {v['fix']}" for c, v in checks.items()
                                      if v["state"] == "fail" and v["group"] == "person" and v["fix"]]}
    fixed: set[str] = set()
    log = None
    if yes and mine and log_dir is not None:
        out["log"] = os.fspath(log_dir / f"{name}.log")
        log = open(out["log"], "ab")
    try:
        for action in mine:
            label = f"{'/'.join(action['checks'])}: {describe(action)}"
            blocker = waiting_on(action, checks, fixed)
            if action["kind"] == "xcode_share" and not seed:
                blocker = "--from HOST, a host that has it"
            if blocker:
                out["waiting"].append(f"{label} (waits for {blocker})")
                continue
            if action["kind"] == "glaeda":
                python = (checks.get("python") or {}).get("detail", "")
                action = {**action, "python": python.split(" at ", 1)[1] if checks["python"]["state"] == "ok"
                          else "~/.local/bin/python3" if "python" in fixed else "python3"}
            if seed and (action["kind"] in SEEDABLE or action["kind"] == "homebrew_fetch"):
                label += f" [from {seed} over the LAN]"
            if not yes:
                out["planned"].append(label)
                fixed.update(action["checks"])
                continue
            say(f"{name}: {label}")
            note(log, f"== {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {label}")
            try:
                ok, detail = run_repair(manifest, name, action, log, seed)
            except (Failure, OSError, subprocess.SubprocessError) as error:
                ok, detail = False, f"{type(error).__name__}: {error}"
            note(log, f"== {'done' if ok else 'FAILED'} {detail}")
            if ok:
                fixed.update(action["checks"])
                out["done"].append(label + (f" ({detail})" if detail else ""))
            else:
                out["failed"].append(f"{label}: {detail}")
                say(f"{name}: FAILED {label}: {detail}")
    finally:
        if log is not None:
            log.close()
    return out


def render_fix(outcomes: list[dict[str, Any]], yes: bool) -> str:
    lines = []
    for o in outcomes:
        if o.get("skipped"):
            lines.append(f"{o['host']}: skipped ({o['skipped']})")
            continue
        lines.append(f"{o['host']}:" + (f"  log {o['log']}" if o["log"] else ""))
        rows = [("would run", o["planned"]), ("done", o["done"]), ("FAILED", o["failed"]), ("waits", o["waiting"]),
                ("sudo-plan", [", ".join(o["sudo"])] if o["sudo"] else []), ("person", o["person"])]
        empty = True
        for title, items in rows:
            for item in items:
                lines.append(f"  {title:<10} {item}")
                empty = False
        if empty:
            lines.append("  nothing to fix")
    if not yes:
        lines.append("dry run; pass --yes to run the steps above")
    return "\n".join(lines)


def run_log_dir(command: str, explicit: Path | None) -> Path:
    directory = explicit or STATE_DIR / f"{command}-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    return directory


def eligible_hosts(manifest: dict[str, Any], hosts: list[str]) -> tuple[list[str], dict[str, str]]:
    """Hosts a changing command may touch, and why the others are skipped."""
    skipped = {h: "apply: false" for h in hosts if manifest["hosts"][h].get("overrides", {}).get("apply") is False}
    return [h for h in hosts if h not in skipped], skipped


def cmd_fix(manifest: dict[str, Any], hosts: list[str], yes: bool, log_dir: Path | None, seed: str | None = None,
            wait: bool = False) -> int:
    if seed:
        select_hosts(manifest, [seed])
    targets, skipped = eligible_hosts(manifest, [h for h in hosts if h != seed])
    held = gate_hosts(manifest, targets, wait and yes)
    skipped.update({h: f"held: {why}" for h, why in held.items()})
    targets = [h for h in targets if h not in held]
    results = {r["host"]: r for r in preflight(manifest, observe(manifest, targets, preflight=True), targets)}
    directory = run_log_dir("fix", log_dir) if yes else None
    reachable = [h for h in targets if "reach" not in results[h]["checks"]]
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        done = dict(zip(reachable, pool.map(lambda h: fix_host(manifest, h, results[h], yes, directory, seed), reachable)))
    outcomes = []
    for name in [h for h in hosts if h != seed]:
        if name in skipped:
            outcomes.append({"host": name, "skipped": skipped[name]})
        elif name not in done:
            outcomes.append({"host": name, "skipped": f"unreachable: {results[name]['checks']['reach']['detail']}"})
        else:
            outcomes.append(done[name])
    print(render_fix(outcomes, yes))
    failed = any(o.get("failed") for o in outcomes) or len(reachable) < len(targets) or bool(held)
    if yes and reachable:
        print(f"\nlogs: {directory}\n\nfresh preflight:")
        print(render_preflight(preflight(manifest, observe(manifest, reachable, preflight=True), reachable)))
    return 1 if failed else 0


def sudoers_rule(manifest: dict[str, Any], name: str) -> str | None:
    """A NOPASSWD rule for restarting the manifest's launchd jobs, or None when it declares none.

    It leaves out xcode-select and xcodebuild -runFirstLaunch on purpose: the pinned Xcode lives in
    /Applications, which the admin group (the login user) can rename entries in, so a path-based rule
    for either would give passwordless root to any process running as that user."""
    user = manifest["ssh_user"]
    if not re.fullmatch(r"[a-z_][a-z0-9_-]*", user):
        raise Failure(f"{name}: cannot write a sudoers rule for user {user!r}")
    # Timer jobs are left out: a kickstart -k would kill a fill mid-build, and launchd starts them anyway.
    labels = [label for label in host_policy(manifest, name).get("launchd", {}).get("running", [])
              if re.fullmatch(r"[A-Za-z0-9._-]+", label) and label not in INTERVAL_LABELS]
    if not labels:
        return None
    return f"{user} ALL=(root) NOPASSWD: " + ", ".join(f"/bin/launchctl kickstart -k system/{label}" for label in labels)


def sudo_plan_script(manifest: dict[str, Any], name: str, result: dict[str, Any], sudoers: bool = False,
                     as_root: bool = False) -> str | None:
    """One bash script with every root step preflight found for the host, or None when there is none.

    By default it runs as the login user and sudo asks once (sudo -v, kept fresh while Homebrew works). as_root is
    for sudo-plan --run --ask-once, which starts the whole script under one sudo: no sudo -v, no keepalive, no sudo
    before a root step, and the Homebrew owner's steps still drop to that owner with sudo -H -u."""
    _, root = planned_actions(result)
    if not root and not sudoers:
        return None
    user = manifest["ssh_user"]
    if as_root and not SAFE_WORD_RE.fullmatch(user):
        raise Failure(f"refusing a root sudo-plan for login user {user!r}")
    node = manifest["hosts"][name].get("node_id") or "no node id"
    when = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    su = "" if as_root else "sudo "
    how = ("# Every step needs root. glaeda-mini-fleet sudo-plan --run --ask-once runs it as root with one sudo."
           if as_root else f"# Every step needs root. Run it on the host as {user}; sudo asks for the password once.")
    lines = ["#!/bin/bash",
             f"# glaeda-mini-fleet sudo-plan for {name} ({node}), from preflight at {when}.",
             how,
             "set -euo pipefail",
             "cd /",
             "step() { printf '\\n== %s\\n' \"$*\"; }",
             # Where fix staged Homebrew bottles (brew_commands): the login user's home, not root's.
             *([f"login_home=~{user}",
                # A NOPASSWD sudo leaves the password line unread on stdin; no step may read it.
                "exec </dev/null"] if as_root else []),
             "# Nothing runs while another build holds the fleet host lock or the host is reserved.",
             host_gate_block().rstrip("\n"),
             f'if why=$(host_held); then echo "held: $why, skipped"; exit {HELD_EXIT}; fi']
    if as_root:
        lines.append('[ "$(id -u)" = 0 ] || { echo "this plan runs as root (sudo-plan --run --ask-once)" >&2; exit 1; }')
    else:
        lines += ["sudo -v",
                  "# Keep sudo's timestamp fresh while Homebrew works; the loop ends with this script.",
                  "( while sleep 60; do sudo -n -v 2>/dev/null || exit 0; done ) &",
                  "keepalive=$!",
                  "trap 'kill \"$keepalive\" 2>/dev/null || true' EXIT"]
    for action in root:
        kind = action["kind"]
        if kind == "select":
            lines += [f"step 'select {action['app']}'", f"{su}xcode-select -s {shlex.quote(action['app'])}"]
        elif kind == "licence":
            lines += ["step 'accept the Xcode licence'",
                      f"{su}env DEVELOPER_DIR={shlex.quote(action['developer'])} xcodebuild -license accept"]
        elif kind == "first_launch":
            lines += ["step 'Xcode first launch'",
                      f"{su}env DEVELOPER_DIR={shlex.quote(action['developer'])} xcodebuild -runFirstLaunch"]
        elif kind == "power":
            lines.append("step 'power: no sleep on AC, restart after a power failure'")
            lines += [f"{su}pmset -c sleep 0"] if action["sleep"] else []
            lines += [f"{su}pmset -a autorestart 1"] if action["autorestart"] else []
        elif kind == "autoupdate":
            lines.append("step 'macOS updates: no automatic download or install (checks and security data stay on)'")
            lines += [f"{su}defaults write /Library/Preferences/com.apple.SoftwareUpdate {key} -bool false"
                      for key in ("AutomaticallyInstallMacOSUpdates", "AutomaticDownload")]
        elif kind == "homebrew":
            # Only the directory needs root. fix then git-fetches Homebrew into it as the login user; the brew.sh
            # installer is not used because it stalls on a Command Line Tools install the pinned Xcode makes moot.
            owner = action["user"]
            if not SAFE_WORD_RE.fullmatch(owner):
                raise Failure(f"{name}: refusing to chown /opt/homebrew to {owner!r}")
            lines += [f"step 'create /opt/homebrew for {owner}; glaeda-mini-fleet fix fetches Homebrew into it'",
                      "if [ ! -x /opt/homebrew/bin/brew ]; then",
                      f"  [ -d /opt/homebrew ] || {su}mkdir /opt/homebrew",
                      # As root: the login user may not be able to read into someone else's directory.
                      f'  if [ -n "$({su}find /opt/homebrew -mindepth 1 -not -type d | head -1)" ]; then',
                      "    echo '/opt/homebrew has files but no brew; move it aside first' >&2; exit 1",
                      "  fi",
                      f"  {su}chown -R {owner}:admin /opt/homebrew",
                      "fi"]
        elif kind == "brew":
            pinned = [f for f in action["formulas"] if f in BREW_FORMULAS]
            pin = f", then pin {' '.join(pinned)}" if pinned else ""
            lines.append(f"step 'Homebrew as {action['owner']}: {' '.join(action['formulas'])}{pin}'")
            lines += brew_commands(action["owner"], action["formulas"], True, as_root)
        elif kind == "python_link":
            lines.append(f"step 'as {action['owner']}: link /opt/homebrew/bin/python3 to {BREW_PYTHON[1]}'")
            lines += python_link_commands(action["owner"], True)
    rule = sudoers_rule(manifest, name) if sudoers else None
    if sudoers and rule is None:
        lines.append("# --sudoers: the manifest declares no launchd jobs, so there is no rule to install.")
    if rule:
        lines += ["# xcode-select and xcodebuild -runFirstLaunch stay password steps: /Applications is writable by the",
                  "# admin group, so a NOPASSWD path rule for either would be passwordless root for this user.",
                  f"step 'sudoers rule {SUDOERS_FILE}'",
                  'rule=$(mktemp)',
                  "cat > \"$rule\" <<'SUDOERS'",
                  f"# glaeda-mini-fleet: {user} may run exactly these as root without a password.",
                  rule,
                  "SUDOERS",
                  f'{su}visudo -cf "$rule"',
                  f'{su}install -m 0440 -o root -g wheel "$rule" {SUDOERS_FILE}',
                  'rm -f "$rule"']
    update = result["checks"].get("update", {})
    if update.get("state") == "fail" and update.get("group") == "password":
        lines.append(f"# Not run here: {update['detail']}; restart the host when no build is running.")
    lines.append("step 'done; next: glaeda-mini-fleet fix'")
    return "\n".join(lines) + "\n"


# One sudo reads the password from stdin (-S, no prompt, -k so a cached timestamp cannot skip the read).
SUDO_STDIN = "sudo -k -S -p ''"


def sudo_stdin_command(script: str | None = None) -> str:
    """The remote command for sudo-plan --ask-once: `true` to check the password, else the plan as root.

    The password is the only thing on stdin; the plan goes in argv, as `ssh -t` sends it, so no step that
    reads stdin can swallow the script, and the password is never in argv or on a tty (ssh -T, so a RequestTTY
    config cannot allocate one to echo it)."""
    return f"{SUDO_STDIN} " + ("true" if script is None else "/bin/bash -c " + shlex.quote(script))


def run_ask_once(manifest: dict[str, Any], plans: dict[str, str]) -> list[str]:
    """Read the password once, check it on every host before any plan runs, then run each plan as root.

    Returns the hosts whose plan failed; a rejected password stops everything (Failure) with nothing run."""
    user = manifest["ssh_user"]
    password = getpass.getpass(f"sudo password for {user} on {', '.join(plans)}: ")
    feed = (password + "\n").encode()
    broken = "\n" in password or "\r" in password
    del password
    try:
        if broken:
            raise Failure("the password has a line break; sudo -S reads one line")
        for name in plans:
            check = subprocess.run([SSH, "-T", "-o", "ConnectTimeout=10", "-l", user, name, sudo_stdin_command()],
                                   input=feed, capture_output=True, check=False)
            if check.returncode:
                raise Failure(f"{name}: sudo refused the password (or the host is unreachable, exit "
                              f"{check.returncode}); no plan ran")
        failed = []
        for name, script in plans.items():
            print(f"\n==== {name}: running as root with the password given once", flush=True)
            code = subprocess.run([SSH, "-T", "-o", "ConnectTimeout=10", "-l", user, name, sudo_stdin_command(script)],
                                  input=feed, check=False).returncode
            if code:
                failed.append(name)
                print(f"==== {name}: exit {code}" + (" (held, skipped)" if code == HELD_EXIT else ""))
        return failed
    finally:
        del feed


def cmd_sudo_plan(manifest: dict[str, Any], hosts: list[str], run: bool, sudoers: bool, log_dir: Path | None,
                  wait: bool = False, ask_once: bool = False) -> int:
    targets, skipped = eligible_hosts(manifest, hosts)
    if ask_once and not run:
        raise Failure("--ask-once goes with sudo-plan --run")
    if run and not sys.stdin.isatty():
        raise Failure("sudo-plan --run asks for each host's password; run it from a terminal")
    held = gate_hosts(manifest, targets, wait) if run else {}
    skipped.update({h: f"held: {why}" for h, why in held.items()})
    targets = [h for h in targets if h not in held]
    results = preflight(manifest, observe(manifest, targets, preflight=True), targets)
    directory = run_log_dir("sudo-plan", log_dir)
    plans: dict[str, str] = {}
    for result in results:
        name = result["host"]
        if "reach" in result["checks"]:
            print(f"# {name}: unreachable ({result['checks']['reach']['detail']})")
            continue
        script = sudo_plan_script(manifest, name, result, sudoers, as_root=ask_once)
        if script is None:
            print(f"# {name}: no root steps")
            continue
        plans[name] = script
        path = directory / f"{name}.sudo-plan.sh"
        path.write_text(script)
        path.chmod(0o600)
        print(f"# ---- {name} ({path})\n{script}")
    for name, why in skipped.items():
        print(f"# {name}: skipped ({why})")
    if not plans:
        return 1 if held else 0
    if not run:
        print(f"# Review, then: glaeda-mini-fleet sudo-plan {' '.join(plans)} --run{' --sudoers' if sudoers else ''}")
        return 0
    failed = run_ask_once(manifest, plans) if ask_once else []
    for name, script in ({} if ask_once else plans).items():
        print(f"\n==== {name}: running over ssh -t; type the password for {manifest['ssh_user']}@{name}", flush=True)
        code = subprocess.run([SSH, "-t", "-o", "ConnectTimeout=10", "-l", manifest["ssh_user"], name,
                               "/bin/bash -c " + shlex.quote(script)], check=False).returncode
        if code:
            failed.append(name)
            print(f"==== {name}: exit {code}" + (" (held, skipped)" if code == HELD_EXIT else ""))
    print("\nfresh preflight:")
    print(render_preflight(preflight(manifest, observe(manifest, list(plans), preflight=True), list(plans))))
    return 1 if failed or held else 0


# ---------------------------------------------------------------- share (LAN seeding)

SHARE_THINGS = ("xcode", "metal", "brew", "rustup", "candidate", "python")
SHARE_TIMEOUT = 3 * 3600
SEED_STREAMS_PER_SOURCE = 2
SEED_STREAMS: dict[str, threading.Semaphore] = {}
SEED_STREAMS_LOCK = threading.Lock()
IPV4_RE = re.compile(r"(\d{1,3}\.){3}\d{1,3}\Z")


def share_args(manifest: dict[str, Any], name: str, thing: str) -> list[str]:
    """The arguments cmux_mini_fix.sh's share functions take for THING, from the manifest and this Mac."""
    declared = toolchain(manifest, name)
    if thing == "xcode":
        xcode = declared.get("xcode")
        if not xcode:
            raise Failure("share xcode needs toolchain.xcode (app, version, build) in the manifest")
        return [xcode["app"], xcode["version"], xcode["build"]]
    if thing == "metal":
        pin = xcode_pin(manifest, name)
        if not pin:
            raise Failure("share metal needs the pinned Xcode (toolchain.xcode) in the manifest")
        return [f"{pin}/Contents/Developer"]
    if thing == "candidate":
        candidate = operator_candidate()
        if not {"source", "sha256"} <= set(candidate):
            raise Failure(f"share candidate: {NO_CANDIDATE}")
        return [candidate["source"][:12], candidate_archive_name(candidate), candidate["sha256"]]
    if thing == "python":
        return [declared.get("python_min") or ENROLL_PYTHON_MIN]
    return []


def lan_settings(manifest: dict[str, Any]) -> dict[str, Any]:
    lan = manifest.get("lan") or {}
    auth = lan.get("auth", "agent")
    return {"subnet": lan.get("subnet"), "agent": auth == "agent",
            "identity": None if auth == "agent" else auth["identity_file"]}


def lan_address(manifest: dict[str, Any], name: str, log: Any) -> tuple[str | None, str]:
    """The peer's LAN IPv4 (manifest lan_ip, else its en0), checked against the manifest's LAN subnet."""
    address = manifest["hosts"][name].get("lan_ip")
    if not address:
        try:
            proc = subprocess.run([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-l", manifest["ssh_user"], name,
                                   "ipconfig getifaddr en0"], capture_output=True, text=True, timeout=30, check=False)
            address = proc.stdout.strip()
        except subprocess.TimeoutExpired:
            address = ""
    subnet = lan_settings(manifest)["subnet"]
    if not IPV4_RE.fullmatch(address or ""):
        return None, f"{name} has no LAN address on en0; set hosts.{name}.lan_ip"
    if subnet and not address.startswith(subnet):
        return None, f"{name} en0 is {address}, outside the fleet LAN {subnet}; set hosts.{name}.lan_ip"
    note(log, f"{name} LAN address {address}")
    return address, address


def share_one(manifest: dict[str, Any], thing: str, source: str, name: str, args: list[str], log: Any,
              yes: bool) -> tuple[bool, str]:
    """Copy THING from source to one peer straight over the LAN. Without yes, only say what would run."""
    user = manifest["ssh_user"]
    have = ssh_stream(name, user, library_command("share_have", [thing, *args]), log, timeout=120)
    if have == 0:
        return True, "already there"
    if have not in (1, 10):
        return False, "refused on the peer (see the log)"
    address, detail = lan_address(manifest, name, log)
    if address is None:
        return False, detail
    lan = lan_settings(manifest)
    route = f"{source} -> {address} ({'ssh -A from this Mac' if lan['agent'] else 'fleet key ' + lan['identity']})"
    if not yes:
        return True, f"would copy over {route}"
    inner = [SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=accept-new",
             *(["-i", lan["identity"]] if lan["identity"] else []), "-l", user, address,
             library_command("share_recv", [thing, *args], keep_stdin=True)]
    send = library_command("share_send", [thing, *args])[len("/bin/bash -c "):]
    pipeline = f"set -o pipefail; /bin/bash -c {send} | {shlex.join(inner)}"
    note(log, f"== share {thing}: {route}")
    with SEED_STREAMS_LOCK:
        streams = SEED_STREAMS.setdefault(source, threading.Semaphore(SEED_STREAMS_PER_SOURCE))
    with streams:  # fix and onboard run many peers at once; one source serves a few at a time
        code = ssh_stream(source, user, "/bin/bash -c " + shlex.quote(pipeline), log, timeout=SHARE_TIMEOUT,
                          options=("-A",) if lan["agent"] else ())
    if code:
        return False, f"copy failed (exit {code}); rerun to resume, the staged part stays on the peer"
    if ssh_stream(name, user, library_command("share_finish", [thing, *args]), log, timeout=3600):
        return False, "the copy did not finish or verify on the peer (see the log)"
    return True, f"copied over {route}"


def cmd_share(manifest: dict[str, Any], thing: str, source: str | None, hosts: list[str], yes: bool, jobs: int,
              log_dir: Path | None, wait: bool = False) -> int:
    if thing not in SHARE_THINGS:
        raise Failure(f"share what? one of {', '.join(SHARE_THINGS)}")
    if not source:
        raise Failure("share needs --from HOST, a prepared host that has it")
    select_hosts(manifest, [source])
    targets, skipped = eligible_hosts(manifest, [h for h in hosts if h != source])
    if not targets:
        raise Failure("share needs at least one destination host besides --from")
    held = gate_hosts(manifest, [source, *targets], wait) if yes else {}
    if source in held:
        raise Failure(f"{source} is held ({held[source]}); nothing was copied")
    skipped.update({h: f"held: {why}" for h, why in held.items()})
    targets = [h for h in targets if h not in held]
    directory = run_log_dir(f"share-{thing}", log_dir)
    args = {h: share_args(manifest, h, thing) for h in [source, *targets]}
    with open(directory / f"{source}.source.log", "ab") as log:
        problem = prepare_seed(manifest, source, thing, log, yes)
        if problem:
            raise Failure(f"{source} cannot seed {thing}: {problem}; see {directory / (source + '.source.log')}")

    def one(name: str) -> tuple[str, bool, str]:
        with open(directory / f"{name}.log", "ab") as log:
            ok, detail = share_one(manifest, thing, source, name, args[name], log, yes)
        say(f"{name}: {'ok' if ok else 'FAILED'} {detail}")
        return name, ok, detail

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, jobs)) as pool:
        outcomes = list(pool.map(one, targets))
    for name, why in skipped.items():
        print(f"{name}: skipped ({why})")
    print(f"logs: {directory}")
    if not yes:
        print("dry run; pass --yes to copy")
    return 1 if any(not ok for _, ok, _ in outcomes) or held else 0


SEED_LOCK = threading.Lock()
SEEDS_READY: dict[tuple[str, str, bool], str | None] = {}


def prepare_seed(manifest: dict[str, Any], source: str, thing: str, log: Any, yes: bool = True) -> str | None:
    """Ready THING on the source once per run (a Metal export downloads there); None when it can seed.

    A dry run only checks: for metal, that the source has a working Metal toolchain to export."""
    with SEED_LOCK:
        key = (source, thing, yes)
        if key not in SEEDS_READY:
            func = "share_prepare" if yes else ("share_have" if thing == "metal" else "share_source")
            code = ssh_stream(source, manifest["ssh_user"],
                              library_command(func, [thing, *share_args(manifest, source, thing)]), log,
                              timeout=SHARE_TIMEOUT)
            if code:
                return f"{func} {thing} exit {code}"  # not cached: a later round may succeed
            SEEDS_READY[key] = None
        return SEEDS_READY[key]


# ---------------------------------------------------------------- onboard, repair and upgrade

HEARTBEAT_SECONDS = 30
ENROLL_TIMEOUT = 3 * 3600
# How long a renewal waits for a runner's current job before giving up (cmux jobs time out at 35 minutes).
RUNNER_DRAIN_SECONDS = 40 * 60
EXPORT_TIMEOUT = 900
RUNNER_HOOK_NOTE = ("runner registration is not wired into glaeda-mini-fleet yet (glaeda#1174); "
                    "glaeda-cmux-runner --apply registers one by hand")
# glaeda-mini-enroll's --fleet-class rule: the manifest hardware key a class receipt names.
FLEET_CLASS_RE = re.compile(r"[a-z][a-z0-9-]{0,31}\Z")
DIFFERS_RE = re.compile(r"Differs in: (.+)")


def compile_lane_class(manifest: dict[str, Any], name: str) -> bool:
    """Whether the host's class may take the app compile (a 16 GB `light` class sets compile_lane: false)."""
    return manifest["hardware"][manifest["hosts"][name]["hardware"]].get("compile_lane", True) is not False


def class_acceptance(manifest: dict[str, Any], name: str) -> tuple[dict[str, Any] | None, str]:
    """The class-level acceptance the host joins on, if the manifest records one for its Xcode build and candidate."""
    klass = manifest["hosts"][name]["hardware"]
    recorded = manifest["hardware"][klass].get("acceptance")
    build = (toolchain(manifest, name).get("xcode") or {}).get("build")
    source12 = operator_candidate().get("source", "")[:12]
    if not recorded:
        return None, f"class {klass} has no recorded acceptance"
    if recorded.get("xcode_build") != build or recorded.get("candidate") != source12:
        return None, (f"class {klass} was accepted on Xcode {recorded.get('xcode_build')} and candidate "
                      f"{recorded.get('candidate')}, not {build} and {source12 or 'none'}")
    return recorded, f"class {klass} accepted on {recorded.get('node')} (Xcode {build}, candidate {source12})"


def class_receipt_bytes(recorded: dict[str, Any], klass: str) -> tuple[bytes | None, str]:
    """The class acceptance receipt a host of `klass` is sent, checked against the recorded digest."""
    path = Path(str(recorded["receipt"])).expanduser()
    try:
        data = path.read_bytes()
        doc = json.loads(data)
    except (OSError, ValueError) as error:
        return None, f"class {klass} receipt {path}: {error}"
    # The host recomputes the digest over the content; this only catches the wrong file early.
    if not isinstance(doc, dict) or doc.get("receiptSha256") != recorded["receipt_sha256"] or doc.get("fleetClass") != klass:
        return None, f"class {klass} receipt {path} is not the recorded {recorded['receipt_sha256'][:19]} for class {klass}"
    return data, "ok"


def onboard_hosts(manifest: dict[str, Any], wanted: list[str] | None) -> tuple[list[str], dict[str, str]]:
    """Hosts onboard, repair and upgrade work on, and why every other named or default host is skipped."""
    names = select_hosts(manifest, wanted)
    skipped: dict[str, str] = {}
    for name in names:
        host = manifest["hosts"][name]
        if not host.get("node_id"):
            skipped[name] = "no node_id in the manifest"
        elif not compile_lane_class(manifest, name):
            skipped[name] = f"hardware {host['hardware']} does not take the app compile (compile_lane: false)"
        elif host.get("overrides", {}).get("apply") is False:
            skipped[name] = "apply: false"
    if not wanted:  # the default set names only hosts that could join
        skipped = {h: why for h, why in skipped.items() if why == "apply: false"}
        names = [h for h in names if manifest["hosts"][h].get("node_id") and compile_lane_class(manifest, h)]
    return [h for h in names if h not in skipped], skipped


def remote_word(value: str) -> str:
    """One shell word for the host; a leading ~/ still expands there."""
    return shlex.quote(value).replace("'~/", "~/'", 1) if value.startswith("~/") else shlex.quote(value)


def host_python(result: dict[str, Any]) -> str:
    return result["checks"]["python"]["detail"].split(" at ", 1)[1]


def enroll_command(manifest: dict[str, Any], name: str, result: dict[str, Any], candidate: dict[str, str],
                   no_accept: bool, class_receipt: tuple[str, str] | None = None, renew: bool = False) -> str:
    """glaeda-mini-enroll on the host. class_receipt (class, receipt_sha256): the receipt arrives on stdin.

    renew: an enrolled node is quarantined, renewed onto the candidate and accepted again when it needs to be."""
    checkout = cmux_checkout(manifest, name)
    archive = f"~/Library/Caches/cmux-fleet/glaeda-candidate-{candidate['source'][:12]}/{candidate_archive_name(candidate)}"
    argv = [host_python(result), "~/glaeda/scripts/glaeda-mini-enroll", "--cmux-root", checkout["root"],
            "--node-id", manifest["hosts"][name]["node_id"], "--candidate", archive, "--sha256", candidate["sha256"],
            "--source", candidate["source"], "--apply"]
    if renew:
        argv.append("--renew")
    if class_receipt:
        argv += ["--class-receipt", "-", "--class-receipt-sha256", class_receipt[1], "--fleet-class", class_receipt[0]]
    elif no_accept:
        argv.append("--no-accept")
    return (f"export PATH={shlex.quote(bootstrap.CMUX_WORKLOAD_TOOL_PATH)}:\"$HOME/.local/bin\"; cd \"$HOME\" && "
            + " ".join(remote_word(a) for a in argv))


def export_command(manifest: dict[str, Any], name: str, result: dict[str, Any], candidate: dict[str, str],
                   klass: str) -> str:
    """cmux_fleet.py export-class-acceptance from the candidate's own generation on the seed; read-only there."""
    root = cmux_checkout(manifest, name)["root"]
    root = root.replace("~/", "$HOME/", 1) if root.startswith("~/") else root
    return (f"export PATH={shlex.quote(bootstrap.CMUX_WORKLOAD_TOOL_PATH)}:\"$HOME/.local/bin\"; cd \"$HOME\" && "
            f"F=\"${{XDG_CONFIG_HOME:-$HOME/.config}}/glaeda/cmux-fleet\" && "
            f"G=\"$HOME/Projects/glaeda-generations/{candidate['source'][:12]}\" && "
            f"{remote_word(host_python(result))} -B \"$G/scripts/cmux_fleet.py\" export-class-acceptance "
            f"\"$F/enrollment.json\" --acceptance \"$F/acceptance/cmux_macos_native_build.json\" "
            f"--fleet-class {shlex.quote(klass)} --cmux-root \"{root}\" --glaeda \"$G/bin/glaeda\" "
            f"--cache-root \"$HOME/.cache/glaeda/cmux-native-cache\"")


def runner_register_command(manifest: dict[str, Any], name: str) -> str | None:
    """The hook where runner registration plugs in (glaeda#1174): the remote command that registers this
    host's runner, reading a one-hour registration token from stdin, or None while nothing is wired.

    onboard calls it for every eligible host without a runner and mints one org token per run
    (manifest runner.org) for all the hosts it returns a command for. The token never reaches argv or a log."""
    return None


def mint_runner_token(org: str) -> str:
    """A one-hour org runner registration token from this Mac's gh login. Never logged."""
    proc = subprocess.run(["gh", "api", "-X", "POST", f"orgs/{org}/actions/runners/registration-token", "--jq", ".token"],
                          capture_output=True, text=True, timeout=60, check=False)
    token = proc.stdout.strip()
    if proc.returncode or not re.fullmatch(r"[A-Za-z0-9_-]{20,}", token):
        raise Failure(f"could not mint a runner registration token for {org} (gh auth refresh -s admin:org?)")
    return token


def last_line(path: Path) -> str:
    try:
        with path.open("rb") as handle:
            handle.seek(max(0, path.stat().st_size - 4096))
            lines = [line for line in handle.read().decode(errors="replace").splitlines() if line.strip()]
    except OSError:
        return ""
    return (lines[-1].strip() if lines else "")[:100]


def run_with_heartbeat(tasks: dict[str, Any], logs: dict[str, Path], label: str,
                       every: float = HEARTBEAT_SECONDS) -> dict[str, Any]:
    """Run one callable per host in parallel; every `every` seconds print one line per host still running."""
    started = time.monotonic()
    results: dict[str, Any] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, len(tasks))) as pool:
        futures = {pool.submit(task): name for name, task in tasks.items()}
        pending = set(futures)
        while pending:
            done, pending = concurrent.futures.wait(pending, timeout=every)
            for future in done:
                results[futures[future]] = future.result()
            if pending:
                minutes, seconds = divmod(int(time.monotonic() - started), 60)
                running = sorted(futures[f] for f in pending)
                say(f"heartbeat {label} {minutes}m{seconds:02d}s: " +
                    "; ".join(f"{h}: {last_line(logs[h]) or 'running'}" for h in running))
    return results


ROW_COLUMNS = (("host", "host"), ("class", "class"), ("node id", "node"), ("generation", "generation"),
               ("step", "step"), ("result", "result"), ("log", "log"))


def new_row(manifest: dict[str, Any], name: str, result: str = "", step: str = "-") -> dict[str, str]:
    host = manifest["hosts"][name]
    return {"host": name, "class": host.get("hardware") or "", "node": host.get("node_id") or "", "generation": "",
            "step": step, "result": result, "log": ""}


def render_rows(rows: dict[str, dict[str, str]]) -> str:
    """The one table onboard, repair and upgrade end with. generation is the enrollment's Glaeda, old->new."""
    table = [[title for title, _ in ROW_COLUMNS], *([r.get(k) or "-" for _, k in ROW_COLUMNS] for r in rows.values())]
    widths = [max(len(row[i]) for row in table) for i in range(len(ROW_COLUMNS) - 1)]
    return "\n".join("  ".join([*(f"{row[i]:<{widths[i]}}" for i in range(len(widths))), row[-1]]) for row in table)


render_onboard = render_rows


def enrollment_need(result: dict[str, Any]) -> str:
    """What a probed host's enrollment needs: enroll (none yet), renew, ok, leave (an operator drain) or retired."""
    enrollment = result.get("enrollment") or {}
    state = enrollment.get("state")
    if not state:
        return "enroll"
    if state in {"retired", "draining"}:
        return {"retired": "retired", "draining": "leave"}[state]
    if state == "quarantined" and enrollment.get("reason") not in RENEWABLE_REASONS:
        return "leave"
    if state in {"quarantined", "enrolling"} or enrollment.get("stale") or not enrollment.get("accepted"):
        return "renew"
    return "ok"


def adoption_mismatch(log_path: Path) -> list[str]:
    """The fields a refused class adoption names (cmux_fleet.py's `Differs in:`), from the host's log."""
    try:
        text = log_path.read_bytes()[-65536:].decode(errors="replace")
    except OSError:
        return []
    for line in reversed(text.splitlines()):
        try:
            error = json.loads(line).get("error", "")
        except (ValueError, AttributeError):
            continue
        match = DIFFERS_RE.search(error if isinstance(error, str) else "")
        if match:
            return [part.split(" (here", 1)[0].strip() for part in match.group(1).split("; ") if part.strip()]
    return []


def glaeda_target(repo: str | None = None) -> str:
    """The commit ~/glaeda moves to in this run: --glaeda-ref, else main's tip, resolved once and then reused."""
    if GLAEDA_REF:
        return GLAEDA_REF
    repo = repo or operator_candidate().get("repo") or CANDIDATE_REPO
    with GLAEDA_MAIN_LOCK:
        if repo not in GLAEDA_MAIN:
            GLAEDA_MAIN[repo] = resolve_glaeda_main(repo)
        return GLAEDA_MAIN[repo]


def resolve_glaeda_main(repo: str) -> str:
    """The commit every host's ~/glaeda moves to before a renewal: the tip of main, read once per run."""
    proc = subprocess.run(["gh", "api", f"repos/{repo}/commits/main", "--jq", ".sha"], capture_output=True, text=True,
                          timeout=60, check=False)
    sha = proc.stdout.strip()
    if proc.returncode or not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise Failure(f"could not read {repo} main with gh ({proc.stderr.strip()[:160] or 'no sha'})")
    return sha


def held_or(code: int, log_path: Path | None, what: str) -> str:
    """A step's refusal for a row: held (the fleet host lock or a reservation) or what failed."""
    line = last_line(log_path) if log_path else ""
    if code == HELD_EXIT:
        return "held: " + (line.split("held: ", 1)[-1] or "the fleet host lock or a reservation")
    return f"{what}: {line or f'exit {code}'}"


def renew_one(manifest: dict[str, Any], name: str, result: dict[str, Any], candidate: dict[str, str], glaeda_ref: str,
              receipt: tuple[str, str, bytes] | None, log_path: Path, seed: str | None = None) -> tuple[bool, str, str]:
    """Move one enrolled host onto the pinned candidate; (ok, step reached, detail).

    sync: ~/glaeda to glaeda_ref (glaeda-mini-enroll --renew and the staging verifier come from it).
    stage: the candidate archive (from this Mac, or from `seed` over the LAN). drain: its runners stop once
    their current job ends. renew: glaeda-mini-enroll --renew, adopting `receipt` (class, sha256, bytes) or,
    without one, running accept-local. resume: the runners it stopped start again."""
    user = manifest["ssh_user"]
    klass = manifest["hosts"][name]["hardware"]
    with open(log_path, "ab") as log:
        def step(label: str) -> None:
            note(log, f"== {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {label}")

        step(f"sync ~/glaeda to {glaeda_ref[:12]}")
        code = fix_call(name, user, "glaeda_sync", [glaeda_ref, *ENROLL_FLAGS], log, FIX_TIMEOUTS["glaeda_sync"])
        if code:
            return False, "sync", held_or(code, log_path, "could not move ~/glaeda")
        step(f"stage candidate {candidate['source'][:12]}")
        ok, detail = run_repair(manifest, name, {"kind": "candidate", "source12": candidate["source"][:12]}, log, seed)
        if not ok:
            return False, "stage", detail
        step("drain: stop the runners once their current job ends")
        code = fix_call(name, user, "runner_hold", [str(RUNNER_DRAIN_SECONDS)], log, RUNNER_DRAIN_SECONDS + 600)
        if code:
            return False, "drain", held_or(code, log_path, "could not stop the runners")
        command = enroll_command(manifest, name, result, candidate, False, receipt[:2] if receipt else None, renew=True)
        code = fix_call(name, user, "host_check", [], log, 120)  # the drain may have waited long; ask again
        if code:
            fix_call(name, user, "runner_release", ["if-eligible"], log, 300)
            return False, "renew", held_or(code, log_path, "could not check the host lock and reservation")
        step(f"renew ({command})")
        code = ssh_stream(name, user, command, log, stdin=receipt[2] if receipt else b"", timeout=ENROLL_TIMEOUT)
    if code:
        with open(log_path, "ab") as log:
            note(log, "== the renewal failed; start the runners again if the node is still eligible")
            fix_call(name, user, "runner_release", ["if-eligible"], log, 300)
        differs = adoption_mismatch(log_path) if receipt else []
        if differs:
            return False, "renew", (f"quarantined: differs from class {klass} in {', '.join(differs)}. Fix: make those "
                                    f"match the class, then glaeda-mini-fleet repair {name} --yes; or accept it on its "
                                    f"own: glaeda-mini-fleet repair {name} --acceptance node --yes")
        return False, "renew", f"exit {code}: {last_line(log_path)}"
    with open(log_path, "ab") as log:
        note(log, "== resume: start the runners the drain stopped")
        if fix_call(name, user, "runner_release", [], log, 300):
            return False, "resume", f"eligible, but its runner start failed: {last_line(log_path)}"
    return True, "resume", "eligible"


def _enroll_one(manifest: dict[str, Any], name: str, result: dict[str, Any], candidate: dict[str, str],
                no_accept: bool, log_path: Path, class_receipt: tuple[str, str, bytes] | None = None) -> int:
    command = enroll_command(manifest, name, result, candidate, no_accept,
                             class_receipt[:2] if class_receipt else None)
    with open(log_path, "ab") as log:
        # glaeda-mini-enroll takes no step lock, so the host gate is asked right before it.
        code = fix_call(name, manifest["ssh_user"], "host_check", [], log, 120)
        if code:
            return code
        note(log, f"== enroll ({command})")
        return ssh_stream(name, manifest["ssh_user"], command, log, stdin=class_receipt[2] if class_receipt else b"",
                          timeout=ENROLL_TIMEOUT)


def runner_actions(result: dict[str, Any]) -> tuple[list[str], list[str]]:
    """(runners held stopped by a renewal, runners loaded whose listener is not running), by name."""
    runners = result.get("runners") or []
    held = [r["name"] or r["dir"] for r in runners if r.get("held") == "yes"]
    down = [r["name"] or r["dir"] for r in runners if r.get("loaded") == "yes" and r.get("listening") == "no"]
    return held, down


def cmd_onboard(manifest: dict[str, Any], wanted: list[str] | None, yes: bool, sudo: str, acceptance: str,
                seed: str | None, log_dir: Path | None, heartbeat: float = HEARTBEAT_SECONDS, mode: str = "onboard",
                wait: bool = False) -> int:
    """onboard and repair: one pipeline. preflight, fix, sudo-plans, fix again, then the enrollment and runners.

    onboard enrolls a host that has no enrollment yet; repair leaves it (onboard's job). Both renew an
    enrolled host that is stale, quarantined or not accepted onto the pinned candidate (re-adopting its
    class receipt), start runners a renewal held, and restart a loaded runner whose listener is gone."""
    if yes and sudo == "run" and not sys.stdin.isatty():
        raise Failure(f"{mode} --sudo run asks for each host's password; run it from a terminal")
    targets, skipped = onboard_hosts(manifest, wanted)
    rows = {h: new_row(manifest, h, f"skipped: {why}") for h, why in skipped.items()}
    # A held host (another build's fleet host lock, or a reservation) is skipped, and the run exits 1.
    held = gate_hosts(manifest, targets, wait and yes)
    rows.update({h: new_row(manifest, h, f"held: {why}, skipped", step="gate") for h, why in held.items()})
    targets = [h for h in targets if h not in held]
    for name in targets:
        rows[name] = new_row(manifest, name, step="preflight")
    if seed:
        select_hosts(manifest, [seed])
    directory = run_log_dir(mode, log_dir) if yes else None
    live = list(targets)

    def settle(name: str, step: str, result: str) -> None:
        rows[name].update(step=step, result=result)
        if name in live:
            live.remove(name)

    def probe(names: list[str]) -> dict[str, dict[str, Any]]:
        return {r["host"]: r for r in preflight(manifest, observe(manifest, names, preflight=True), names)} if names else {}

    def blockers(result: dict[str, Any], groups: tuple[str, ...]) -> list[str]:
        return [c for c, v in result["checks"].items()
                if v["state"] == "fail" and (v["group"] or "person") in groups]

    results = probe(live)
    for name in list(live):
        if "reach" in results[name]["checks"]:
            settle(name, "preflight", f"unreachable: {results[name]['checks']['reach']['detail']}")
            continue
        rows[name]["generation"] = short_generation(results[name]["enrollment"]["generation"]) \
            if results[name]["enrollment"]["generation"] else ""
        if blockers(results[name], ("person",)):
            settle(name, "preflight", "needs a person: " + ", ".join(blockers(results[name], ("person",))))
    needs = {h: enrollment_need(results[h]) for h in live}
    for name in list(live):
        if needs[name] == "enroll" and mode == "repair":
            settle(name, "enroll", f"not enrolled: glaeda-mini-fleet onboard {name} --yes")
    candidate = operator_candidate()
    receipts: dict[str, tuple[str, str, bytes]] = {}  # host: (class, receipt_sha256, receipt bytes)
    if acceptance == "class":
        for name in list(live):
            if needs[name] not in {"enroll", "renew"}:
                continue
            recorded, why = class_acceptance(manifest, name)
            klass = manifest["hosts"][name]["hardware"]  # the key the acceptance is recorded under
            if recorded is None:
                if needs[name] == "enroll":
                    settle(name, "preflight", f"blocked: {why}; accept one host of the class first "
                                              f"(onboard {name} --acceptance node --yes)")
                else:
                    settle(name, "enroll", f"blocked: {why}; glaeda-mini-fleet upgrade records it "
                                           f"(or {mode} {name} --acceptance node --yes)")
            elif "receipt" in recorded:
                data, why = class_receipt_bytes(recorded, klass)
                if data is None:
                    settle(name, "preflight", f"blocked: {why}")
                else:
                    receipts[name] = (klass, recorded["receipt_sha256"], data)
            elif needs[name] == "renew":
                settle(name, "enroll", f"blocked: class {klass} records no receipt file; glaeda-mini-fleet upgrade "
                                       "records one")

    if not yes:
        for name in live:
            mine, root = planned_actions(results[name])
            parts = [f"fix {len(mine)}"] if mine else []
            parts += [f"sudo-plan {', '.join(c for a in root for c in a['checks'])}"] if root else []
            if needs[name] == "enroll":
                parts.append("enroll" + (" on the class receipt" if name in receipts else
                                         " without acceptance (class)" if acceptance == "class" else " with acceptance"))
            elif needs[name] == "renew":
                parts.append("renew and " + ("adopt the class receipt" if name in receipts else "accept-local"))
            elif needs[name] == "leave":
                parts.append("leave the draining node")
            held, down = runner_actions(results[name])
            parts += ["start held runner"] if held else []
            parts += ["restart runner"] if down else []
            if not (results[name].get("runners") or []) and runner_register_command(manifest, name) is not None:
                parts.append("register")
            rows[name]["result"] = "would: " + (", ".join(parts) or f"nothing, already {'onboarded' if mode == 'onboard' else 'healthy'}")
        print(render_rows(rows))
        print(f"dry run; pass --yes to {mode}")
        return 0

    assert directory is not None
    for name in targets:
        rows[name]["log"] = os.fspath(directory / f"{name}.log")

    def fix_round(names: list[str]) -> None:
        # The seed is fixed first and alone: its step lock would refuse share_prepare while it is busy.
        outcomes = [fix_host(manifest, seed, results[seed], True, directory, None)] if seed in names else []
        peers = [h for h in names if h != seed]
        with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
            outcomes += list(pool.map(lambda h: fix_host(manifest, h, results[h], True, directory, seed), peers))
        for outcome in outcomes:
            if outcome["failed"]:
                settle(outcome["host"], "fix", "failed: " + "; ".join(outcome["failed"])[:160])

    fix_round(list(live))
    results.update(probe(list(live)))
    plans = {h: s for h in live if (s := sudo_plan_script(manifest, h, results[h])) is not None}
    if plans:
        for name, script in plans.items():
            path = directory / f"{name}.sudo-plan.sh"
            path.write_text(script)
            path.chmod(0o600)
        if sudo == "run":
            for name, script in plans.items():
                print(f"\n==== {name}: sudo-plan over ssh -t; type the password for {manifest['ssh_user']}@{name}", flush=True)
                code = subprocess.run([SSH, "-t", "-o", "ConnectTimeout=10", "-l", manifest["ssh_user"], name,
                                       "/bin/bash -c " + shlex.quote(script)], check=False).returncode
                if code:
                    settle(name, "sudo-plan", "held, skipped (see the plan's output)" if code == HELD_EXIT
                           else f"failed: exit {code}")
        elif sudo == "wait" and sys.stdin.isatty():
            print(f"\nRoot steps are needed on {', '.join(plans)}. Review the plans in {directory}, then run:\n"
                  f"  glaeda-mini-fleet sudo-plan {' '.join(plans)} --run\nPress Enter here when they are done.", flush=True)
            input()
        else:
            for name in plans:
                settle(name, "sudo-plan", f"waiting: glaeda-mini-fleet sudo-plan {name} --run, then {mode} again")
        fix_round([h for h in live if h in plans])
        results.update(probe([h for h in live if h in plans]))
    for name in list(live):
        failing = blockers(results[name], ("self", "password", "person"))
        if failing or not results[name]["ready"]:
            settle(name, "preflight", "not ready: " + ", ".join(failing or ["unknown checks"]))

    # Enroll new hosts and renew stale ones, all at once; node acceptance only when asked for.
    fresh = [h for h in live if needs[h] == "enroll"]
    stale = [h for h in live if needs[h] == "renew"]
    if (fresh or stale) and not {"source", "sha256"} <= set(candidate):
        for name in fresh + stale:
            settle(name, "enroll", f"blocked: {NO_CANDIDATE}")
        fresh, stale = [], []
    glaeda_ref = None
    if stale:
        try:
            glaeda_ref = glaeda_target(candidate.get("repo") or CANDIDATE_REPO)
        except Failure as error:
            for name in stale:
                settle(name, "sync", f"blocked: {error}")
            stale = []
    logs = {h: directory / f"{h}.log" for h in fresh + stale}

    def enroll_task(name: str) -> Any:
        if name in fresh:
            return lambda: _enroll_one(manifest, name, results[name], candidate, acceptance == "class", logs[name],
                                       receipts.get(name))
        return lambda: renew_one(manifest, name, results[name], candidate, glaeda_ref, receipts.get(name),
                                 logs[name], seed)

    outcomes = run_with_heartbeat({h: enroll_task(h) for h in fresh + stale}, logs, "enroll", heartbeat) \
        if fresh or stale else {}
    for name, outcome in outcomes.items():
        if name in stale:
            ok, step, detail = outcome
            if ok:
                rows[name].update(step="renew", result="eligible")
            else:
                settle(name, step, detail if detail.startswith("held:") else f"failed: {detail}")
        elif outcome == HELD_EXIT:
            settle(name, "enroll", f"held: {last_line(logs[name]).split('held: ', 1)[-1]}")
        elif outcome:
            settle(name, "enroll", f"failed: exit {outcome}")
        elif acceptance == "class" and name not in receipts:
            settle(name, "enroll", "enrolled without node acceptance; record the class receipt "
                                   "(hardware.<key>.acceptance.receipt) to make it eligible")
        else:
            rows[name].update(step="enroll", result="eligible")

    # Runners: start the ones a renewal held, restart a loaded one whose listener is gone, and hand hosts
    # without one to the registration hook.
    after = probe(list(live))
    to_register = []
    for name in list(live):
        result = after[name]
        if "reach" in result["checks"]:
            settle(name, "runner", f"unreachable after {rows[name]['step']}: {result['checks']['reach']['detail']}")
            continue
        new = result["enrollment"]["generation"]
        if new and short_generation(new) != rows[name]["generation"]:
            rows[name]["generation"] = f"{rows[name]['generation'] or '-'}->{short_generation(new)}"
        eligible = enrollment_need(result) == "ok"
        serving = result["enrollment"]["state"] == "eligible"  # held runners go back even on an older candidate
        if not rows[name]["result"]:  # nothing to enroll or renew here
            rows[name].update(step="enroll", result="ok: eligible" if eligible else
                              f"ok: {result['checks']['enroll']['detail']}")
        held, down = runner_actions(result)
        with open(logs.get(name) or directory / f"{name}.log", "ab") as log:
            if held and serving:
                code = fix_call(name, manifest["ssh_user"], "runner_release", [], log, 300)
                rows[name].update(step="runner", result=rows[name]["result"] + ("; runner started" if code == 0 else
                                                                                 "; runner start failed (see the log)"))
            elif held:
                rows[name]["result"] += "; runner held until the node is eligible"
            if down:
                code = fix_call(name, manifest["ssh_user"], "runner_kick", [], log, 120)
                rows[name].update(step="runner", result=rows[name]["result"] + ("; runner restarted" if code == 0 else
                                                                                 "; runner restart failed (see the log)"))
        if not result.get("runners") and eligible:
            if mode == "onboard" and runner_register_command(manifest, name) is not None:
                to_register.append(name)
            else:
                rows[name]["result"] += f"; no runner: {RUNNER_HOOK_NOTE}"
    if to_register:
        register_runners(manifest, to_register, rows, directory, heartbeat)
    print()
    print(render_rows(rows))
    return 0 if all(r["result"].startswith(("ok", "eligible", "skipped")) and "failed" not in r["result"]
                    for r in rows.values()) else 1


def register_runners(manifest: dict[str, Any], names: list[str], rows: dict[str, dict[str, str]], directory: Path,
                     heartbeat: float) -> None:
    """Run the registration hook's command on each host, with one org token minted here and sent on stdin."""
    org = (manifest.get("runner") or {}).get("org")
    if not org:
        for name in names:
            rows[name]["result"] += "; not registered: the manifest has no runner.org"
        return
    try:
        token = mint_runner_token(org)
    except Failure as error:
        for name in names:
            rows[name]["result"] += f"; not registered: {error}"
        return
    logs = {h: directory / f"{h}.log" for h in names}

    def register_task(name: str) -> Any:
        def run() -> int:
            command = runner_register_command(manifest, name) or "false"
            with open(logs[name], "ab") as log:
                note(log, f"== register ({command})")
                return ssh_stream(name, manifest["ssh_user"], command, log, stdin=(token + "\n").encode(), timeout=1800)
        return run

    for name, code in run_with_heartbeat({h: register_task(h) for h in names}, logs, "register", heartbeat).items():
        rows[name].update(step="register", result=rows[name]["result"] + ("; registered" if code == 0 else
                                                                           f"; registration failed: exit {code}"))


# ---- upgrade: a new candidate, one accept-local per class, class adoption everywhere else


def gh_json(args: list[str]) -> Any:
    proc = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=120, check=False)
    if proc.returncode:
        raise Failure(f"gh {' '.join(args[:3])}: {proc.stderr.strip()[:200] or f'exit {proc.returncode}'}")
    try:
        return json.loads(proc.stdout)
    except ValueError:
        raise Failure(f"gh {' '.join(args[:3])} printed no JSON") from None


def resolve_candidate_run(run: str, repo: str, sha256: str | None) -> dict[str, str]:
    """The candidate a fleet-candidate.yml run built, after checking the run is a reviewed install source.

    The run must be the `Fleet candidate bundles` workflow, dispatched (a pull request run is a build test,
    docs/FLEET_DISTRIBUTION.md), completed successfully, from a commit on main, with an unexpired macOS artifact."""
    if not re.fullmatch(r"[0-9]+", run):
        raise Failure(f"--candidate-run {run!r} is not a run id")
    if sha256 is not None and not re.fullmatch(r"[0-9a-f]{64}", sha256):
        raise Failure("--candidate-sha256 is the archive's 64-hex sha256 from the run's summary")
    view = gh_json(["run", "view", run, "--repo", repo, "--json", "headSha,event,status,conclusion,workflowName"])
    problems = []
    if view.get("workflowName") != CANDIDATE_WORKFLOW:
        problems.append(f"workflow {view.get('workflowName')!r}, not {CANDIDATE_WORKFLOW!r}")
    if view.get("event") != "workflow_dispatch":
        problems.append(f"event {view.get('event')}; only a dispatched run is an install source")
    if (view.get("status"), view.get("conclusion")) != ("completed", "success"):
        problems.append(f"{view.get('status')}/{view.get('conclusion')}, not completed/success")
    source = str(view.get("headSha") or "")
    if not re.fullmatch(r"[0-9a-f]{40}", source):
        problems.append("no source commit")
    if problems:
        raise Failure(f"run {run} is not a reviewed candidate: " + "; ".join(problems))
    status = gh_json(["api", f"repos/{repo}/compare/main...{source}", "--jq", "{status: .status}"]).get("status")
    if status not in {"identical", "behind"}:
        raise Failure(f"candidate source {source[:12]} is not on {repo} main (compare says {status})")
    artifacts = gh_json(["api", f"repos/{repo}/actions/runs/{run}/artifacts",
                         "--jq", "[.artifacts[] | {name, expired, expires_at}]"])
    artifact = next((a for a in artifacts if a.get("name") == CANDIDATE_ARTIFACT), None)
    if artifact is None or artifact.get("expired"):
        raise Failure(f"run {run} has no unexpired {CANDIDATE_ARTIFACT}; dispatch fleet-candidate.yml again")
    out = {"source": source, "run": run, "artifact": CANDIDATE_ARTIFACT, "repo": repo,
           "expires": str(artifact.get("expires_at") or "")}
    if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", out["expires"]):
        del out["expires"]
    if sha256:
        out["sha256"] = sha256
    return out


def download_run_candidate(candidate: dict[str, str], log: Any) -> str:
    """Download the run's macOS candidate once on this Mac; the archive's sha256 after checking it.

    The digest is the receipt the same build job wrote (its receipt.json), for this run's source and
    target, and must equal --candidate-sha256 when that was given. The archive must hash to it."""
    import tempfile
    cache = OPERATOR_CACHE / f"glaeda-candidate-{candidate['source'][:12]}"
    archive = cache / candidate_archive_name(candidate)
    receipt_path = cache / "receipt.json"
    run_path = cache / "run"  # another run of the same source may have built other bytes
    with CANDIDATE_LOCK:
        cache.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=cache) as tmp:
            staged_archive, staged_receipt = archive, receipt_path
            cached_run = run_path.read_text().strip() if run_path.is_file() else None
            if not (archive.is_file() and receipt_path.is_file() and cached_run == candidate["run"]):
                note(log, f"gh run download {candidate['run']} --repo {candidate['repo']} -n {candidate['artifact']}")
                code = run_logged(["gh", "run", "download", candidate["run"], "--repo", candidate["repo"],
                                   "-n", candidate["artifact"], "--dir", tmp], log, timeout=FIX_TIMEOUTS["candidate"])
                staged_archive, staged_receipt = Path(tmp) / archive.name, Path(tmp) / "receipt.json"
                if code or not staged_archive.is_file() or not staged_receipt.is_file():
                    raise Failure(f"gh run download {candidate['run']} failed or has no {archive.name} and receipt.json")
            try:
                receipt = json.loads(staged_receipt.read_text())
            except (OSError, ValueError) as error:
                raise Failure(f"the run's receipt.json: {error}") from None
            want = str(receipt.get("sha256") or "")
            if not (re.fullmatch(r"[0-9a-f]{64}", want) and receipt.get("archive") == archive.name
                    and receipt.get("target") == CANDIDATE_TARGET
                    and (receipt.get("source") or {}).get("commit") == candidate["source"]):
                raise Failure(f"the run's receipt does not describe {archive.name} built from {candidate['source'][:12]}")
            if candidate.get("sha256") and candidate["sha256"] != want:
                raise Failure(f"--candidate-sha256 {candidate['sha256'][:12]} differs from the run's receipt {want[:12]}")
            got = sha256_file(staged_archive)
            if got != want:
                raise Failure(f"the downloaded archive has sha256 {got}, the run's receipt says {want}")
            if staged_archive != archive:
                os.replace(staged_receipt, receipt_path)
                os.replace(staged_archive, archive)
                run_path.write_text(candidate["run"] + "\n")
        note(log, f"candidate {candidate['source'][:12]} sha256 {want} at {archive}")
        return want


def write_private(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as out:
        out.write(data)
    os.replace(tmp, path)


def rewrite_manifest(path: Path, change: Any, write: bool = True) -> str:
    """Apply change(raw) to the manifest file's JSON; the unified diff. Written atomically, and only if it still loads."""
    import difflib
    text = path.read_text()
    raw = json.loads(text)
    change(raw)
    new = json.dumps(raw, indent=2, ensure_ascii=False) + "\n"
    diff = "".join(difflib.unified_diff(text.splitlines(True), new.splitlines(True), os.fspath(path),
                                        os.fspath(path) + " (after upgrade)"))
    if write and new != text:
        tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, path.stat().st_mode & 0o777)
        with os.fdopen(fd, "w") as out:
            out.write(new)
        try:
            load_manifest(tmp)
        except Failure:
            tmp.unlink()
            raise
        os.replace(tmp, path)
    return diff


def candidate_pin(candidate: dict[str, str]) -> dict[str, str]:
    return {k: candidate[k] for k in ("source", "sha256", "run", "artifact", "repo", "expires") if k in candidate}


def class_receipt_path(manifest_path: Path, klass: str, source12: str) -> Path:
    return manifest_path.expanduser().resolve().parent / "class-acceptance" / f"{klass}-{source12}.json"


def acceptance_entry(manifest: dict[str, Any], seed: str, candidate: dict[str, str], receipt: Path,
                     receipt_sha256: str) -> dict[str, str]:
    build = (toolchain(manifest, seed).get("xcode") or {}).get("build")
    if not build:
        raise Failure(f"{seed}: declare toolchain.xcode (app, version, build); class acceptance is recorded per Xcode build")
    return {"xcode_build": build, "candidate": candidate["source"][:12], "node": manifest["hosts"][seed]["node_id"],
            "receipt": os.fspath(receipt), "receipt_sha256": receipt_sha256}


def record_class_acceptance(manifest_path: Path, manifest: dict[str, Any], klass: str, entry: dict[str, str],
                            candidate: dict[str, str], write: bool = True) -> str:
    """hardware.<klass>.acceptance and the fleet's candidate pin, in the operator's manifest file and in memory."""
    def change(raw: dict[str, Any]) -> None:
        table = raw["hardware"] if "hardware" in raw else raw["classes"]  # a manifest from before #1169
        table[klass]["acceptance"] = entry
        raw["candidate"] = candidate_pin(candidate)
    diff = rewrite_manifest(manifest_path, change, write)
    if write:
        manifest["hardware"][klass]["acceptance"] = entry
        manifest["candidate"] = candidate_pin(candidate)
    return diff


def export_class_receipt(manifest: dict[str, Any], name: str, result: dict[str, Any], candidate: dict[str, str],
                         klass: str, log_path: Path) -> bytes:
    """The class receipt the seed exports, checked here before anything records it."""
    import cmux_fleet
    command = export_command(manifest, name, result, candidate, klass)
    with open(log_path, "ab") as log:
        note(log, f"== export ({command})")
        try:
            proc = subprocess.run([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-l", manifest["ssh_user"],
                                   name, command], capture_output=True, timeout=EXPORT_TIMEOUT, check=False)
        except subprocess.TimeoutExpired:
            raise Failure(f"export-class-acceptance on {name} timed out") from None
        log.write(proc.stderr)
        note(log, f"== export exit {proc.returncode}, {len(proc.stdout)} bytes")
    if proc.returncode:
        raise Failure(f"export-class-acceptance on {name} exited {proc.returncode}: {last_line(log_path)}")
    try:
        doc = cmux_fleet.validate_class_acceptance(json.loads(proc.stdout))
    except (ValueError, cmux_fleet.FleetError) as error:
        raise Failure(f"{name} exported an invalid class receipt: {error}") from None
    wrong = [what for what, ok in (("class", doc["fleetClass"] == klass),
                                   ("candidate", doc["glaedaCandidate"]["commit"] == candidate["source"]),
                                   ("node", doc["acceptingNodeId"] == manifest["hosts"][name]["node_id"])) if not ok]
    if wrong:
        raise Failure(f"{name} exported a class receipt for another {', '.join(wrong)}")
    return proc.stdout


def cmd_upgrade(manifest: dict[str, Any], manifest_path: Path, wanted: list[str] | None, run: str, repo: str,
                sha256: str | None, seeds: list[str], yes: bool, share_from: str | None, log_dir: Path | None,
                heartbeat: float = HEARTBEAT_SECONDS, wait: bool = False) -> int:
    """Roll a new candidate over the fleet: one accept-local per class on a seed, then class adoption on the rest."""
    global PINNED_CANDIDATE
    candidate = resolve_candidate_run(run, repo, sha256)
    targets, skipped = onboard_hosts(manifest, wanted)
    chosen: dict[str, str] = {}
    for name in seeds:
        select_hosts(manifest, [name])
        if name not in targets:
            raise Failure(f"--seed-per-class {name} is not one of the hosts upgrade works on")
        klass = manifest["hosts"][name]["hardware"]
        if klass in chosen:
            raise Failure(f"--seed-per-class names two seeds for class {klass}: {chosen[klass]} and {name}")
        chosen[klass] = name
    if share_from:
        select_hosts(manifest, [share_from])
    directory = run_log_dir("upgrade", log_dir) if yes else None
    if yes:
        with open(directory / "operator.log", "ab") as log:
            candidate["sha256"] = download_run_candidate(candidate, log)
    PINNED_CANDIDATE = candidate
    source12 = candidate["source"][:12]
    say(f"candidate {source12} from run {run} ({repo}), sha256 "
        f"{candidate.get('sha256') or 'read from the run receipt at download (--yes)'}, expires {candidate.get('expires', '?')}")

    rows = {h: new_row(manifest, h, f"skipped: {why}") for h, why in skipped.items()}
    held = gate_hosts(manifest, targets, wait and yes)
    for name, why in held.items():
        if name in chosen.values():
            raise Failure(f"--seed-per-class {name} is held ({why}); pick another or pass --wait")
        rows[name] = new_row(manifest, name, f"held: {why}, skipped", step="gate")
    targets = [h for h in targets if h not in held]
    results = {r["host"]: r for r in preflight(manifest, observe(manifest, targets, preflight=True), targets)} \
        if targets else {}
    ready: list[str] = []  # enrolled, reachable, ready hosts that need the new candidate or already run it
    needs: dict[str, str] = {}
    for name in targets:
        rows[name] = new_row(manifest, name, step="preflight")
        result = results[name]
        if "reach" in result["checks"]:
            rows[name]["result"] = f"unreachable: {result['checks']['reach']['detail']}"
            continue
        generation = result["enrollment"]["generation"]
        rows[name]["generation"] = short_generation(generation) if generation else ""
        needs[name] = need = enrollment_need(result)
        # An old ~/glaeda is no blocker here: the renewal's first step moves it (renew_one's sync).
        failing = [c for c, v in result["checks"].items() if v["state"] == "fail"
                   and (v.get("action") or {}).get("kind") != "glaeda_sync"]
        failing += [c for c, v in result["checks"].items() if v["state"] == "unknown" and c in UNKNOWN_BLOCKS]
        if need == "enroll":
            rows[name]["result"] = f"not enrolled: glaeda-mini-fleet onboard {name} --yes once this pins the candidate"
        elif need == "leave":
            rows[name]["result"] = (f"{result['checks']['enroll']['detail']}: left for its operator; "
                                    "upgrade it again once it is eligible")
        elif need == "retired":
            rows[name]["result"] = "retired"
        elif failing:
            rows[name]["result"] = f"not ready: {', '.join(failing)}; glaeda-mini-fleet repair {name}"
        else:
            ready.append(name)

    # Per class: the recorded acceptance when it already covers this candidate (a resumed run), else a seed.
    classes: dict[str, list[str]] = {}
    for name in ready:
        classes.setdefault(manifest["hosts"][name]["hardware"], []).append(name)
    for klass, name in chosen.items():
        if name not in ready:
            raise Failure(f"--seed-per-class {name} is not ready to seed class {klass}: {rows[name]['result']}")
    plan: dict[str, str | None] = {}  # class: seed, or None when the class already holds a receipt for this candidate
    receipts: dict[str, tuple[str, str, bytes]] = {}
    for klass, members in classes.items():
        blocked = None if FLEET_CLASS_RE.fullmatch(klass) else \
            f"blocked: hardware key {klass!r} is not a fleet class name ([a-z][a-z0-9-]*)"
        if not blocked and not (toolchain(manifest, members[0]).get("xcode") or {}).get("build"):
            blocked = ("blocked: the manifest declares no toolchain.xcode (app, version, build); "
                       "class acceptance is recorded per Xcode build")
        if blocked:
            for name in members:
                rows[name]["result"] = blocked
            continue
        recorded, _ = class_acceptance(manifest, members[0])
        data = class_receipt_bytes(recorded, klass)[0] if recorded and "receipt" in recorded else None
        if data is not None:
            plan[klass] = None
            receipts[klass] = (klass, recorded["receipt_sha256"], data)
            continue
        # A host already on the candidate with its own acceptance only needs the export; otherwise the first
        # host that still renews. One that joined on a class receipt cannot seed (class acceptance does not chain).
        seed = chosen.get(klass) or next((h for h in members if needs[h] == "ok" and results[h]["enrollment"]["local"]),
                                         next((h for h in members if needs[h] != "ok"), None))
        if seed is None or (needs[seed] == "ok" and not results[seed]["enrollment"]["local"]):
            for name in members:
                rows[name]["result"] = (f"blocked: every {klass} host is on {source12} by class adoption and the "
                                        f"recorded receipt is gone; restore it (hardware.{klass}.acceptance.receipt)")
            continue
        plan[klass] = seed

    if not yes:
        for klass, seed in plan.items():
            for name in classes[klass]:
                if needs[name] == "ok" and name != seed:
                    rows[name]["result"] = f"ok: already on {source12}"
                    continue
                record = [f"export class {klass} receipt", f"record hardware.{klass}.acceptance"]
                if needs[name] == "ok":  # a seed from an earlier run that already runs the candidate
                    steps = record
                else:
                    steps = ["sync ~/glaeda", f"stage {source12}", "drain runner",
                             *(["renew + accept-local (a cold cmux build on the mini)", *record] if name == seed
                               else [f"renew + adopt class {klass} receipt"]), "start runner"]
                rows[name].update(step="plan", result="would: " + ", ".join(steps))
            if seed:
                entry = acceptance_entry(manifest, seed, candidate, class_receipt_path(manifest_path, klass, source12),
                                         "sha256:<from the export>")
                print(f"class {klass}: seed {seed}; the manifest would change like this:")
                print(record_class_acceptance(manifest_path, manifest, klass, entry, candidate, write=False) or "(no change)")
            else:
                print(f"class {klass}: already accepted for {source12}; hosts adopt its receipt")
        print(render_rows(rows))
        print("dry run; pass --yes to upgrade")
        return 0

    assert directory is not None
    for name in ready:
        rows[name]["log"] = os.fspath(directory / f"{name}.log")
    glaeda_ref = glaeda_target(repo)
    manifest_lock = threading.Lock()

    def seed_task(klass: str, name: str) -> Any:
        def run() -> tuple[bool, str, str]:
            log_path = directory / f"{name}.log"
            if needs[name] != "ok":
                ok, step, detail = renew_one(manifest, name, results[name], candidate, glaeda_ref, None, log_path, share_from)
                if not ok:
                    return ok, step, detail
            try:
                data = export_class_receipt(manifest, name, results[name], candidate, klass, log_path)
                receipt = class_receipt_path(manifest_path, klass, source12)
                write_private(receipt, data)
                sha = json.loads(data)["receiptSha256"]
                with manifest_lock:
                    diff = record_class_acceptance(manifest_path, manifest, klass,
                                                   acceptance_entry(manifest, name, candidate, receipt, sha), candidate)
                    say(f"class {klass}: recorded in {manifest_path}\n{diff}")
            except (Failure, OSError, ValueError) as error:
                return False, "export", f"eligible on {source12}, but the class receipt was not recorded: {error}"
            receipts[klass] = (klass, sha, data)
            return True, "record", f"eligible; class {klass} accepted here ({sha[:19]})"
        return run

    seeds_now = {seed: seed_task(klass, seed) for klass, seed in plan.items() if seed}
    if seeds_now:
        say(f"seeding {len(seeds_now)} class(es): {', '.join(seeds_now)} (accept-local is a cold cmux build on each)")
        logs = {h: directory / f"{h}.log" for h in seeds_now}
        for name, (ok, step, detail) in run_with_heartbeat(seeds_now, logs, "seed", heartbeat).items():
            rows[name].update(step=step, result=detail if ok or detail.startswith("held:") else f"failed: {detail}")
    peers = []
    for klass, members in classes.items():
        if klass not in plan:
            continue
        for name in members:
            if name == plan.get(klass):
                continue
            recorded, why = class_acceptance(manifest, name)  # per host: an override may pin another Xcode build
            if klass not in receipts:
                rows[name]["result"] = f"blocked: class {klass} has no receipt for {source12} (its seed {plan.get(klass)} failed)"
            elif needs[name] == "ok":
                rows[name]["result"] = f"ok: already on {source12}"
            elif recorded is None:
                rows[name]["result"] = f"blocked: {why}"
            else:
                peers.append(name)
    if peers:
        logs = {h: directory / f"{h}.log" for h in peers}
        tasks = {h: (lambda h=h: renew_one(manifest, h, results[h], candidate, glaeda_ref,
                                           receipts[manifest["hosts"][h]["hardware"]], logs[h], share_from))
                 for h in peers}
        for name, (ok, step, detail) in run_with_heartbeat(tasks, logs, "adopt", heartbeat).items():
            rows[name].update(step=step, result=detail if ok or detail.startswith("held:") else f"failed: {detail}")
    touched = [h for h in ready if rows[h]["step"] not in {"preflight", "-"}]
    for result in preflight(manifest, observe(manifest, touched, preflight=True), touched) if touched else []:
        new = (result.get("enrollment") or {}).get("generation")
        name = result["host"]
        if new and short_generation(new) != rows[name]["generation"]:
            rows[name]["generation"] = f"{rows[name]['generation'] or '-'}->{short_generation(new)}"
    print()
    print(render_rows(rows))
    return 0 if all(r["result"].startswith(("ok", "eligible", "skipped")) for r in rows.values()) else 1


# ---------------------------------------------------------------- cli


def read_observed(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise Failure(f"{path}: {error}") from None
    if not isinstance(data, dict) or not isinstance(data.get("hosts"), dict):
        raise Failure(f"{path}: not an observe output (no hosts object)")
    return data


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=("observe", "check", "plan", "apply", "preflight", "fix", "sudo-plan",
                                            "share", "onboard", "repair", "upgrade", "pools", "reserve", "borrow", "release"))
    parser.add_argument("names", nargs="*", metavar="HOST", help="hosts to act on (same as --host)")
    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    parser.add_argument("--host", action="append", dest="hosts")
    parser.add_argument("--observed", type=Path, help="reuse an observe output instead of probing")
    parser.add_argument("--out", type=Path, help="observe: also write the JSON here")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--output", choices=("text", "json"), default="text", help="preflight: output format")
    parser.add_argument("--yes", action="store_true",
                        help="apply, fix, share, onboard, repair, upgrade, reserve, borrow, release: make changes instead of printing them")
    parser.add_argument("--run", action="store_true", help="sudo-plan: run each host's plan over ssh -t")
    parser.add_argument("--ask-once", action="store_true",
                        help="sudo-plan --run: read the password once here, check it on every host, then run each "
                             "plan as root with it on ssh stdin (never argv or a tty)")
    parser.add_argument("--wait", action="store_true",
                        help="fix, share, sudo-plan --run, onboard, repair, upgrade: wait (up to 4 hours) for a host "
                             "held by the fleet host lock or a reservation instead of skipping it")
    parser.add_argument("--sudoers", action="store_true",
                        help="sudo-plan: also install a narrow NOPASSWD rule (printed in the plan for review)")
    parser.add_argument("--log-dir", type=Path, help="fix, sudo-plan, share, onboard: where per-host logs and plans go")
    parser.add_argument("--from", dest="seed", metavar="HOST",
                        help="share, fix, onboard, repair, upgrade: copy large things from this prepared host over the LAN")
    parser.add_argument("--jobs", type=int, default=2, help="share: peers copied at once from the source (default 2)")
    parser.add_argument("--sudo", choices=("run", "wait", "stop"),
                        help="onboard, repair: run each sudo-plan over ssh -t, wait for the operator (onboard's default), "
                             "or print it and stop there (repair's default)")
    parser.add_argument("--acceptance", choices=("class", "node"), default="class",
                        help="onboard, repair: join on the class's recorded acceptance (default) or run accept-local here")
    parser.add_argument("--candidate-run", metavar="RUN", help="upgrade: the fleet-candidate.yml run to roll out")
    parser.add_argument("--candidate-repo", default=CANDIDATE_REPO, help=f"upgrade: its repository (default {CANDIDATE_REPO})")
    parser.add_argument("--candidate-sha256", metavar="SHA256",
                        help="upgrade: the archive sha256 from the run's summary, checked against its receipt")
    parser.add_argument("--seed-per-class", dest="seeds", action="append", default=[], metavar="HOST",
                        help="upgrade: the host that runs its class's one accept-local (default: the first ready one)")
    parser.add_argument("--for", dest="purpose", metavar="TEXT", help="reserve, borrow: what the hosts are reserved for")
    parser.add_argument("--hours", type=float, help=f"reserve, borrow: how long, at most {RESERVATION_MAX_HOURS}")
    parser.add_argument("--until", type=int, metavar="EPOCH", help="reserve, borrow: end time in Unix seconds")
    parser.add_argument("--owner", help="reserve, borrow, release: who holds it (default $USER@$(hostname -s))")
    parser.add_argument("--class", dest="borrow_class", choices=RUNNER_CLASSES, default="std",
                        help="borrow: scheduling class to acquire (default std)")
    parser.add_argument("--force", action="store_true",
                        help="reserve, release: override another owner's active reservation or an invalid marker")
    parser.add_argument("--glaeda-ref", metavar="COMMIT",
                        help="preflight, fix, onboard, repair, upgrade: the Glaeda commit (40 hex) every host's ~/glaeda "
                             "must be at (default: ~/glaeda only needs the enroll options; fix and renewals move it "
                             "to the tip of main)")
    # Intermixed, so hosts may follow options: share xcode --from cmux15 cmux7s cmux8s
    args = parser.parse_intermixed_args(argv)
    thing = None
    if args.command == "share":
        if not args.names:
            parser.error(f"share needs what to share: {', '.join(SHARE_THINGS)}")
        thing, args.names = args.names[0], args.names[1:]
    if args.names:
        args.hosts = [*(args.hosts or []), *args.names]
    global PINNED_CANDIDATE, GLAEDA_REF
    try:
        if args.glaeda_ref is not None and not re.fullmatch(r"[0-9a-f]{40}", args.glaeda_ref):
            raise Failure("--glaeda-ref is a full commit id (40 lowercase hex)")
        GLAEDA_REF = args.glaeda_ref
        GLAEDA_MAIN.clear()
        manifest = load_manifest(args.manifest)
        PINNED_CANDIDATE = manifest.get("candidate")
        hosts = select_hosts(manifest, args.hosts)
        if args.command == "apply":
            if not args.hosts:
                raise Failure("apply needs explicit --host arguments")
            return apply(manifest, hosts, args.yes)
        if args.command == "borrow":
            if args.force:
                raise Failure("borrow does not take --force; another owner's hold is never a placement candidate")
            observed = read_observed(args.observed) if args.observed else observe(manifest, hosts)
            return cmd_borrow(manifest, hosts, observed, args.borrow_class, args.purpose, args.hours,
                              args.until, args.owner, args.yes, args.json)
        if args.command in ("reserve", "release"):
            if not args.hosts:
                raise Failure(f"{args.command} needs explicit hosts")
            if args.command == "reserve":
                return cmd_reserve(manifest, hosts, args.purpose, args.hours, args.until, args.owner, args.force, args.yes)
            return cmd_release(manifest, hosts, args.owner, args.force, args.yes)
        if args.command in {"onboard", "repair"}:
            sudo = args.sudo or ("wait" if args.command == "onboard" else "stop")
            return cmd_onboard(manifest, args.hosts, args.yes, sudo, args.acceptance, args.seed, args.log_dir,
                               mode=args.command, wait=args.wait)
        if args.command == "upgrade":
            if not args.candidate_run:
                raise Failure("upgrade needs --candidate-run RUN (a fleet-candidate.yml run)")
            return cmd_upgrade(manifest, args.manifest, args.hosts, args.candidate_run, args.candidate_repo,
                               args.candidate_sha256, args.seeds, args.yes, args.seed, args.log_dir, wait=args.wait)
        if args.command == "share":
            if not args.hosts:
                raise Failure("share needs explicit destination hosts")
            return cmd_share(manifest, thing, args.seed, hosts, args.yes, args.jobs, args.log_dir, args.wait)
        if args.command == "fix":
            return cmd_fix(manifest, hosts, args.yes, args.log_dir, args.seed, args.wait)
        if args.command == "sudo-plan":
            return cmd_sudo_plan(manifest, hosts, args.run, args.sudoers, args.log_dir, args.wait, args.ask_once)
        if args.command == "preflight":
            observed = read_observed(args.observed) if args.observed else observe(manifest, hosts, preflight=True)
            try:
                results = preflight(manifest, observed, hosts)
            except (KeyError, TypeError, ValueError, AttributeError) as error:
                raise Failure(f"observation does not match this tool's format ({type(error).__name__}: {error})") from None
            if args.output == "json" or args.json:
                print(json.dumps({"schema": SCHEMA + "/preflight",
                                  "hosts": {r["host"]: {**r, "fixes": grouped_fixes(r)} for r in results}}, indent=2))
            else:
                print(render_preflight(results))
            return 0 if all(r["ready"] for r in results) else 1
        declared = any(toolchain(manifest, h) for h in hosts) and args.command in {"check", "plan"}
        observed = read_observed(args.observed) if args.observed else observe(manifest, hosts, preflight=declared)
        if args.command == "pools":
            stamps = [h.get("observed_at") for h in observed["hosts"].values() if h.get("observed_at")]
            print(json.dumps({"schema": SCHEMA + "/pools", "observed_at": min(stamps) if stamps else None,
                              "pools": pools(manifest, observed, hosts)}, indent=2, sort_keys=True))
            return 0
        if args.command == "observe":
            text = json.dumps(observed, indent=2, sort_keys=True)
            if args.out:
                args.out.write_text(text + "\n")
            print(text)
            return 0
        try:
            issues = check(manifest, observed, hosts)
        except (KeyError, TypeError, ValueError, AttributeError) as error:
            raise Failure(f"observation does not match this tool's format ({type(error).__name__}: {error})") from None
    except Failure as error:
        print(f"glaeda-mini-fleet: {error}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps({"schema": SCHEMA + "/check", "hosts": hosts, "issues": issues}, indent=2))
    elif args.command == "plan":
        for name in hosts:
            fixes = [i["fix"] for i in issues if i["host"] == name and i["fix"]]
            if fixes:
                print(f"{name}:")
                for fix in dict.fromkeys(fixes):
                    print(f"  {fix}")
    else:
        width = max((len(h) for h in hosts), default=0)
        drifting = [i for i in issues if i["area"] not in INFO_AREAS]
        for name in hosts:
            mine = [i for i in issues if i["host"] == name]
            count = sum(i["area"] not in INFO_AREAS for i in mine)
            info = ", ".join(f"{n} {area}" for area in INFO_AREAS if (n := sum(i["area"] == area for i in mine)))
            status = f"{count} drift" if count else "ok"
            print(f"{name:<{width}}  {status}{f' ({info})' if info else ''}")
            for i in mine:
                print(f"{'':<{width}}    {i['area']}: {i['detail']}")
        print(f"{len(hosts)} hosts, {len({i['host'] for i in drifting})} drifting, {len(drifting)} findings")
    return 1 if any(i["area"] not in INFO_AREAS for i in issues) else 0


if __name__ == "__main__":
    sys.exit(main())
