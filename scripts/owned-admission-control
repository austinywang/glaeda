#!/usr/bin/env python3
"""Change one already-installed local admission gate; never install or launch work."""
import argparse
import sys

from owned_linux_admission import set_control
from owned_linux_task import Refusal

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--root", required=True)
parser.add_argument("state", choices=("held", "draining", "available"))
arguments = parser.parse_args()
try:
    set_control(arguments.root, arguments.state)
except (Refusal, OSError, ValueError):
    print("local admission control refused", file=sys.stderr)
    raise SystemExit(2)
print("local admission control updated")
