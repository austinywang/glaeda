#!/usr/bin/env python3
"""Check only worktree-changed Rust files for the non-authoritative fast loop."""

from __future__ import annotations

import os
import shutil
import stat
import subprocess
import sys
from pathlib import Path


MAX_FILES = 1_024
MAX_TOTAL_BYTES = 64 * 1024 * 1024
MAX_BATCH_ARG_BYTES = 128 * 1024
GIT_ENV = {
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_OPTIONAL_LOCKS": "0",
    "LC_ALL": "C",
}


def capability(name: str) -> Path:
    found = shutil.which(name)
    if found is None:
        raise RuntimeError(f"required capability {name} is unavailable")
    path = Path(os.path.abspath(found))
    if not path.is_file() or not os.access(path, os.X_OK):
        raise RuntimeError(f"required capability {name} is unavailable")
    return path


def git_output(root: Path, git: Path, arguments: tuple[str, ...]) -> bytes:
    result = subprocess.run(
        [os.fspath(git), *arguments],
        cwd=root,
        env=GIT_ENV,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("Git could not identify changed Rust files")
    return result.stdout


def canonical_repository_root(script: Path, git: Path) -> Path:
    root = script.resolve().parent.parent
    observed = git_output(root, git, ("rev-parse", "--show-toplevel"))
    try:
        observed_root = Path(os.fsdecode(observed.rstrip(b"\n"))).resolve(strict=True)
    except (OSError, ValueError) as error:
        raise RuntimeError("Git could not identify the canonical worktree") from error
    if observed_root != root:
        raise RuntimeError("changed-rustfmt must run from its canonical Glaeda worktree")
    return root


def changed_rust_files(root: Path, git: Path) -> tuple[Path, ...]:
    unsafe = git_output(
        root,
        git,
        ("diff", "--name-only", "-z", "--diff-filter=TUXB", "HEAD", "--", "*.rs"),
    )
    if unsafe:
        raise RuntimeError("changed Rust set contains an unmerged or unsafe type change")
    tracked = git_output(
        root,
        git,
        ("diff", "--name-only", "-z", "--diff-filter=ACMR", "HEAD", "--", "*.rs"),
    )
    untracked = git_output(
        root,
        git,
        ("ls-files", "--others", "--exclude-standard", "-z", "--", "*.rs"),
    )
    encoded_paths = sorted(set(filter(None, (tracked + untracked).split(b"\0"))))
    if len(encoded_paths) > MAX_FILES:
        raise RuntimeError("changed Rust file count exceeds the bounded fast-loop policy")

    files: list[Path] = []
    total_bytes = 0
    for encoded in encoded_paths:
        relative = Path(os.fsdecode(encoded))
        if relative.is_absolute() or ".." in relative.parts:
            raise RuntimeError("changed Rust path is not worktree-relative")
        candidate = root / relative
        try:
            metadata = candidate.lstat()
        except OSError as error:
            raise RuntimeError("changed Rust path is not a canonical worktree file") from error
        if not stat.S_ISREG(metadata.st_mode) or candidate.is_symlink():
            raise RuntimeError("changed Rust path is not a regular non-symlink file")
        try:
            resolved = candidate.resolve(strict=True)
            resolved.relative_to(root)
        except (OSError, ValueError) as error:
            raise RuntimeError("changed Rust path is not a canonical worktree file") from error
        if candidate.suffix != ".rs":
            raise RuntimeError("Git returned a non-Rust changed path")
        total_bytes += metadata.st_size
        if total_bytes > MAX_TOTAL_BYTES:
            raise RuntimeError("changed Rust bytes exceed the bounded fast-loop policy")
        files.append(relative)
    return tuple(files)


def rustfmt_batches(files: tuple[Path, ...]) -> tuple[tuple[Path, ...], ...]:
    batches: list[tuple[Path, ...]] = []
    current: list[Path] = []
    current_bytes = 0
    for path in files:
        path_bytes = len(os.fsencode(os.fspath(path))) + 1
        if path_bytes > MAX_BATCH_ARG_BYTES:
            raise RuntimeError("changed Rust path exceeds the rustfmt argument policy")
        if current and current_bytes + path_bytes > MAX_BATCH_ARG_BYTES:
            batches.append(tuple(current))
            current = []
            current_bytes = 0
        current.append(path)
        current_bytes += path_bytes
    if current:
        batches.append(tuple(current))
    return tuple(batches)


def run_rustfmt(root: Path, rustfmt: Path, files: tuple[Path, ...]) -> int:
    for batch in rustfmt_batches(files):
        result = subprocess.run(
            [
                os.fspath(rustfmt),
                "--edition",
                "2024",
                "--check",
                "--",
                *(os.fspath(path) for path in batch),
            ],
            cwd=root,
            env={},
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode != 0:
            return result.returncode or 1
    return 0


def run_full_cargo_fmt(root: Path, cargo: Path) -> int:
    result = subprocess.run(
        [os.fspath(cargo), "fmt", "--all", "--", "--check"],
        cwd=root,
        env={},
        stdin=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode or 0


def main() -> int:
    try:
        git = capability("git")
        rustfmt = capability("rustfmt")
        cargo = capability("cargo")
        root = canonical_repository_root(Path(__file__), git)
        files = changed_rust_files(root, git)
        print(f"changed Rust files checked: {len(files)}", file=sys.stderr)
        direct_result = run_rustfmt(root, rustfmt, files)
        if direct_result == 0:
            return 0
        print("direct rustfmt was inconclusive; checking the full Cargo format contract", file=sys.stderr)
        return run_full_cargo_fmt(root, cargo)
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"changed-rustfmt error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
