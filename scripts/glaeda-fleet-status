def render_html(doc: dict[str, Any]) -> str:
    at = doc["generated_at"]
    e = html.escape
    fleet = doc["fleet"]
    out = ["<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">",
           "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">",
           "<title>Fleet status</title><style>", PAGE_STYLE, "</style></head><body><main>",
           "<h1>Fleet status</h1>",
           f"<p class=\"sub\">Generated {e(time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime(at)))} from "
           f"<code>{e(doc['schema'])}</code>. Sources older than {doc['max_age_seconds']} s show as stale.</p>",
           "<div class=\"tiles\">"]
    for label, value in (("members", fleet["members"]), ("broken", fleet["by_status"]["broken"]),
                         ("attention", fleet["by_status"]["attention"]), ("errors", fleet["findings"]["error"]),
                         ("warnings", fleet["findings"]["warn"]), ("safe to apply", fleet["safe_to_apply"])):
        out.append(f"<div class=\"tile\"><b>{value}</b><span>{e(label)}</span></div>")
    out.append("</div><h2>Sources</h2><div class=\"scroll\"><table><tr><th>source</th><th>state</th>"
               "<th>observed</th><th>error</th></tr>")
    for name, s in doc["sources"].items():
        out.append(f"<tr><td>{e(name)}</td><td class=\"s-{e(s['state'])}\">{e(s['state'])}</td>"
                   f"<td>{e(when(s['observed_at'], at))}</td><td>{e(s['error'] or '')}</td></tr>")
    out.append("</table></div><h2>Members</h2><div class=\"scroll\"><table><tr><th>member</th><th>class</th>"
               "<th>status</th><th>controller</th><th>runners</th><th>lima</th><th>disk</th><th>jobs (24 h)</th><th>errors</th>"
               "<th>warnings</th>"
               "<th>observed</th></tr>")
    for m in doc["members"]:
        ctl = m.get("controller") or {}
        runners = ", ".join(f"{r['name']} {r['status']}{' busy' if r['busy'] else ''}" for r in m.get("runners") or [])
        lima = m.get("lima") or {}
        lima_text = ("" if not lima else "unreachable" if not lima.get("reachable") else
                     "not installed" if not lima.get("installed") else
                     f"{lima['running']}/{lima['total']} running, {len(lima['orphans'])} orphan")
        tag = " <span class=\"pill\">never_touch</span>" if m["never_touch"] else ""
        out.append(f"<tr><td>{e(m['name'])}{tag}</td><td>{e(str(m['class'] or ''))}</td>"
                   f"<td class=\"s-{e(m['status'])}\">{e(m['status'])}</td><td>{e(str(ctl.get('state', '')))}</td>"
                   f"<td>{e(runners)}</td><td>{e(lima_text)}</td><td>{e(disk_line(m.get('disk'), at))}</td>"
                   f"<td>{e(jobs_line(m.get('jobs')))}</td>"
                   f"<td>{m['counts']['error']}</td>"
                   f"<td>{m['counts']['warn']}</td><td>{e(when(m['observed_at'], at))}</td></tr>")
    out.append("</table></div>")
    titles = {"agent": "An agent can run", "password": "Needs a password", "person": "Needs a person"}
    for who in WHO:
        mine = [f for f in doc["findings"] if f["action"]["who"] == who]
        if not mine:
            continue
        out.append(f"<h2>{titles[who]} ({len(mine)})</h2><div class=\"scroll\"><table><tr><th>severity</th>"
                   "<th>member</th><th>finding</th><th>action</th><th>observed</th></tr>")
        for f in mine:
            a = f["action"]
            safe = " <span class=\"pill\">safe to apply</span>" if a["safe_to_apply"] else ""
            body = f"<code>{e(a['command'])}</code>{safe}" if a["command"] else ""
            if a["note"]:
                body += f"<div class=\"sub\">{e(a['note'])}</div>"
            out.append(f"<tr><td class=\"s-{e(f['severity'])}\">{e(f['severity'])}</td>"
                       f"<td>{e(f['member'] or 'fleet')}</td><td>{e(f['summary'])}<div class=\"sub\">"
                       f"{e(f['id'])}</div></td><td>{body}</td><td>{e(when(f['observed_at'], at))}</td></tr>")
        out.append("</table></div>")
    if fleet["truncated_findings"]:
        out.append(f"<p class=\"sub\">{fleet['truncated_findings']} findings dropped to stay within bounds.</p>")
    out.append("</main></body></html>\n")
    return "".join(out)


# ---------------------------------------------------------------- cli


def write(path: Path, text: str) -> None:
    tmp = path.with_name(f".{path.name}.tmp{os.getpid()}")
    tmp.write_text(text)
    os.replace(tmp, path)


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise Failure(f"{path}: {error}") from None


def emit(doc: dict[str, Any], args: argparse.Namespace) -> int:
    text = json.dumps(doc, indent=2, sort_keys=True) + "\n"
    if args.out:
        write(args.out, text)
    if args.html:
        write(args.html, render_html(doc))
    if args.output == "json":
        print(text, end="")
    else:
        print(render_text(doc))
    return 1 if doc["fleet"]["findings"]["error"] else 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog=__doc__.split("\n\n", 1)[1])
    p.add_argument("command", nargs="?", default="status", choices=("status", "collect", "build", "render"))
    p.add_argument("input", nargs="?", type=Path, help="build: a sources bundle; render: a status document")
    p.add_argument("--manifest", type=Path)
    p.add_argument("--host", action="append", dest="hosts", help="limit to these members (repeatable)")
    p.add_argument("--no-fleet-probe", action="store_true", help="skip glaeda-mini-fleet check and preflight")
    p.add_argument("--no-lima", action="store_true", help="skip the Lima instance listing")
    p.add_argument("--no-disk", action="store_true", help="skip the per-member disk and cache probe")
    p.add_argument("--no-jobs", action="store_true", help="skip the per-member runner job records")
    p.add_argument("--controller-status", type=Path, help="path to cmuxterm-hq build-fleet/status.py")
    p.add_argument("--controller-json", type=Path, help="a saved status.py --json output instead")
    p.add_argument("--github-runners", metavar="SCOPE", help="orgs/OWNER or repos/OWNER/REPO")
    p.add_argument("--queue-repo", action="append", metavar="OWNER/REPO")
    p.add_argument("--cache", action="append", metavar="NAME=URL")
    p.add_argument("--gh", help="gh binary (default: PATH)")
    p.add_argument("--max-age", type=int, default=DEFAULT_MAX_AGE, help="seconds before a source counts as stale")
    p.add_argument("--sources-out", type=Path, help="also write the collected sources bundle here")
    p.add_argument("--out", type=Path, help="write the status document here (atomically)")
    p.add_argument("--html", type=Path, help="write the human page here (atomically)")
    p.add_argument("--output", choices=("text", "json"), default="text")
    return p


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.github_runners and not re.fullmatch(r"(orgs/[\w.-]+|repos/[\w.-]+/[\w.-]+)", args.github_runners):
            raise Failure("--github-runners wants orgs/OWNER or repos/OWNER/REPO")
        for repo in args.queue_repo or []:
            if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo):
                raise Failure(f"--queue-repo wants OWNER/REPO, got {repo!r}")
        if args.command in ("build", "render") and not args.input:
            raise Failure(f"{args.command} needs an input file")
        if args.command == "render":
            doc = read_json(args.input)
            if not isinstance(doc, dict) or doc.get("schema") != SCHEMA:
                raise Failure(f"{args.input}: not a {SCHEMA} document")
            return emit(doc, argparse.Namespace(**{**vars(args), "out": None}))
        if args.command == "build":
            return emit(build(read_json(args.input), max_age=args.max_age), args)
        if args.manifest is None:
            args.manifest = Path(os.environ.get("GLAEDA_MINI_FLEET_MANIFEST",
                                                "~/.config/glaeda/mini-fleet.json")).expanduser()
        bundle = collect(args)
        if args.sources_out:
            write(args.sources_out, json.dumps(bundle, indent=2, sort_keys=True) + "\n")
        if args.command == "collect":
            if not args.sources_out:
                print(json.dumps(bundle, indent=2, sort_keys=True))
            return 0
        return emit(build(bundle, max_age=args.max_age), args)
    except Failure as error:
        print(f"glaeda-fleet-status: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
