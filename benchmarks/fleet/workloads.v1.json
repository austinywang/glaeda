      "exact_reusable_product_present": false
    },
    "dependency_warm": {
      "dependency_cache_present": true,
      "compiler_state_present": false,
      "project_resident": false,
      "exact_reusable_product_present": false
    },
    "compiler_warm": {
      "dependency_cache_present": true,
      "compiler_state_present": true,
      "project_resident": false,
      "exact_reusable_product_present": false
    },
    "project_resident": {
      "dependency_cache_present": true,
      "compiler_state_present": true,
      "project_resident": true,
      "exact_reusable_product_present": false
    },
    "exact_reusable_compiled_product_present": {
      "dependency_cache_present": true,
      "compiler_state_present": true,
      "project_resident": true,
      "exact_reusable_product_present": true
    }
  },
  "contention_profiles": {
    "large": {
      "jobs": 1
    },
    "medium": {
      "jobs": 2
    },
    "small": {
      "jobs": 4
    }
  },
  "storage_comparison": {
    "rule": "change only declared source/state storage placement; retain machine comparison identity, backend, source revision, toolchain, workload, state class, resource policy, and validator",
    "operations": [
      "source traversal with the exact checkout located on the declared source storage tier",
      "Git worktree/materialization with task temporaries located on the declared state storage tier",
      "Xcode/Swift or Cargo compiler state rooted in state_dir",
      "large immutable artifacts already consumed or produced by the reviewed workload",
      "concurrent I/O through fixed-offer contention windows",
      "sustained thermal behavior through repeated broader validated workloads"
    ],
    "synthetic_microbenchmark_authority": false
  },
  "workloads": [
    {
      "id": "cmux-native-apple-incremental-v1",
      "label": "cmux native Apple incremental compile/check",
      "repository": "teamleaderleo/cmux",
      "commit": "2319ef27a05e8fdc0a3c231e6ccc33b016c83cc4",
      "tree": "08bcff464995140302ecc186e61a3a0b4b810aa5",
      "platform": "macos",
      "toolchain": {
        "policy": "repository-selected stable Xcode with macOS SDK major 26; exact xcodebuild, SDK, and swiftc outputs become part of every receipt and comparisons require identical toolchain_digest",
        "preflight": [
          "CMUX_CI_REQUIRED_MACOS_SDK_MAJOR=26 ./scripts/select-ci-xcode.sh",
          "test -d GhosttyKit.xcframework"
        ],
        "probes": [
          "xcodebuild -version",
          "xcrun --sdk macosx --show-sdk-version",
          "xcrun swiftc --version",
          "git -C ghostty rev-parse HEAD",
          "awk -v sha=\"$(git -C ghostty rev-parse HEAD)\" '$1 == sha { print $1 \" \" $2; found=1; exit } END { if (!found) exit 1 }' scripts/ghosttykit-checksums.txt",
          "test -d GhosttyKit.xcframework && find GhosttyKit.xcframework -type f -exec shasum -a 256 {} + | LC_ALL=C sort | shasum -a 256"
        ],
        "required_output_regex": "(?m)^26(?:\\.[0-9]+)*$"
      },
      "operation": {
        "semantic_profile": "cmux-unit focused native macOS incremental compile/test after one mtime-only Swift source touch",
        "command": "touch Sources/RestorableAgentSession.swift && ./scripts/test-unit.sh test -derivedDataPath {state_dir}/DerivedData -clonedSourcePackagesDirPath {state_dir}/SourcePackages -only-testing:cmuxTests/TerminalStartupWorkingDirectoryPrefixRefreshTests",
        "first_useful_regex": "(Test Suite .* passed|\\*\\* TEST SUCCEEDED \\*\\*)",
        "validation": {
          "kind": "output_and_exit",
          "success_regex": "\\*\\* TEST SUCCEEDED \\*\\*"
        }
      },
      "resource_envelope": {
        "cpu": "natural host allocation; record logical CPU count",
        "memory": "natural host allocation; record peak aggregate RSS",
        "disk": "state_dir owns DerivedData and SourcePackages"
      },
      "candidate_roles": [
        "latency-sensitive Apple build node"
      ]
    },
